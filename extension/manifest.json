{
  "manifest_version": 3,
  "name": "Overleaf Live (TeXpresso)",
  "version": "0.3.0",
  "description": "Live preview for Overleaf, typeset on your own PC by TeXpresso.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.overleaf.com/project/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.overleaf.com/project/*"],
      "js": ["content.js"],
      "css": ["viewer.css"],
      "run_at": "document_idle"
    }
  ]
}
