{
  "manifest_version": 3,
  "name": "Overleaf Live (TeXpresso)",
  "version": "0.16.0",
  "description": "Live preview for Overleaf, typeset by TeXpresso in your browser (WebAssembly) or on your PC (WSL helper).",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage",
    "offscreen",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.overleaf.com/project/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "viewer.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "host_permissions": [
    "https://ftp.math.utah.edu/*",
    "https://ftp.tu-chemnitz.de/*",
    "https://mirrors.tuna.tsinghua.edu.cn/*"
  ]
}
