\begingroup
  \catcode`\{=1 %
  \catcode`\}=2 %
  \catcode`\#=6 %
  \csname protected\endcsname\gdef\pdfmapfile#1{\special{pdf:mapfile #1}}%
  \csname protected\endcsname\gdef\pdfmapline#1{\special{pdf:mapline #1}}%
