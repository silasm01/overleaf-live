\bbl@hook@loadkernel{switch.def}
\openin1 = language.dat
\def\languagename{english}%
\ifeof1
  \message{I couldn't find the file language.dat,\space
           I will try the file hyphen.tex}
  \input hyphen.tex\relax
  \chardef\l@english\z@
\else
  \last@language\m@ne
  \loop
    \endlinechar\m@ne
