			}%
	}%
	\xs_read_reserved_D
	\xs_ifnum{\xs_countb=\numexpr(#3)\relax}% occurrence trouv√©e ?
		{\let\xs_reserved_E\xs_reserved_D
		\xs_exparg{\def\xs_reserved_D}{\xs_reserved_C#2}%
		}
		{\let\xs_reserved_C\empty
		\let\xs_reserved_E\empty
		\gdef\groupID{}%
		}%
}

