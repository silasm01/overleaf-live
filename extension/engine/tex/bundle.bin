      \def\@tempa##1##2\@nil{%
        \if##1c%
          \cref@writescript{}{%
            \string\cpagerefrange*\string{#2\string}\string{#3\string}}%
        \else%
          \cref@writescript{}{%
            \string\Cpagerefrange*\string{#2\string}\string{#3\string}}%
        \fi}%
      \@tempa#1\@nil}%
    \def\@labelcrefnostar#1{%
      \gdef\cref@poorman@text{}%
      \@cref{labelcref}{#1}%
      \cref@writescript{}{\string\labelcref\string{#1\string}}}%
    \def\@labelcrefstar#1{%
      \gdef\cref@poorman@text{}%
