\newcommand*\subcaption@Info{%
  \PackageInfo{subcaption}}
\newcommand*\subcaption@Warning{%
  \PackageWarning{subcaption}}
\newcommand*\subcaption@Error[1]{%
  \PackageError{subcaption}{#1}{\caption@@eh{subcaption}}}
