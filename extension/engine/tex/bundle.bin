\tikzset{dotted/.style=                  {dash pattern=on \pgflinewidth off 2pt}}%
\tikzset{densely dotted/.style=          {dash pattern=on \pgflinewidth off 1pt}}%
\tikzset{loosely dotted/.style=          {dash pattern=on \pgflinewidth off 4pt}}%
