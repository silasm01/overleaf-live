\def\place@tag{%
  \iftagsleft@
    \kern-\tagshift@
    \if@fleqn
      \MH_if_num:w \xatlevel@=\tw@
        \kern-\@mathmargin
      \MH_fi:
    \MH_fi:
    \MH_if:w 1\shift@tag\row@\relax
      \rlap{\vbox{%
        \normalbaselines
        \boxz@
        \vbox to\lineht@{}%
        \raise@tag
      }}%
    \MH_else:
      \rlap{\boxz@}%
    \MH_fi:
    \kern\displaywidth@
  \MH_else:
    \kern-\tagshift@
    \MH_if:w 1\shift@tag\row@\relax
      \llap{\vtop{%
        \raise@tag
        \normalbaselines
        \setbox\@ne\null
        \dp\@ne\lineht@
        \box\@ne
        \boxz@
      }}%
    \MH_else:
      \llap{\boxz@}%
    \MH_fi:
  \MH_fi:
}
\def\x@calc@shift@lf{%
  \MH_if_dim:w \eqnshift@=\z@
    \global\eqnshift@\@mathmargin\relax
      \alignsep@\displaywidth
      \advance\alignsep@-\totwidth@
      \MH_if_num:w \@tempcntb=0
      \MH_else:
        \global\divide\alignsep@\@tempcntb % original line
      \MH_fi:
      \MH_if_dim:w \alignsep@<\minalignsep\relax
        \global\alignsep@\minalignsep\relax
      \MH_fi:
  \MH_fi:
  \MH_if_dim:w \tag@width\row@>\@tempdima
    \saveshift@1%
  \MH_else:
    \saveshift@0%
  \MH_fi:}%
}
\MaybeMHPrecedingSpacesOff
