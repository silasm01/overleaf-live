        \cref@writescript{}{\string\vpageref\string{#3\string}}}%
      \let\old@cref@vref\cref@vref%
      \def\cref@vref#1#2{%
        \gdef\cref@poorman@text{}%
        \old@cref@vref{#1}{#2}%
        \def\@tempa##1##2\@nil{%
          \if##1c%
            \if@crefstarred%
              \cref@writescript{}{\string\vref*\string{#2\string}}%
            \else%
              \cref@writescript{}{\string\vref\string{#2\string}}%
            \fi%
          \else%
            \if@crefstarred%
              \cref@writescript{}{\string\Vref*\string{#2\string}}%
            \else%
              \cref@writescript{}{\string\Vref\string{#2\string}}%
            \fi%
          \fi}%
        \@tempa#1\@nil}%
      \let\old@cref@fullref\cref@fullref%
