    \@ifstar{\ttl@spacing@i{\z@}}{\ttl@spacing@i{\z@}}}}

% newlinetospace
\let\ttl@blinemarks\relax
\let\ttl@elinemarks\relax

\DeclareRobustCommand\ttl@linetosp{%
  \@ifstar{\ttl@linetosp@i}{\ttl@linetosp@i}}%

\def\ttl@linetosp@i{%
  \ifdim\lastskip>\z@\else\space\fi
