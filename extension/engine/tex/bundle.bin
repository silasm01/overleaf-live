    \def\@@@setcrefrange#1#2#3{%
      \old@@@setcrefrange{#1}{#2}{#3}%
      \expandafter\g@addto@macro%
        \expandafter{\expandafter\cref@poorman@text\expandafter}%
        \expandafter{#1{\ref{#2}}{\ref{#3}}{}{}{}{}}}%
    \def\@@@setcpageref#1#2{%
