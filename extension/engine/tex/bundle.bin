\def\Hy@VersionCheck#1{%
  \begingroup
    \@ifundefined{ver@hyperref.sty}{%
      \Hy@Error{%
        This should not happen!\MessageBreak
        Missing hyperref version%
      }\@ehd
    }{%
      \@ifundefined{ver@#1}{%
