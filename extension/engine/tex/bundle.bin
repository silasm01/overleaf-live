            \if@crefstarred%
              \cref@writescript{}{\string\Fullref*\string{#2\string}}%
            \else%
              \cref@writescript{}{\string\Fullref\string{#2\string}}%
            \fi%
          \fi}%
        \@tempa#1\@nil}%
