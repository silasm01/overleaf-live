    \expandafter\@onelevel@sanitize\csname Hy@#1\endcsname
  }%
  \Hy@temp{NextPage}%
  \Hy@temp{PrevPage}%
  \Hy@temp{FirstPage}%
  \Hy@temp{LastPage}%
