  \def\@ynthm#1[#2]#3{%
    \edef\@tempa{\expandafter\noexpand%
      \csname cref@#1@name@preamble\endcsname}%
    \edef\@tempb{\expandafter\noexpand%
      \csname Cref@#1@name@preamble\endcsname}%
    \def\@tempc{#3}%
    \ifx\@tempc\@empty\relax%
