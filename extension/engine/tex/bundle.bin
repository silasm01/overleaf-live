\def\SE@Nibble@NumToHex#1{%
$ \ifcase\numexpr#1\relax
& \ifcase\expandafter\ltx@firstofone\expandafter{\number#1} %
    0\or 1\or 2\or 3\or 4\or 5\or 6\or 7\or
    8\or 9\or A\or B\or C\or D\or E\or F%
  \fi
}
\def\SE@Nibble@NumToBin#1{%
$ \ifcase\numexpr#1\relax
& \ifcase\expandafter\ltx@firstofone\expandafter{\number#1} %
    0000\or
    0001\or
    0010\or
    0011\or
    0100\or
    0101\or
    0110\or
    0111\or
    1000\or
    1001\or
    1010\or
    1011\or
    1100\or
    1101\or
    1110\or
    1111%
  \fi
}
