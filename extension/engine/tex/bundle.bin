        \expandafter{\expandafter\cref@poorman@text\expandafter}%
        \expandafter{#1{\pageref{#2}}{\pageref{#3}}{}{}{}{}}}%
  \fi%  end of hyperref test
  \let\old@@@setnamecref\@@@setnamecref%
  \def\@@@setnamecref#1#2{%
    \old@@@setnamecref{#1}{#2}%
