            \else%
              \cref@writescript{}{%
                \string\vrefrange\string{#2\string}\string{#3\string}}%
            \fi%
          \else%
            \if@crefstarred%
              \cref@writescript{}{%
                \string\Vrefrange*\string{#2\string}\string{#3\string}}%
            \else%
              \cref@writescript{}{%
                \string\Vrefrange\string{#2\string}\string{#3\string}}%
            \fi%
          \fi}%
        \@tempa#1\@nil}%
      \def\@@@setvpageref#1[#2]#3{%
        \cref@old@@vpageref{#1}[#2]{#3}%
        \g@addto@macro\cref@poorman@text{\vpageref{#3}}}%
      \def\@@@setvpagerefrange[#1]#2#3{%
