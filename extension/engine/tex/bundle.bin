    {\MT_prescript_inner:{#1}{#2}{#3}{\scriptstyle}}
    {\MT_prescript_inner:{#1}{#2}{#3}{\scriptstyle}}
    {\MT_prescript_inner:{#1}{#2}{#3}{\scriptscriptstyle}}
    {\MT_prescript_inner:{#1}{#2}{#3}{\scriptscriptstyle}}
}
