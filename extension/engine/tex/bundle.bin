\def\PE@OctIII#1#2#3{%
  \ifnum#1<4 %
    \def\PE@next{\PE@OctAll{#1#2#3}}%
  \else
$   \count\ltx@cclv#1 %
$   \advance\count\ltx@cclv -4 %
    \edef\PE@next{%
      \noexpand\PE@OctAll{%
$       \the\count\ltx@cclv
&       \the\numexpr#1-4\relax
        #2#3%
      }%
    }%
  \fi
  \PE@next
}
\def\PE@OctAll#1{%
  \uccode\ltx@zero='#1\relax
  \uppercase{%
    \edef\PE@result{\PE@result^^@}%
  }%
  \PE@DeString
}
