      \def\cref@vrefrange#1#2#3{%
        \gdef\cref@poorman@text{}%
        \old@cref@vrefrange{#1}{#2}{#3}%
        \def\@tempa##1##2\@nil{%
          \if##1c%
            \if@crefstarred%
              \cref@writescript{}{%
