 bool dvi_exec_special(fz_context *ctx, dvi_context *dc, dvi_state *st, cursor_t cur, cursor_t lim)
 {
+  /* Overleaf Live: element markers that TikZ writes in the live preview
+     (see olive_hooks in frontend/main.c): "olive:b ..." starts an element
+     (a path, a node, a to[...]), "olive:e ..." ends it. They become layers,
+     which do not change the rendering; the caret device reads them. */
+  if (lim - cur > 7 && memcmp(cur, "olive:", 6) == 0)
+  {
+    if (dc->dev)
+    {
+      char name[1024];
+      int n = (int)(lim - cur) < 1023 ? (int)(lim - cur) : 1023;
+      memcpy(name, cur, n);
+      name[n] = 0;
+      /* the text before the marker is not part of the element */
+      dvi_context_flush_text(ctx, dc, st);
+      fz_begin_layer(ctx, dc->dev, name);
+      if (cur[6] == 'e')
+      {
+        fz_end_layer(ctx, dc->dev);
+        fz_end_layer(ctx, dc->dev);
+      }
+    }
+    return 1;
+  }
+
   cursor_t mar, i, j;
 
   // fprintf(stderr, "special: %.*s\n", (int)(lim - cur), cur);
