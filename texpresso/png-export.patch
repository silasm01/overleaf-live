+int32_t synctex_pack_line(int32_t l)
+{
+    if (l <= 0 || l > SYNCTEX_LINE_MASK)
+        return l;
+    /* Find the innermost level that reads a file line. */
+    const input_state_t *in = &cur_input;
+    int32_t k = input_ptr;
+    while (in->state == TOKEN_LIST) {
+        if (k <= 0)
+            return l;
+        k--;
+        in = &input_stack[k];
+    }
+    if (in->name < 18)  /* terminal or \read: no column */
+        return l;
+    int32_t col = in->loc - in->start;
+    if (col < 0)
+        return l;
+    if (col > SYNCTEX_COL_MAX)
+        col = SYNCTEX_COL_MAX;
+    return l | ((col + 1) << SYNCTEX_LINE_BITS);
+}
