+/* PNG export, for front-ends that draw the pages themselves.
+   (export-png dir width) turns it on; (export-range first last) says which
+   pages are visible. The engine then runs up to the last of them, and each
+   visible page is rendered to a PNG in dir when it changes, reported as
+     (page-image page page-count terminated "path" width height)
+   (width and height of the page in points)
+   The front-end owns the file afterwards (it should delete it).
+   (page-count n terminated) reports the number of pages when it changes. */
+static char export_dir[1024];
+static int export_width = 0, export_seq = 0;
+static int export_first = 0, export_last = 0;
+static uint64_t *export_hash = NULL;     // per page: hash of the last picture
+static int export_hash_len = 0;
+static int export_reported_count = -1, export_reported_done = -1;
+
+static void export_forget(void)
+{
+  for (int i = 0; i < export_hash_len; i++)
+    export_hash[i] = 0;
+}
+
+static uint64_t hash_bytes(const unsigned char *d, size_t n, uint64_t h)
+{
+  for (size_t i = 0; i < n; i++)
+    h = (h ^ d[i]) * 1099511628211ULL;
+  return h;
+}
+
+static void export_one(fz_context *ctx, ui_state *ui, int page, int count, int done)
+{
+  fz_display_list *dl = send(render_page, ui->eng, ctx, page);
+  if (!dl)
+    return;
+  fz_pixmap *pix = NULL;
+  fz_buffer *png = NULL;
+  fz_device *dev = NULL;
+  fz_var(pix);
+  fz_var(png);
+  fz_var(dev);
+  fz_try(ctx)
+  {
+    fz_rect bounds = fz_bound_display_list(ctx, dl);
+    float w = bounds.x1 - bounds.x0;
+    if (w <= 0)
+      fz_throw(ctx, FZ_ERROR_GENERIC, "empty page");
+    float scale = (float)export_width / w;
+    fz_matrix ctm = fz_scale(scale, scale);
+    fz_irect bbox = fz_round_rect(fz_transform_rect(bounds, ctm));
+    pix = fz_new_pixmap_with_bbox(ctx, fz_device_rgb(ctx), bbox, NULL, 0);
+    fz_clear_pixmap_with_value(ctx, pix, 255);
+    dev = fz_new_draw_device(ctx, fz_identity, pix);
+    fz_run_display_list(ctx, dl, dev, ctm, fz_infinite_rect, NULL);
+    fz_close_device(ctx, dev);
+
+    // the same picture as last time: nothing to report (the pixels are
+    // hashed before the slower PNG encoding)
+    uint64_t h = 14695981039346656037ULL;
+    h = hash_bytes(fz_pixmap_samples(ctx, pix),
+                   (size_t)fz_pixmap_stride(ctx, pix) * fz_pixmap_height(ctx, pix), h);
+    if (h == 0)
+      h = 1;
+    if (page >= export_hash_len)
+    {
+      int len = page + 64;
+      export_hash = realloc(export_hash, len * sizeof(uint64_t));
+      if (!export_hash)
+        abort();
+      for (int i = export_hash_len; i < len; i++)
+        export_hash[i] = 0;
+      export_hash_len = len;
+    }
+    if (export_hash[page] == h)
+      break;
+
+    png = fz_new_buffer_from_pixmap_as_png(ctx, pix, fz_default_color_params);
+    unsigned char *d;
+    size_t n = fz_buffer_storage(ctx, png, &d);
+    char path[1200];
+    snprintf(path, sizeof(path), "%s/page-%d-%d.png", export_dir, page, export_seq++);
+    FILE *f = fopen(path, "wb");
+    if (!f)
+      fz_throw(ctx, FZ_ERROR_GENERIC, "cannot write %s", path);
+    fwrite(d, 1, n, f);
+    fclose(f);
+    export_hash[page] = h;
+    // the page size in points (the front-end needs it for zoom levels)
+    printf("(page-image %d %d %d \"%s\" %.2f %.2f)\n", page, count, done, path,
+           bounds.x1 - bounds.x0, bounds.y1 - bounds.y0);
+  }
+  fz_always(ctx)
+  {
+    fz_drop_device(ctx, dev);
+    fz_drop_pixmap(ctx, pix);
+    fz_drop_buffer(ctx, png);
+    fz_drop_display_list(ctx, dl);
+  }
+  fz_catch(ctx)
+  {
+    fprintf(stderr, "[export-png] page %d: %s\n", page, fz_caught_message(ctx));
+  }
+}
+
+static void export_pages(fz_context *ctx, ui_state *ui)
+{
+  if (!export_dir[0] || export_width <= 0)
+    return;
+  int count = send(page_count, ui->eng);
+  int done = send(get_status, ui->eng) == DOC_TERMINATED;
+  if (count != export_reported_count || done != export_reported_done)
+  {
+    printf("(page-count %d %d)\n", count, done);
+    export_reported_count = count;
+    export_reported_done = done;
+  }
+  for (int page = export_first; page <= export_last && page < count; page++)
+    export_one(ctx, ui, page, count, done);
+  fflush(stdout);
+}
