+  // in the inclusion path, also try the name with .tex
+  if (!fs_path && self->inclusion_path && self->inclusion_path[0])
+  {
+    const char *base = strrchr(path, '/');
+    base = base ? base + 1 : path;
+    char with_tex[1024];
+    if (!strchr(base, '.') && strlen(path) + 5 < sizeof(with_tex))
+    {
+      snprintf(with_tex, sizeof(with_tex), "%s.tex", path);
+      inclusion_path = self->inclusion_path;
+      while ((fs_path = expand_path(&inclusion_path, with_tex, buf)))
+        if (stat(fs_path, st) != -1)
+          break;
+    }
+  }
+
+  if (!fs_path)
+    fs_path = kpse_picture(path, buf, st);
+
   return fs_path;
 }
 
