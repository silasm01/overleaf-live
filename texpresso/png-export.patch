+    fz_matrix trm = span->trm;
+    trm.e = 0;
+    trm.f = 0;
+    for (int i = 0; i < span->len; i++)
+    {
+      const fz_text_item *it = &span->items[i];
+      if (it->gid < 0)
+        continue;
+      fz_point p = fz_transform_point(fz_make_point(it->x, it->y), ctm);
+      float adv = fz_advance_glyph(ctx, span->font, it->gid, span->wmode);
+      fz_point w = fz_transform_vector(fz_transform_vector(fz_make_point(adv, 0), trm), ctm);
+      float x0 = p.x, x1 = p.x + w.x;
+      if (x1 < x0) { float t = x0; x0 = x1; x1 = t; }
+      fz_matrix gm = span->trm;
+      gm.e = it->x;
+      gm.f = it->y;
+      fz_rect ink = fz_transform_rect(fz_bound_glyph(ctx, span->font, it->gid, gm), ctm);
+      if (dev->picture > 0)
+      {
+        /* text in a picture is part of the picture */
+        glyph_picture(ctx, dev, fz_union_rect(ink, fz_make_rect(x0, p.y, x1, p.y)));
+        continue;
+      }
+      int iy0 = (int)(p.y * dev->inv), iy1 = iy0;
+      if (!fz_is_empty_rect(ink) && !fz_is_infinite_rect(ink))
+      { iy0 = (int)(ink.y0 * dev->inv); iy1 = (int)(ink.y1 * dev->inv); }
+      glyph_push(ctx, dev, (synctex_glyph){
+        (int)(x0 * dev->inv), (int)(x1 * dev->inv), (int)(p.y * dev->inv),
+        it->gid, fz_keep_font(ctx, span->font), iy0, iy1});
+    }
+  }
+}
