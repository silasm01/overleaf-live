diff --git a/src/frontend/engine_tex.c b/src/frontend/engine_tex.c
index 5866b1b..5d275b2 100644
--- a/src/frontend/engine_tex.c
+++ b/src/frontend/engine_tex.c
@@ -27,6 +27,7 @@
 #include <limits.h>
 #include <unistd.h>
 #include <string.h>
+#include <strings.h>
 #include <fcntl.h>
 #include <sys/wait.h>
 #include <sys/stat.h>
@@ -452,6 +453,56 @@ static fz_buffer *output_data(fileentry_t *e)
   return e->saved.data;
 }
 
+// Pictures that come with TeX Live (e.g. example-image-a.pdf from mwe):
+// the engine doesn't search the TeX tree for them, so ask kpsewhich.
+// Results are remembered, also when nothing was found.
+static const char *kpse_picture(const char *path, char buf[1024], struct stat *st)
+{
+  static const char *exts[] = {".pdf", ".png", ".jpg", ".jpeg", ".eps", NULL};
+  const char *dot = strrchr(path, '.');
+  if (!dot || strchr(path, '/') || strchr(path, '\'') || strchr(path, '"'))
+    return NULL;
+  int is_picture = 0;
+  for (int i = 0; exts[i]; i++)
+    if (strcasecmp(dot, exts[i]) == 0)
+      is_picture = 1;
+  if (!is_picture)
+    return NULL;
+
+  enum { N = 64 };
+  static char names[N][256], found[N][1024];
+  static int count = 0;
+  for (int i = 0; i < count; i++)
+    if (strcmp(names[i], path) == 0)
+    {
+      if (!found[i][0] || stat(found[i], st) == -1)
+        return NULL;
+      snprintf(buf, 1024, "%s", found[i]);
+      return buf;
+    }
+
+  char cmd[512], result[1024] = "";
+  snprintf(cmd, sizeof(cmd), "kpsewhich '%s' 2>/dev/null", path);
+  FILE *f = popen(cmd, "r");
+  if (f)
+  {
+    if (!fgets(result, sizeof(result), f))
+      result[0] = '\0';
+    pclose(f);
+  }
+  result[strcspn(result, "\r\n")] = '\0';
+  if (count < N && strlen(path) < 256)
+  {
+    snprintf(names[count], 256, "%s", path);
+    snprintf(found[count], 1024, "%s", result);
+    count++;
+  }
+  if (!result[0] || stat(result, st) == -1)
+    return NULL;
+  snprintf(buf, 1024, "%s", result);
+  return buf;
+}
+
 static const char *
 lookup_path(struct tex_engine *self, const char *path, char buf[1024], struct stat *st)
 {
@@ -468,6 +519,26 @@ lookup_path(struct tex_engine *self, const char *path, char buf[1024], struct st
   }
   while ((fs_path = expand_path(&inclusion_path, path, buf)));
 
+  // TeX asks for "modules/profile" when the file is "modules/profile.tex":
+  // in the inclusion path, also try the name with .tex
+  if (!fs_path && self->inclusion_path && self->inclusion_path[0])
+  {
+    const char *base = strrchr(path, '/');
+    base = base ? base + 1 : path;
+    char with_tex[1024];
+    if (!strchr(base, '.') && strlen(path) + 5 < sizeof(with_tex))
+    {
+      snprintf(with_tex, sizeof(with_tex), "%s.tex", path);
+      inclusion_path = self->inclusion_path;
+      while ((fs_path = expand_path(&inclusion_path, with_tex, buf)))
+        if (stat(fs_path, st) != -1)
+          break;
+    }
+  }
+
+  if (!fs_path)
+    fs_path = kpse_picture(path, buf, st);
+
   return fs_path;
 }
 
diff --git a/src/frontend/main.c b/src/frontend/main.c
index c202294..5f30605 100644
--- a/src/frontend/main.c
+++ b/src/frontend/main.c
@@ -917,6 +917,125 @@ static uint32_t convert_color(fz_context *ctx, vstack *stack, float frgb[3])
   return (rgb[0] << 16) | (rgb[1] << 8) | (rgb[2]);
 }
 
+/* PNG export, for front-ends that draw the pages themselves.
+   (export-png dir width) turns it on; (export-range first last) says which
+   pages are visible. The engine then runs up to the last of them, and each
+   visible page is rendered to a PNG in dir when it changes, reported as
+     (page-image page page-count terminated "path" width height)
+   (width and height of the page in points)
+   The front-end owns the file afterwards (it should delete it).
+   (page-count n terminated) reports the number of pages when it changes. */
+static char export_dir[1024];
+static int export_width = 0, export_seq = 0;
+static int export_first = 0, export_last = 0;
+static uint64_t *export_hash = NULL;     // per page: hash of the last picture
+static int export_hash_len = 0;
+static int export_reported_count = -1, export_reported_done = -1;
+
+static void export_forget(void)
+{
+  for (int i = 0; i < export_hash_len; i++)
+    export_hash[i] = 0;
+}
+
+static uint64_t hash_bytes(const unsigned char *d, size_t n, uint64_t h)
+{
+  for (size_t i = 0; i < n; i++)
+    h = (h ^ d[i]) * 1099511628211ULL;
+  return h;
+}
+
+static void export_one(fz_context *ctx, ui_state *ui, int page, int count, int done)
+{
+  fz_display_list *dl = send(render_page, ui->eng, ctx, page);
+  if (!dl)
+    return;
+  fz_pixmap *pix = NULL;
+  fz_buffer *png = NULL;
+  fz_device *dev = NULL;
+  fz_var(pix);
+  fz_var(png);
+  fz_var(dev);
+  fz_try(ctx)
+  {
+    fz_rect bounds = fz_bound_display_list(ctx, dl);
+    float w = bounds.x1 - bounds.x0;
+    if (w <= 0)
+      fz_throw(ctx, FZ_ERROR_GENERIC, "empty page");
+    float scale = (float)export_width / w;
+    fz_matrix ctm = fz_scale(scale, scale);
+    fz_irect bbox = fz_round_rect(fz_transform_rect(bounds, ctm));
+    pix = fz_new_pixmap_with_bbox(ctx, fz_device_rgb(ctx), bbox, NULL, 0);
+    fz_clear_pixmap_with_value(ctx, pix, 255);
+    dev = fz_new_draw_device(ctx, fz_identity, pix);
+    fz_run_display_list(ctx, dl, dev, ctm, fz_infinite_rect, NULL);
+    fz_close_device(ctx, dev);
+
+    // the same picture as last time: nothing to report (the pixels are
+    // hashed before the slower PNG encoding)
+    uint64_t h = 14695981039346656037ULL;
+    h = hash_bytes(fz_pixmap_samples(ctx, pix),
+                   (size_t)fz_pixmap_stride(ctx, pix) * fz_pixmap_height(ctx, pix), h);
+    if (h == 0)
+      h = 1;
+    if (page >= export_hash_len)
+    {
+      int len = page + 64;
+      export_hash = realloc(export_hash, len * sizeof(uint64_t));
+      if (!export_hash)
+        abort();
+      for (int i = export_hash_len; i < len; i++)
+        export_hash[i] = 0;
+      export_hash_len = len;
+    }
+    if (export_hash[page] == h)
+      break;
+
+    png = fz_new_buffer_from_pixmap_as_png(ctx, pix, fz_default_color_params);
+    unsigned char *d;
+    size_t n = fz_buffer_storage(ctx, png, &d);
+    char path[1200];
+    snprintf(path, sizeof(path), "%s/page-%d-%d.png", export_dir, page, export_seq++);
+    FILE *f = fopen(path, "wb");
+    if (!f)
+      fz_throw(ctx, FZ_ERROR_GENERIC, "cannot write %s", path);
+    fwrite(d, 1, n, f);
+    fclose(f);
+    export_hash[page] = h;
+    // the page size in points (the front-end needs it for zoom levels)
+    printf("(page-image %d %d %d \"%s\" %.2f %.2f)\n", page, count, done, path,
+           bounds.x1 - bounds.x0, bounds.y1 - bounds.y0);
+  }
+  fz_always(ctx)
+  {
+    fz_drop_device(ctx, dev);
+    fz_drop_pixmap(ctx, pix);
+    fz_drop_buffer(ctx, png);
+    fz_drop_display_list(ctx, dl);
+  }
+  fz_catch(ctx)
+  {
+    fprintf(stderr, "[export-png] page %d: %s\n", page, fz_caught_message(ctx));
+  }
+}
+
+static void export_pages(fz_context *ctx, ui_state *ui)
+{
+  if (!export_dir[0] || export_width <= 0)
+    return;
+  int count = send(page_count, ui->eng);
+  int done = send(get_status, ui->eng) == DOC_TERMINATED;
+  if (count != export_reported_count || done != export_reported_done)
+  {
+    printf("(page-count %d %d)\n", count, done);
+    export_reported_count = count;
+    export_reported_done = done;
+  }
+  for (int page = export_first; page <= export_last && page < count; page++)
+    export_one(ctx, ui, page, count, done);
+  fflush(stdout);
+}
+
 static void display_page(struct persistent_state *ps, ui_state *ui)
 {
   fz_display_list *dl = send(render_page, ui->eng, ps->ctx, ui->page);
@@ -1134,6 +1253,30 @@ static void interpret_command(struct persistent_state *ps,
       fprintf(stderr, "[command] rerun-once: pending immediate pass\n");
       schedule_event(SCAN_EVENT);
       break;
+
+    case EDIT_EXPORT_PNG:
+      snprintf(export_dir, sizeof(export_dir), "%s", cmd.export_png.dir);
+      export_width = cmd.export_png.width;
+      export_forget();
+      export_reported_count = -1;
+      fprintf(stderr, "[command] export-png %s %d\n", export_dir, export_width);
+      schedule_event(RELOAD_EVENT);
+      break;
+
+    case EDIT_GOTO_PAGE:
+      synctex_set_target(send(synctex, ui->eng, NULL), 0, NULL, 0);
+      ui->page = cmd.goto_page.page < 0 ? 0 : cmd.goto_page.page;
+      export_first = export_last = ui->page;
+      schedule_event(RELOAD_EVENT);
+      break;
+
+    case EDIT_EXPORT_RANGE:
+      synctex_set_target(send(synctex, ui->eng, NULL), 0, NULL, 0);
+      export_first = cmd.export_range.first < 0 ? 0 : cmd.export_range.first;
+      export_last = cmd.export_range.last < export_first ? export_first : cmd.export_range.last;
+      ui->page = export_last;          // the engine runs up to this page
+      schedule_event(RELOAD_EVENT);
+      break;
   }
 }
 
@@ -1353,6 +1496,10 @@ bool texpresso_main(struct persistent_state *ps)
 
       if (ui->page >= before_page_count && ui->page < after_page_count)
         schedule_event(RELOAD_EVENT);
+      // a visible page (PNG export) was finished
+      else if (export_dir[0] && after_page_count > before_page_count &&
+               export_last >= before_page_count && export_first < after_page_count)
+        schedule_event(RELOAD_EVENT);
 
       // Fire an on-demand rerun as soon as the engine is ready, regardless of
       // idle state. Runs in the main body of the loop (not inside the idle
@@ -1680,6 +1827,7 @@ bool texpresso_main(struct persistent_state *ps)
           }
           if (ui->page < page_count)
             display_page(ps, ui);
+          export_pages(ps->ctx, ui);
           break;
 
         case STDIN_EVENT:
