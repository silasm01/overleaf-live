+        .tag = EDIT_GOTO_PAGE,
+        .goto_page = {.page = val_number(ctx, page)},
+    };
+  }
   else if (strcmp(verb, "rescan") == 0)
   {
     if (len != 1)
diff --git a/src/frontend/editor.h b/src/frontend/editor.h
index 05fdd1c..0137f92 100644
--- a/src/frontend/editor.h
