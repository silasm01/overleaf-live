+/* Hit test of a page scan (scan_hit set before page_scan): the innermost
+   element with a stroked path nearest to the point (a line of a plot), in
+   points of the page */
+static int scan_hit;
+static fz_point scan_hit_pt;
+static float scan_hit_tol;
+static int scan_hit_el;
+static float scan_hit_d, scan_hit_area;
+
+struct hit_walk { fz_matrix ctm; fz_point last, start; float d; };
+
+static void hit_seg(struct hit_walk *w, fz_point a, fz_point b)
+{
+  fz_point p = scan_hit_pt;
+  float dx = b.x - a.x, dy = b.y - a.y, l2 = dx * dx + dy * dy, t = 0;
+  if (l2 > 0) t = ((p.x - a.x) * dx + (p.y - a.y) * dy) / l2;
+  if (t < 0) t = 0; else if (t > 1) t = 1;
+  float ex = a.x + t * dx - p.x, ey = a.y + t * dy - p.y;
+  float d = sqrtf(ex * ex + ey * ey);
+  if (d < w->d) w->d = d;
+}
+
+static void hit_moveto(fz_context *ctx, void *arg, float x, float y)
+{
+  (void)ctx;
+  struct hit_walk *w = arg;
+  w->last = w->start = fz_transform_point_xy(x, y, w->ctm);
+}
+
+static void hit_lineto(fz_context *ctx, void *arg, float x, float y)
+{
+  (void)ctx;
+  struct hit_walk *w = arg;
+  fz_point p = fz_transform_point_xy(x, y, w->ctm);
+  hit_seg(w, w->last, p);
+  w->last = p;
+}
+
+static void hit_curveto(fz_context *ctx, void *arg, float x1, float y1, float x2, float y2,
+                        float x3, float y3)
+{
+  (void)ctx;
+  struct hit_walk *w = arg;
+  fz_point p0 = w->last;
+  fz_point p1 = fz_transform_point_xy(x1, y1, w->ctm);
+  fz_point p2 = fz_transform_point_xy(x2, y2, w->ctm);
+  fz_point p3 = fz_transform_point_xy(x3, y3, w->ctm);
+  fz_point prev = p0;
+  for (int k = 1; k <= 8; k++)
+  {
+    float t = k / 8.0f, u = 1 - t;
+    fz_point q = {u * u * u * p0.x + 3 * u * u * t * p1.x + 3 * u * t * t * p2.x + t * t * t * p3.x,
+                  u * u * u * p0.y + 3 * u * u * t * p1.y + 3 * u * t * t * p2.y + t * t * t * p3.y};
+    hit_seg(w, prev, q);
+    prev = q;
+  }
+  w->last = p3;
+}
+
+static void hit_closepath(fz_context *ctx, void *arg)
+{
+  (void)ctx;
+  struct hit_walk *w = arg;
+  hit_seg(w, w->last, w->start);
+  w->last = w->start;
+}
+
+static void element_hit(fz_context *ctx, glyph_device *dev, const fz_path *path, fz_matrix ctm,
+                        int filled)
+{
+  if (!scan_hit)
+    return;
+  /* the innermost module marker (c); else the innermost path, plot or part
+     (not a scope) */
+  int el = -1;
+  for (int k = (dev->nlayers < MAX_LAYERS ? dev->nlayers : MAX_LAYERS) - 1; k >= 0 && el < 0; k--)
+    if (dev->layer[k] == LAYER_ELEMENT && dev->el[dev->layer_el[k]].kind == 'c')
+      el = dev->layer_el[k];
+  for (int k = (dev->nlayers < MAX_LAYERS ? dev->nlayers : MAX_LAYERS) - 1; k >= 0 && el < 0; k--)
+    if (dev->layer[k] == LAYER_ELEMENT && dev->el[dev->layer_el[k]].kind &&
+        strchr("pLt", dev->el[dev->layer_el[k]].kind))
+      el = dev->layer_el[k];
+  if (el < 0)
+    return;
+  static const fz_path_walker walker = {hit_moveto, hit_lineto, hit_curveto, hit_closepath};
+  struct hit_walk w = {ctm, {0, 0}, {0, 0}, 1e30f};
+  fz_rect r = fz_bound_path(ctx, path, NULL, ctm);
+  float area = (r.x1 - r.x0) * (r.y1 - r.y0);
+  if (filled && area < 400 && scan_hit_pt.x >= r.x0 && scan_hit_pt.x <= r.x1 &&
+      scan_hit_pt.y >= r.y0 && scan_hit_pt.y <= r.y1)
+    w.d = 0;   /* inside a small filled shape (a point of a plot) */
+  else
+    fz_walk_path(ctx, path, &walker, &w);
+  /* the nearest; about as near: the smaller shape */
+  if (w.d <= scan_hit_tol &&
+      (scan_hit_el < 0 || w.d < scan_hit_d - 0.5f ||
+       (w.d < scan_hit_d + 0.5f && area < scan_hit_area)))
+  {
+    scan_hit_el = el;
+    scan_hit_d = w.d;
+    scan_hit_area = area;
+  }
+}
+
+/* what is drawn in open elements makes their box */
+static void element_add(glyph_device *dev, fz_rect r)
+{
+  if (fz_is_empty_rect(r) || fz_is_infinite_rect(r))
+    return;
+  for (int i = 0; i < dev->nlayers && i < MAX_LAYERS; i++)
+    if (dev->layer[i] == LAYER_ELEMENT)
+    {
+      fz_rect *b = &dev->ebox[dev->layer_el[i]];
+      *b = fz_is_empty_rect(*b) ? r : fz_union_rect(*b, r);
+    }
+}
+
+/* "olive:b KIND LINE INDEX {DIR}{NAME}" */
+static void element_begin(fz_context *ctx, glyph_device *dev, const char *name, int slot)
+{
+  if (dev->nel == dev->capel)
+  {
+    int cap = dev->capel ? dev->capel * 2 : 64;
+    dev->el = fz_realloc_array(ctx, dev->el, cap, synctex_element);
+    dev->ebox = fz_realloc_array(ctx, dev->ebox, cap, fz_rect);
+    dev->capel = cap;
+  }
+  synctex_element *e = &dev->el[dev->nel];
+  memset(e, 0, sizeof(*e));
+  char kind = 0;
+  int line = 0, index = 0, used = 0;
+  if (sscanf(name, "olive:b %c %d %d %n", &kind, &line, &index, &used) < 3)
+    return;
+  e->kind = kind;
+  e->line = line;
+  e->index = index;
+  /* {dir}{name} -> "dir/name" ("" for the main file) */
+  const char *q = name + used;
+  char part[2][256] = {"", ""};
+  for (int k = 0; k < 2 && *q == '{'; k++)
+  {
+    const char *z = strchr(q, '}');
+    if (!z) break;
+    snprintf(part[k], sizeof(part[k]), "%.*s", (int)(z - q - 1), q + 1);
+    q = z + 1;
+  }
+  if (part[1][0])
+    snprintf(e->file, sizeof(e->file), "%s%s%s", part[0],
+             part[0][0] && part[0][strlen(part[0]) - 1] != '/' ? "/" : "", part[1]);
+  /* a module marker (kind c): its command name and action */
+  if (kind == 'c')
+    sscanf(q, " %39s %255s", e->name, e->action);
+  int depth = 0;
+  for (int i = 0; i < slot; i++)
+    if (dev->layer[i] == LAYER_ELEMENT) depth++;
+  e->depth = depth;
+  dev->ebox[dev->nel] = fz_empty_rect;
+  dev->layer_el[slot] = dev->nel++;
+  dev->layer[slot] = LAYER_ELEMENT;
+}
+
+static void glyph_push(fz_context *ctx, glyph_device *dev, synctex_glyph g)
+{
+  if (dev->n == dev->cap)
+  {
+    int cap = dev->cap ? dev->cap * 2 : 1024;
+    dev->g = fz_realloc_array(ctx, dev->g, cap, synctex_glyph);
+    dev->cap = cap;
+  }
+  dev->g[dev->n++] = g;
+}
+
+/* a picture is one "glyph" without a font: its box */
+static void glyph_picture(fz_context *ctx, glyph_device *dev, fz_rect r)
+{
+  if (fz_is_empty_rect(r) || fz_is_infinite_rect(r))
+    return;
+  element_add(dev, r);
+  if (dev->picture > 0)
+  {
+    dev->pbox = fz_is_empty_rect(dev->pbox) ? r : fz_union_rect(dev->pbox, r);
+    return;
+  }
+  float s = dev->inv;
+  glyph_push(ctx, dev, (synctex_glyph){(int)(r.x0 * s), (int)(r.x1 * s), (int)(r.y1 * s),
+                                       -1, NULL, (int)(r.y0 * s), (int)(r.y1 * s)});
+}
+
+static void glyph_begin_layer(fz_context *ctx, fz_device *dev_, const char *name)
+{
+  glyph_device *dev = (glyph_device *)dev_;
+  int i = dev->nlayers++;
+  if (i >= MAX_LAYERS)
+    return;
+  dev->layer[i] = LAYER_OTHER;
+  if (!name)
+    return;
+  if (strcmp(name, "olive-picture") == 0 && !dev->picture)
+  {
+    dev->picture = 1;
+    dev->pbox = fz_empty_rect;
+    dev->layer[i] = LAYER_PICTURE;
+  }
+  else if (strncmp(name, "olive:b ", 8) == 0)
+    element_begin(ctx, dev, name, i);
+  else if (strncmp(name, "olive:e ", 8) == 0)
+  {
+    /* the end of the innermost element: where its source ends */
+    for (int k = i - 1; k >= 0; k--)
+      if (dev->layer[k] == LAYER_ELEMENT)
+      {
+        dev->el[dev->layer_el[k]].end_line = atoi(name + 8);
+        break;
+      }
+    dev->layer[i] = LAYER_END;
+  }
+}
+
+static void glyph_end_layer(fz_context *ctx, fz_device *dev_)
+{
+  glyph_device *dev = (glyph_device *)dev_;
+  if (dev->nlayers <= 0)
+    return;
+  int i = --dev->nlayers;
+  if (i < MAX_LAYERS && dev->layer[i] == LAYER_PICTURE)
+  {
+    dev->picture = 0;
+    glyph_picture(ctx, dev, dev->pbox);
+  }
+}
+
+static void glyph_fill_shade(fz_context *ctx, fz_device *dev_, fz_shade *shade,
+                             fz_matrix ctm, float alpha, fz_color_params cp)
+{
+  (void)alpha; (void)cp;
+  element_add((glyph_device *)dev_, fz_bound_shade(ctx, shade, ctm));
+}
+
+static void glyph_fill_image(fz_context *ctx, fz_device *dev_, fz_image *img,
+                             fz_matrix ctm, float alpha, fz_color_params cp)
+{
+  (void)img; (void)alpha; (void)cp;
+  glyph_picture(ctx, (glyph_device *)dev_, fz_transform_rect(fz_unit_rect, ctm));
+}
+
+static void glyph_fill_path(fz_context *ctx, fz_device *dev_, const fz_path *path,
+                            int even_odd, fz_matrix ctm, fz_colorspace *cs,
+                            const float *color, float alpha, fz_color_params cp)
+{
+  glyph_device *dev = (glyph_device *)dev_;
+  (void)even_odd; (void)cs; (void)color; (void)alpha; (void)cp;
+  if (!dev->picture)
+    element_hit(ctx, dev, path, ctm, 1);
+  if (dev->picture > 0)   /* only in a picture: TikZ and rules are not glyphs */
+    glyph_picture(ctx, dev, fz_bound_path(ctx, path, NULL, ctm));
+  else
+    element_add(dev, fz_bound_path(ctx, path, NULL, ctm));
+}
+
+static void glyph_stroke_path(fz_context *ctx, fz_device *dev_, const fz_path *path,
+                              const fz_stroke_state *st, fz_matrix ctm, fz_colorspace *cs,
+                              const float *color, float alpha, fz_color_params cp)
+{
+  glyph_device *dev = (glyph_device *)dev_;
+  (void)cs; (void)color; (void)alpha; (void)cp; (void)st;
+  fz_rect r = fz_bound_path(ctx, path, NULL, ctm);   /* the stroke bound is too wide (miters) */
+  if (!dev->picture)
+    element_hit(ctx, dev, path, ctm, 0);
+  if (dev->picture > 0)
+  {
+    /* a picture's box: its paths only (its bottom is on the baseline) */
+    glyph_picture(ctx, dev, r);
+    return;
+  }
+  if (st && fz_is_valid_rect(r))
+  {
+    /* half the line width around the path itself (a straight line has an
+       empty box without it) */
+    float w = st->linewidth * 0.5f * fz_matrix_expansion(ctm);
+    r.x0 -= w; r.y0 -= w; r.x1 += w; r.y1 += w;
+  }
+  if (dev->picture > 0)
+    glyph_picture(ctx, dev, r);
+  else
+    element_add(dev, r);
+}
+
+static void glyph_fill_text(fz_context *ctx, fz_device *dev_, const fz_text *text,
+                            fz_matrix ctm, fz_colorspace *cs, const float *color,
+                            float alpha, fz_color_params cp)
+{
+  glyph_device *dev = (glyph_device *)dev_;
+  (void)cs; (void)color; (void)alpha; (void)cp;
+  for (fz_text_span *span = text->head; span; span = span->next)
+  {
+    fz_matrix trm = span->trm;
+    trm.e = 0;
+    trm.f = 0;
+    for (int i = 0; i < span->len; i++)
+    {
+      const fz_text_item *it = &span->items[i];
+      if (it->gid < 0)
+        continue;
+      fz_point p = fz_transform_point(fz_make_point(it->x, it->y), ctm);
+      float adv = fz_advance_glyph(ctx, span->font, it->gid, span->wmode);
+      fz_point w = fz_transform_vector(fz_transform_vector(fz_make_point(adv, 0), trm), ctm);
+      float x0 = p.x, x1 = p.x + w.x;
+      if (x1 < x0) { float t = x0; x0 = x1; x1 = t; }
+      fz_matrix gm = span->trm;
+      gm.e = it->x;
+      gm.f = it->y;
+      fz_rect ink = fz_transform_rect(fz_bound_glyph(ctx, span->font, it->gid, gm), ctm);
+      if (dev->picture > 0)
+      {
+        /* text in a picture is part of the picture */
+        glyph_picture(ctx, dev, fz_union_rect(ink, fz_make_rect(x0, p.y, x1, p.y)));
+        continue;
+      }
+      element_add(dev, fz_union_rect(ink, fz_make_rect(x0, p.y, x1, p.y)));
+      int iy0 = (int)(p.y * dev->inv), iy1 = iy0;
+      if (!fz_is_empty_rect(ink) && !fz_is_infinite_rect(ink))
+      { iy0 = (int)(ink.y0 * dev->inv); iy1 = (int)(ink.y1 * dev->inv); }
+      glyph_push(ctx, dev, (synctex_glyph){
+        (int)(x0 * dev->inv), (int)(x1 * dev->inv), (int)(p.y * dev->inv),
+        it->gid, fz_keep_font(ctx, span->font), iy0, iy1});
+    }
+  }
+}
+
+/* glyphs of a page in SyncTeX units; *n = their count; free with fz_free.
+   With els: also the elements of the page (free *els with fz_free). */
+static synctex_glyph *page_scan(fz_context *ctx, txp_engine *eng, int page, int *n,
+                                synctex_element **els, int *nels);
+
+/* page_scan with the hit test at x, y (SyncTeX units): *hit = the element
+   whose line passes near the point, -1 if none */
+static synctex_glyph *page_scan_hit(fz_context *ctx, txp_engine *eng, int page, int *n,
+                                    synctex_element **els, int *nels, int x, int y, int *hit)
+{
+  float fs = send(scale_factor, eng);
+  scan_hit = 1;
+  scan_hit_pt = fz_make_point(x * fs, y * fs);
+  scan_hit_tol = 4;
+  scan_hit_el = -1;
+  synctex_glyph *g = page_scan(ctx, eng, page, n, els, nels);
+  scan_hit = 0;
+  *hit = (*els && scan_hit_el < *nels) ? scan_hit_el : -1;
+  return g;
+}
+
+static synctex_glyph *page_glyphs(fz_context *ctx, txp_engine *eng, int page, int *n)
+{
+  return page_scan(ctx, eng, page, n, NULL, NULL);
+}
+
+static synctex_glyph *page_scan(fz_context *ctx, txp_engine *eng, int page, int *n,
+                                synctex_element **els, int *nels)
+{
+  *n = 0;
+  if (els) { *els = NULL; *nels = 0; }
+  float fs = send(scale_factor, eng);
+  if (fs <= 0)
+    return NULL;
+  glyph_device *dev = NULL;
+  fz_display_list *dl = NULL;
+  synctex_glyph *result = NULL;
+  fz_var(dev);
+  fz_var(dl);
+  fz_try(ctx)
+  {
+    dl = send(render_page, eng, ctx, page);
+    dev = fz_new_derived_device(ctx, glyph_device);
+    dev->super.fill_text = glyph_fill_text;
+    dev->super.fill_image = glyph_fill_image;
+    dev->super.fill_path = glyph_fill_path;
+    dev->super.stroke_path = glyph_stroke_path;
+    dev->super.begin_layer = glyph_begin_layer;
+    dev->super.end_layer = glyph_end_layer;
+    dev->super.fill_shade = glyph_fill_shade;
+    dev->inv = 1.0f / fs;
+    fz_run_display_list(ctx, dl, &dev->super, fz_identity, fz_infinite_rect, NULL);
+    fz_close_device(ctx, &dev->super);
+    result = dev->g;
+    *n = dev->n;
+    dev->g = NULL;
+    if (els)
+    {
+      for (int i = 0; i < dev->nel; i++)
+      {
+        fz_rect b = dev->ebox[i];
+        synctex_element *e = &dev->el[i];
+        e->has_box = !fz_is_empty_rect(b) && !fz_is_infinite_rect(b);
+        if (e->has_box)
+        {
+          e->x0 = (int)(b.x0 * dev->inv); e->y0 = (int)(b.y0 * dev->inv);
+          e->x1 = (int)(b.x1 * dev->inv); e->y1 = (int)(b.y1 * dev->inv);
+        }
+      }
+      *els = dev->el;
+      *nels = dev->nel;
+      dev->el = NULL;
+    }
+  }
+  fz_always(ctx)
+  {
+    if (dev)
+    {
+      if (dev->g)   /* not handed out: an error */
+        for (int i = 0; i < dev->n; i++) fz_drop_font(ctx, dev->g[i].font);
+      fz_free(ctx, dev->g);
+      fz_free(ctx, dev->el);
+      fz_free(ctx, dev->ebox);
+      fz_drop_device(ctx, &dev->super);
+    }
+    fz_drop_display_list(ctx, dl);
+  }
+  fz_catch(ctx)
+  {
+    *n = 0;
+    return NULL;
+  }
+  return result;
+}
+
+/* a source file as Unicode characters (SyncTeX and the editor count
+   characters, not bytes), with its line starts. Free with caret_file_free. */
+static int caret_file(fz_context *ctx, const char *doc_path, const char *path, int path_len,
+                      synctex_file *f)
+{
+  memset(f, 0, sizeof(*f));
+  char full[2048];
+  if (path[0] == '/' || !doc_path)
+    snprintf(full, sizeof full, "%.*s", path_len, path);
+  else
+    snprintf(full, sizeof full, "%s/%.*s", doc_path, path_len, path);
+  FILE *fp = fopen(full, "rb");
+  if (!fp)
+    return 0;
+  fseek(fp, 0, SEEK_END);
+  long size = ftell(fp);
+  fseek(fp, 0, SEEK_SET);
+  if (size < 0) { fclose(fp); return 0; }
+  char *in = fz_malloc(ctx, size + 1);
+  size = (long)fread(in, 1, size, fp);
+  fclose(fp);
+  int *out = fz_malloc(ctx, sizeof(int) * (size + 1));
+  int nl = 1;
+  for (long i = 0; i < size; i++) if (in[i] == '\n') nl++;
+  int *off = fz_malloc(ctx, sizeof(int) * nl);
+  long i = 0, n = 0;
+  int line = 0;
+  off[line++] = 0;
+  while (i < size)
+  {
+    unsigned char b = (unsigned char)in[i];
+    if (b == '\n')
+    {
+      out[n++] = '\n';
+      i++;
+      off[line++] = (int)n;
+      continue;
+    }
+    int cp = b, more = 0;
+    if (b >= 0xF0) { cp = b & 0x07; more = 3; }
+    else if (b >= 0xE0) { cp = b & 0x0F; more = 2; }
+    else if (b >= 0xC0) { cp = b & 0x1F; more = 1; }
+    i++;
+    while (more-- > 0 && i < size && ((unsigned char)in[i] & 0xC0) == 0x80)
+      cp = (cp << 6) | (in[i++] & 0x3F);
+    if (cp != '\r') out[n++] = cp;
+  }
+  fz_free(ctx, in);
+  out[n] = 0;
+  f->text = out;
+  f->len = (int)n;
+  f->line_off = off;
+  f->nlines = line;
+  return 1;
+}
+
+static void caret_file_free(fz_context *ctx, synctex_file *f)
+{
+  fz_free(ctx, (int *)f->text);
+  fz_free(ctx, (int *)f->line_off);
+  memset(f, 0, sizeof(*f));
+}
+
+static void drop_glyphs(fz_context *ctx, synctex_glyph *glyphs, int ng)
+{
+  for (int i = 0; i < ng; i++)
+    if (glyphs[i].font)
+      fz_drop_font(ctx, glyphs[i].font);
+  fz_free(ctx, glyphs);
+}
+
+enum { CAP_PTS = 16384, CAP_BOXES = 2048 };
+static synctex_debug_point caret_pts[CAP_PTS];
+static synctex_box caret_boxes[CAP_BOXES];
+static const float caret_pad = 1.0f;   /* points around a box */
+
+/* (synctex-debug page n line col x y height depth box ... m x0 y0 x1 y1 ...) */
+static void print_caret_map(int page, float fs, const synctex_caret_info *info)
+{
+  printf("(synctex-debug %d %d", page, info->npts);
+  for (int i = 0; i < info->npts; i++)
+  {
+    const synctex_debug_point *p = &info->pts[i];
+    printf(" %d %d %.2f %.2f %.2f %.2f %d", p->line, p->col, fs * p->x, fs * p->y,
+           fs * p->h, fs * p->d, p->box);
+  }
+  printf(" %d", info->nboxes);
+  for (int i = 0; i < info->nboxes; i++)
+  {
+    const synctex_box *b = &info->boxes[i];
+    printf(" %.2f %.2f %.2f %.2f", fs * b->x0 - caret_pad, fs * b->y0 - caret_pad,
+           fs * b->x1 + caret_pad, fs * b->y1 + caret_pad);
+  }
+  printf(")\n");
+}
+
+/* the main file, as an element names it (TeX gives no name for it) */
+static const char *main_file_name(struct persistent_state *ps)
+{
+  const char *base = strrchr(ps->doc_name, '/');
+  return base ? base + 1 : ps->doc_name;
+}
+
+/* a click on an element without glyphs under it (a line, a shape of a
+   TikZ picture): the editor goes to the start of its source */
+static int element_click(struct persistent_state *ps, ui_state *ui, int page, int x, int y)
+{
+  int ng = 0, ne = 0, done = 0, hit = -1;
+  synctex_element *els = NULL;
+  synctex_glyph *glyphs = page_scan_hit(ps->ctx, ui->eng, page, &ng, &els, &ne, x, y, &hit);
+  fz_buffer *sbuf;
+  synctex_t *stx = send(synctex, ui->eng, &sbuf);
+  synctex_resolve_elements(ps->ctx, stx, sbuf, page, els, ne);
+  int on_glyph = 0, slack = 65536 / 2;
+  for (int i = 0; i < ng && !on_glyph; i++)
+    if (glyphs[i].font && x >= glyphs[i].x0 - slack && x <= glyphs[i].x1 + slack &&
+        y >= glyphs[i].y0 - slack && y <= glyphs[i].y1 + slack)
+      on_glyph = 1;
+  /* text: SyncTeX knows its line, except in TikZ (all its text is on the
+     line where the picture ends): there the element */
+  int k = synctex_element_at(els, ne, x, y);
+  if (!on_glyph && hit >= 0)
+    k = hit;   /* on a line: the element that draws it */
+  if (on_glyph && k >= 0 && !strchr("ntp", els[k].kind))
+    k = -1;
+  if (k >= 0)
+  {
+    const synctex_element *e = &els[k];
+    const char *name = e->file[0] ? e->file : main_file_name(ps);
+    synctex_file file;
+    synctex_range r;
+    if (caret_file(ps->ctx, ps->doc_path, name, (int)strlen(name), &file))
+    {
+      if (synctex_element_range(&file, e, &r))
+      {
+        fprintf(stderr, "[synctex scan] element %c line %d -> %s:%d:%d\n", e->kind, e->line,
+                name, r.l0, r.c0);
+        editor_synctex(ps->doc_path, name, (int)strlen(name), r.l0, r.c0);
+        done = 1;
+      }
+      caret_file_free(ps->ctx, &file);
+    }
+  }
+  fz_free(ps->ctx, els);
+  drop_glyphs(ps->ctx, glyphs, ng);
+  return done;
+}
+
+static int field_load(void *env, const char *path, int len, synctex_file *f)
+{
+  struct persistent_state *ps = env;
+  return caret_file(ps->ctx, ps->doc_path, path, len, f);
+}
+
+static void field_unload(void *env, synctex_file *f)
+{
+  struct persistent_state *ps = env;
+  caret_file_free(ps->ctx, f);
+}
+
+static void print_sexp_string(const char *s)
+{
+  putchar('"');
+  for (; *s; s++)
+  {
+    if (*s == '"' || *s == '\\') { putchar('\\'); putchar(*s); }
+    else if (*s == '\n') fputs("\\n", stdout);
+    else putchar(*s);
+  }
+  putchar('"');
+}
+
+/* quick edit: a double-click on text in a field (the smallest $...$, {...}
+   or [...] around the clicked character): on stdout
+     (synctex-field "path" l0 c0 l1 c1 x0 y0 x1 y1 "text" sel0 sel1 shared)
+   (text: the source to edit, l0 c0 .. l1 c1; sel0 .. sel1: the clicked field
+   in it; shared: the field shows in several places, no edit box)
+   (lines from 1, columns from 0; the box of the clicked glyph, in points),
+   then the editor goes to its start. Returns 0 if there is no field. */
+static int field_click(struct persistent_state *ps, ui_state *ui, int page, int x, int y)
+{
+  int ng = 0, ne = 0, hit = -1;
+  synctex_element *els = NULL;
+  synctex_glyph *glyphs = page_scan_hit(ps->ctx, ui->eng, page, &ng, &els, &ne, x, y, &hit);
+  fz_buffer *sbuf;
+  synctex_t *stx = send(synctex, ui->eng, &sbuf);
+  synctex_resolve_elements(ps->ctx, stx, sbuf, page, els, ne);
+  static synctex_field_t f;
+  /* a toggle of a module (a K-map cell): the new list, applied at once */
+  {
+    int k = synctex_element_at(els, ne, x, y);
+    if (!(k >= 0 && els[k].kind == 'c') && hit >= 0)
+      k = hit;
+    if (k >= 0 && els[k].kind == 'c' && !strncmp(els[k].action, "cell:", 5))
+    {
+      /* a choice (a K-map cell: 0, 1 or D): the values and their edits */
+      const synctex_element *e = &els[k];
+      const char *name = e->file[0] ? e->file : main_file_name(ps);
+      synctex_file file;
+      static synctex_choice_t ch;
+      int done = 0;
+      if (caret_file(ps->ctx, ps->doc_path, name, (int)strlen(name), &file))
+      {
+        if (synctex_element_choice(&file, e, &ch))
+        {
+          char full[2048];
+          if (name[0] == '/') snprintf(full, sizeof full, "%s", name);
+          else snprintf(full, sizeof full, "%s/%s", ps->doc_path, name);
+          float fs = send(scale_factor, ui->eng);
+          printf("(synctex-choice ");
+          print_sexp_string(full);
+          printf(" %.2f %.2f %.2f %.2f ", fs * ch.box.x0, fs * ch.box.y0, fs * ch.box.x1,
+                 fs * ch.box.y1);
+          print_sexp_string(ch.current);
+          printf(" %d", ch.nopts);
+          for (int i = 0; i < ch.nopts; i++)
+          {
+            printf(" ");
+            print_sexp_string(ch.opts[i].label);
+            printf(" %d", ch.opts[i].nedits);
+            for (int j = 0; j < ch.opts[i].nedits; j++)
+            {
+              const synctex_edit *ed = &ch.opts[i].edits[j];
+              printf(" %d %d %d %d ", ed->l0, ed->c0, ed->l1, ed->c1);
+              print_sexp_string(ed->old);
+              printf(" ");
+              print_sexp_string(ed->text);
+            }
+          }
+          printf(")\n");
+          fprintf(stderr, "[synctex scan] choice %s line %d: %s\n", name, e->line, e->action);
