+  "% It marks each TikZ element, for the caret and for clicks:\n"
+  "%   \\special{olive:b KIND LINE INDEX {DIR}{FILE}} ... \\special{olive:e LINE}\n"
+  "% KIND p: the INDEX-th path of LINE (\\draw, \\fill, \\node, ... up to ;); n: the INDEX-th node of\n"
+  "% LINE; t: a node of the INDEX-th to[...] of LINE (e.g. a circuitikz part);\n"
+  "% s: a scope; P: a picture (tikzpicture, circuitikz, \\tikz).\n"
+  "% The markers change nothing in the drawing.\n"
+  "\\edef\\oliveRestoreCatcodes{\\catcode`\\noexpand\\@=\\the\\catcode`\\@\\relax}%\n"
+  "\\catcode`\\@=11\n"
+  "\\newcount\\olive@k\n"
+  "\\newcount\\olive@n\n"
+  "\\def\\olive@kline{-1}%\n"
+  "\\def\\olive@nline{-1}%\n"
+  "\\def\\olive@to{0}%\n"
+  "\\def\\olive@coordinate{coordinate}%\n"
+  "\\def\\olive@file{{\\ifdefined\\CurrentFilePath\\detokenize\\expandafter{\\CurrentFilePath}\\fi}%\n"
+  "  {\\ifdefined\\CurrentFile\\detokenize\\expandafter{\\CurrentFile}\\fi}}%\n"
+  "\\def\\olive@b#1#2{\\special{olive:b #1 \\the\\inputlineno\\space#2 \\olive@file}}%\n"
+  "\\def\\olive@e{\\special{olive:e \\the\\inputlineno}}%\n"
+  "% A path ends after \\tikz@finish closes its group (\\tikz@path@do@at@end);\n"
+  "% \\tikz@finish of a node shape runs deeper, inside the path.\n"
+  "\\def\\olive@plevel{-1}%\n"
+  "\\newcount\\olive@p\n"
+  "\\def\\olive@pline{-1}%\n"
+  "\\def\\olive@path{\\gdef\\olive@to{0}%\n"
+  "  \\ifnum\\olive@plevel<0\n"
+  "    \\edef\\olive@here{\\the\\inputlineno}%\n"
+  "    \\ifx\\olive@here\\olive@pline\n"
+  "      \\global\\advance\\olive@p by 1\n"
+  "    \\else\n"
+  "      \\global\\olive@p=1\n"
+  "      \\global\\let\\olive@pline\\olive@here\n"
+  "    \\fi\n"
+  "    \\olive@b p{\\the\\olive@p}\\xdef\\olive@plevel{\\the\\currentgrouplevel}%\n"
+  "  \\fi}%\n"
+  "\\let\\olive@doatend\\tikz@path@do@at@end\n"
+  "\\def\\tikz@path@do@at@end{%\n"
+  "  \\ifnum\\currentgrouplevel<\\olive@plevel\\relax\n"
+  "    \\olive@e\\gdef\\olive@plevel{-1}%\n"
+  "  \\fi\n"
+  "  \\olive@doatend}%\n"
+  "\\def\\olive@beginto{%\n"
+  "  \\edef\\olive@here{\\the\\inputlineno}%\n"
+  "  \\ifx\\olive@here\\olive@kline\n"
+  "    \\global\\advance\\olive@k by 1\n"
+  "  \\else\n"
+  "    \\global\\olive@k=1\n"
+  "    \\global\\let\\olive@kline\\olive@here\n"
+  "  \\fi\n"
+  "  \\xdef\\olive@to{\\the\\olive@k}}%\n"
+  "\\let\\olive@multipartnode\\pgfmultipartnode\n"
+  "\\def\\pgfmultipartnode#1#2#3#4{%\n"
+  "  \\def\\olive@shape{#1}%\n"
