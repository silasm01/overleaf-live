+  else
+    snprintf(full, sizeof full, "%s/%s", ps->doc_path, f.file);
+  printf("(synctex-field ");
+  print_sexp_string(full);
+  printf(" %d %d %d %d %.2f %.2f %.2f %.2f ", f.l0, f.c0, f.l1, f.c1,
+         fs * f.box.x0, fs * f.box.y0, fs * f.box.x1, fs * f.box.y1);
+  print_sexp_string(f.text);
+  printf(" %d %d %d", f.sel0, f.sel1, f.shared);
+  if (f.options[0] || f.nalso)
