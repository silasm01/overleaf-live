+/* Refine the last forward match with the column: point of the caret (x, y on
+   the baseline) and height/depth of its line, in SyncTeX units. */
+/* The glyphs of the page (from its display list), in SyncTeX units: left and
+   right edge and baseline. With them and the text of the source line, the
+   caret goes to the glyph of each visible character; without them (NULL),
+   it is interpolated between the SyncTeX records. */
+typedef struct { int x0, x1, y, gid; fz_font *font; int y0, y1; } synctex_glyph;
+/* x0, x1: left and right edge (advance); y: baseline; y0, y1: top and
+   bottom of the ink. A picture is a "glyph" with gid -1 and no font. */
+/* Some lines of the source around the target line, joined with '\n', as
+   Unicode characters (SyncTeX and the editor count characters, not bytes):
+   line first_line starts at offsets[0], ... */
+typedef struct {
+  const int *text;
+  int len, first_line, nlines;
+  int offsets[8];
+} synctex_source;
+/* A part of the source that does not map 1:1 to glyphs (\infty, \ref{...},
+   \includegraphics...): the caret goes to its start and the viewer shows a
+   box around its glyphs (or picture). */
+typedef struct { int x0, y0, x1, y1; } synctex_box;
+/* Debug: the caret of every character of the source window */
+typedef struct { int line, col, x, y, h, d, box; } synctex_debug_point;
+typedef struct {
+  int has_box;                 /* out: box of the caret */
+  synctex_box box;
+  int debug;                   /* in: fill pts and boxes */
+  synctex_debug_point *pts;    /* in: arrays of the caller; out: counts */
+  int npts, cappts;
+  synctex_box *boxes;
+  int nboxes, capboxes;
+} synctex_caret_info;
+int synctex_refine_target(fz_context *ctx, synctex_t *stx, fz_buffer *buf,
