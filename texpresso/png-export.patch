+/* ------------------------------------------------------------------------
+   Overleaf Live: column-exact SyncTeX.
+
+   The engine writes "tag,line,column" links. The column is the index (from 0)
+   of the next character TeX reads in the source line when it makes the node.
+   For the glue of an interword space at index i, that is i + 1: the start
+   of the next word. The record point is the end of the space: also the start
+   of the next word. So the column maps to the x of the record. Between two records on the same baseline, we
+   interpolate linearly.
+   ------------------------------------------------------------------------ */
+
+struct walk_item {
+  struct record r;
+  int parent_v;   /* ENTER_H: the box around it is a vbox (or none): a line */
+  int box;        /* id of the innermost hbox, 0 if none */
+  int bh, bd;     /* height and depth of that hbox */
+  int bx0, bx1;   /* left and right edge of that hbox */
+};
+
+typedef void (*walk_fn)(void *env, const struct walk_item *it);
+
+static void walk_page(fz_context *ctx, synctex_t *stx, fz_buffer *buf,
+                      int page, walk_fn fn, void *env)
+{
+  if (page < 0 || page >= synctex_page_count(stx))
+    return;
+  const uint8_t *ptr = synctex_page_pointer(ctx, stx, buf, page);
+  enum { MAXNEST = 256 };
+  struct walk_item stack[MAXNEST];
+  int nest = 0, next_id = 0;
+  struct record r = {0,};
+  while ((ptr = parse_line(ptr, &r)))
+  {
+    switch (r.kind)
+    {
+      case STEX_ENTER_H:
+      case STEX_ENTER_V:
+        if (nest < MAXNEST)
+        {
+          struct walk_item *it = &stack[nest];
+          it->r = r;
+          it->parent_v = (nest == 0) || stack[nest - 1].r.kind == STEX_ENTER_V;
+          it->box = (r.kind == STEX_ENTER_H) ? ++next_id : 0;
+          it->bh = r.size.height;
+          it->bd = r.size.depth;
+          it->bx0 = r.point.x;
+          it->bx1 = r.point.x + r.size.width;
+          fn(env, it);
+        }
+        nest += 1;
+        break;
+      case STEX_LEAVE_H:
+      case STEX_LEAVE_V:
+        if (nest > 0)
+          nest -= 1;
+        break;
+      case STEX_CURRENT:
+      case STEX_KERN:
+      case STEX_GLUE:
+      case STEX_MATH:
+      {
+        struct walk_item it = {.r = r, .box = 0};
+        int i = (nest < MAXNEST ? nest : MAXNEST) - 1;
+        while (i >= 0 && stack[i].r.kind != STEX_ENTER_H)
+          i -= 1;
+        if (i >= 0)
+        {
+          it.box = stack[i].box;
+          it.bh = stack[i].bh;
+          it.bd = stack[i].bd;
+          it.bx0 = stack[i].bx0;
+          it.bx1 = stack[i].bx1;
+        }
+        fn(env, &it);
+        break;
+      }
+      default:
+        break;
+    }
+  }
+}
+
+static int estimate_char_width(int h)
+{
+  /* about half an em: an hbox of 10pt text has a height of about 7pt */
+  int w = h * 62 / 100;
+  return w > 0 ? w : 5 * 65536;
+}
+
+/* Width of the space that a glue or kern record starts. The word after it
+   starts at x + width. Glue records do not give their width. */
+static int space_width(const struct walk_item *it)
+{
+  (void)it;
+  return 0; /* the record point is already after the space */
+}
+
+/* ---------------- forward ---------------- */
+
+struct fwd_env {
+  int tag, line, c;
+  int has_l, has_r, has_f, has_prev, has_rprev, has_next, has_nprev;
+  struct walk_item l, r, f, prev, rprev, next, nprev;
+};
+
+static void fwd_fn(void *penv, const struct walk_item *it)
+{
+  struct fwd_env *e = penv;
+  if (it->r.kind == STEX_ENTER_H || it->r.kind == STEX_ENTER_V)
+    return;
+  if (it->r.link.tag != e->tag || it->r.link.line != e->line)
+  {
+    /* the first text after the line, for a line that typesets nothing */
+    if (!e->has_next && it->box && it->r.link.tag == e->tag &&
+        it->r.link.line > e->line)
+    {
+      e->next = *it;
+      e->has_next = 1;
+      e->has_nprev = e->has_prev && e->prev.box == it->box &&
+                     e->prev.r.point.y == it->r.point.y;
+      if (e->has_nprev)
+        e->nprev = e->prev;
+    }
+    e->prev = *it;
+    e->has_prev = 1;
+    return;
+  }
+  struct walk_item before = e->prev;
+  int has_before = e->has_prev;
+  e->prev = *it;
+  e->has_prev = 1;
+  if (!e->has_f)
+  {
+    e->f = *it;
+    e->has_f = 1;
+    /* the record before the first record of this line ends the text before
+       the line: index 0 of the line starts there */
+    e->has_rprev = has_before && before.box == it->box &&
+                   before.r.point.y == it->r.point.y;
+    if (e->has_rprev)
+      e->rprev = before;
+  }
+  int col = it->r.link.column;
+  if (col < 0 || e->c < 0)
+    return;
+  int a = col - 1;
+  if (a <= e->c)
+  {
+    /* left anchor: largest index, last one in reading order on a tie */
+    if (!e->has_l || a >= e->l.r.link.column)
+    {
+      e->l = *it;
+      e->has_l = 1;
+    }
+  }
+  else
+  {
+    /* right anchor: smallest index, first one on a tie */
+    if (!e->has_r || a < e->r.r.link.column)
+    {
+      e->r = *it;
+      e->has_r = 1;
+    }
+  }
+}
+
+/* ---------------- forward, with glyphs ---------------- */
+
+/* the lines of the page (hboxes in a vbox) and the interword glue records
+   of the target source line */
+struct line_box { int y, h, d, x0, x1; };
+struct glue_rec { int a, x, y; };
+struct glyph_env {
+  int tag, first_line, nwin;
+  const int *offsets;      /* offset of each source line of the window */
+  struct line_box *lines; int nlines, caplines;
+  struct glue_rec *glues; int nglues, capglues;
+};
+
+static void glyph_walk_fn(void *penv, const struct walk_item *it)
+{
+  struct glyph_env *e = penv;
+  if (it->r.kind == STEX_ENTER_H && it->parent_v && it->r.size.width > 0)
+  {
+    if (e->nlines < e->caplines)
+      e->lines[e->nlines++] = (struct line_box){it->r.point.y, it->r.size.height,
+                                                it->r.size.depth, it->r.point.x,
+                                                it->r.point.x + it->r.size.width};
+  }
+  else if ((it->r.kind == STEX_GLUE || it->r.kind == STEX_KERN) &&
+           it->r.link.tag == e->tag && it->r.link.line >= e->first_line &&
+           it->r.link.line < e->first_line + e->nwin && it->r.link.column >= 0)
+  {
+    /* an interword space: the column is the start of the next word, and so
+       is the point. a: offset in the text of the window. */
+    if (e->nglues < e->capglues)
+      e->glues[e->nglues++] = (struct glue_rec){
+        e->offsets[it->r.link.line - e->first_line] + it->r.link.column,
+        it->r.point.x, it->r.point.y};
+  }
+}
+
+struct sglyph { int x0, x1, line, index, y, box_of_seg; };
+/* a line of glyphs: its box, baseline, height and depth */
+struct seg { int box, y, y0, h, d, tall; };
+enum { MAXS = 4096 };
+static struct seg segs[MAXS];
+static int nsegs;
+
+static int cmp_sglyph(const void *a, const void *b)
+{
+  const struct sglyph *ga = a, *gb = b;
+  if (ga->line != gb->line) return (ga->line > gb->line) - (ga->line < gb->line);
+  return (ga->x0 > gb->x0) - (ga->x0 < gb->x0);
+}
+
+static int cmp_sglyph_box_y(const void *a, const void *b)
+{
+  const struct sglyph *ga = a, *gb = b;
+  if (ga->line != gb->line) return (ga->line > gb->line) - (ga->line < gb->line);
+  if (ga->y != gb->y) return (ga->y > gb->y) - (ga->y < gb->y);
+  return (ga->x0 > gb->x0) - (ga->x0 < gb->x0);
+}
+
+static int line_of_point(const struct line_box *lines, int nlines, int x, int y, int slack);
+
+/* the line of glyphs of a point: in its box, the line with the nearest
+   baseline */
+static int seg_of_point(const struct line_box *lines, int nlines, int x, int y, int slack)
+{
+  int b = line_of_point(lines, nlines, x, y, slack);
+  if (b < 0) return -1;
+  int best = -1, bestd = 0;
+  for (int k = 0; k < nsegs; k++)
+    if (segs[k].box == b)
+    {
+      int d = abs(segs[k].y - y);
+      if (best < 0 || d < bestd) { best = k; bestd = d; }
+    }
+  return best;
+}
+
+static int line_contains(const struct line_box *l, int x, int y, int slack)
+{
+  return x >= l->x0 - slack && x <= l->x1 + slack &&
+         y >= l->y - l->h - slack && y <= l->y + l->d + slack;
+}
+
+static int line_of_point(const struct line_box *lines, int nlines, int x, int y, int slack)
+{
+  int best = -1;
+  double best_area = 0;
+  for (int i = 0; i < nlines; i++)
+    if (line_contains(&lines[i], x, y, slack))
+    {
+      double area = (double)(lines[i].x1 - lines[i].x0) * (double)(lines[i].h + lines[i].d + 1);
+      if (best < 0 || area < best_area) { best = i; best_area = area; }
+    }
+  return best;
+}
+
+/* What the source says at each character: a character that may make a glyph
+   (CAND), a space (SPACE: no glyph, the end of a word), or something that
+   makes no glyph of its own (OTHER: a command name, braces, a comment). */
+enum { CH_OTHER, CH_SPACE, CH_CAND, CH_COMMENT };
+
+static int is_letter_cp(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
+
+/* commands whose first braced argument is a name and not printed text */
+static int is_markup_arg_cmd(const int *s, int len)
+{
+  static const char *names[] = {
+    "begin", "end", "label", "ref", "eqref", "cref", "Cref", "autoref", "pageref",
+    "nameref", "cite", "citep", "citet", "parencite", "textcite", "autocite",
+    "input", "include", "includegraphics", "usepackage", "RequirePackage",
+    "documentclass", "newcommand", "renewcommand", "providecommand",
+    "newenvironment", "renewenvironment", "setlength", "addtolength",
+    "href", "color", "textcolor", "pagestyle",
+    "thispagestyle", "bibliography", "bibliographystyle", "addbibresource",
+    "vspace", "hspace", "setcounter", "addtocounter", NULL };
+  for (int k = 0; names[k]; k++)
+  {
+    int l = (int)strlen(names[k]);
+    if (l != len) continue;
+    int i = 0;
+    while (i < l && s[i] == (unsigned char)names[k][i]) i++;
+    if (i == l) return 1;
+  }
+  return 0;
+}
+
+static void classify_source(const int *s, int n, unsigned char *k)
+{
+  int i = 0;
+  while (i < n)
+  {
+    int c = s[i];
+    if (c == '%')
+    {
+      /* a comment, and its line break: no space */
+      while (i < n && s[i] != '\n') k[i++] = CH_COMMENT;
+      if (i < n) k[i++] = CH_OTHER;
+      continue;
+    }
+    if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '~')
+    { k[i++] = CH_SPACE; continue; }
+    if (c == '\\' && i + 1 < n)
+    {
+      int d = s[i + 1];
+      if (is_letter_cp(d))
+      {
+        int j = i + 1;
+        while (j < n && is_letter_cp(s[j])) j++;
+        int verb = (j - i - 1 == 4 && s[i + 1] == 'v' && s[i + 2] == 'e' &&
+                    s[i + 3] == 'r' && s[i + 4] == 'b');
+        int argcmd = is_markup_arg_cmd(s + i + 1, j - i - 1);
+        while (i < j) k[i++] = CH_OTHER;
+        if (argcmd)
+        {
+          /* \begin{name}, \ref{key}, ...: the argument is not printed */
+          int m = i;
+          while (m < n && (s[m] == ' ' || s[m] == '*')) m++;
+          if (m < n && s[m] == '[')
+          {
+            while (m < n && s[m] != ']' && s[m] != '\n') m++;
+            if (m < n && s[m] == ']') m++;
+          }
+          if (m < n && s[m] == '{')
+          {
+            int depth = 0;
+            while (m < n)
+            {
+              if (s[m] == '{') depth++;
+              else if (s[m] == '}' && --depth == 0) { m++; break; }
+              else if (s[m] == '\n') break;
+              m++;
+            }
+            while (i < m) k[i++] = CH_OTHER;
+          }
+        }
+        if (verb && i < n)
+        {
+          /* \verb|...|: the text between the delimiters is printed */
+          int delim = s[i];
+          k[i++] = CH_OTHER;
+          while (i < n && s[i] != delim && s[i] != '\n')
+            k[i] = (s[i] == ' ') ? CH_SPACE : CH_CAND, i++;
+          if (i < n && s[i] == delim) k[i++] = CH_OTHER;
+        }
+        continue;
+      }
+      /* \%, \&, \_, \#, \$: the character; \\, \,, \( ... : nothing */
+      k[i] = CH_OTHER;
+      k[i + 1] = (d == '%' || d == '&' || d == '_' || d == '#' || d == '$' ||
+                  d == '{' || d == '}') ? CH_CAND : (d == ' ' ? CH_SPACE : CH_OTHER);
+      i += 2;
+      continue;
+    }
+    if (c == '{' || c == '}' || c == '$' || c == '^' || c == '_' || c == '&' || c == '#')
+    { k[i++] = CH_OTHER; continue; }
+    k[i++] = CH_CAND;
+  }
+}
+
+/* Does source character u make glyph g? (also the TeX ligatures) */
+static int glyph_matches(fz_context *ctx, const synctex_glyph *g, int u)
+{
+  if (!g->font)
+    return 0;
+  static const int alt[][4] = {
+    /* source -> other characters the font may show for it */
+    {'f', 0xFB00, 0xFB01, 0xFB02}, {'f', 0xFB03, 0xFB04, 0},
+    {'-', 0x2013, 0x2014, 0x2010}, {'-', 0x2212, 0, 0},
+    {'`', 0x2018, 0x201C, 0}, {'\'', 0x2019, 0x201D, 0},
+    {'"', 0x201C, 0x201D, 0},
+  };
+  int gid = fz_encode_character(ctx, g->font, u);
+  if (gid > 0 && gid == g->gid)
+    return 1;
+  for (unsigned i = 0; i < sizeof(alt) / sizeof(alt[0]); i++)
+    if (alt[i][0] == u)
+      for (int j = 1; j < 4 && alt[i][j]; j++)
+      {
+        gid = fz_encode_character(ctx, g->font, alt[i][j]);
+        if (gid > 0 && gid == g->gid)
+          return 1;
+      }
+  return 0;
+}
+
+/* Markup (command names, braces, comments) is printed only as code: in a
+   listing or \verb, in a typewriter font */
+static int match_ok(fz_context *ctx, const synctex_glyph *g, int u, int weight)
+{
+  if (weight < 2 && !(g->font && fz_font_is_monospaced(ctx, g->font)))
+    return 0;
+  return glyph_matches(ctx, g, u);
+}
+
+/* The caret with glyphs: the glyphs of the page in reading order (line by
+   line), anchored at interword spaces of the source window (glue/kern
+   records whose source character before is a space). Between the anchors,
+   the source characters are aligned with the glyphs by character (the
+   longest common subsequence, with the fonts' character maps). A character
+   with a glyph gets its left edge. A part of the source without glyphs of
+   its own between glyphs that no character took (\infty, \ref{...}, a
+   picture) is a group: the caret goes to the start of its glyphs and the
+   viewer shows a box around them. Other characters go next to their
+   neighbours with glyphs. */
+struct rc {
+  fz_context *ctx;
+  const synctex_glyph *glyphs;
+  const synctex_source *source;
+  const int *src;
+  int srclen;
+  unsigned char *kind;
+  struct sglyph *g;
+  int n;
+  struct line_box *lines;
+  int nlines;
+  struct glue_rec *glues;
+  int nglues;
+  int slack, dbg;
+  int *match, *order, *dp;
+  long dpcap;
+  int ks0, ks1, kq0, kq1;     /* the alignment that is in match[] */
+};
+
+enum { RC_MAXL = 1024, RC_MAXR = 1024 };
+static struct line_box rc_lines[RC_MAXL];
+static struct glue_rec rc_glues[RC_MAXR];
+
+static void rc_free(struct rc *r)
+{
+  free(r->kind); free(r->g); free(r->match); free(r->order); free(r->dp);
+  memset(r, 0, sizeof(*r));
+}
+
+static int rc_prepare(struct rc *r, fz_context *ctx, synctex_t *stx, fz_buffer *buf,
+                      int page, int tag, const synctex_glyph *glyphs, int nglyphs,
+                      const synctex_source *source)
+{
+  memset(r, 0, sizeof(*r));
+  if (!source || !source->text || !glyphs || nglyphs <= 0)
+  {
+    if (getenv("TXP_CARET_DEBUG"))
+      fprintf(stderr, "[caret] no source (%p) or glyphs (%d)\n", (void *)(source ? source->text : NULL), nglyphs);
+    return 0;
+  }
+  r->ctx = ctx;
+  r->glyphs = glyphs;
+  r->source = source;
+  r->src = source->text;
+  r->srclen = source->len;
+  r->slack = 65536;   /* 1pt in SyncTeX units (sp) */
+  r->dbg = getenv("TXP_CARET_DEBUG") != NULL;
+  r->ks0 = -1;
+  struct glyph_env e = {tag, source->first_line, source->nlines, source->offsets,
+                        rc_lines, 0, RC_MAXL, rc_glues, 0, RC_MAXR};
+  walk_page(ctx, stx, buf, page, glyph_walk_fn, &e);
+  if (e.nlines == 0)
+    return 0;
+  r->lines = rc_lines;
+  r->nlines = e.nlines;
+  r->glues = rc_glues;
+  r->nglues = e.nglues;
+  r->kind = malloc(r->srclen + 1);
+  r->g = malloc(sizeof(*r->g) * nglyphs);
+  r->match = malloc(sizeof(int) * (r->srclen + 1));
+  r->order = malloc(sizeof(int) * (r->srclen + 1));
+  if (!r->kind || !r->g || !r->match || !r->order)
+    return 0;
+  classify_source(r->src, r->srclen, r->kind);
+
+  /* the glyph stream. A glyph belongs to the smallest line box around it;
+     in a box, glyphs whose baselines are within 6pt make one line (a
+     superscript stays in its line, the rows of a table do not). Order:
+     box, line in the box (top down), x. g[i].line = index of that line in
+     segs[], g[i].index = index in glyphs[]. */
+  struct sglyph *g = r->g;
+  int n = 0, slack = r->slack;
+  for (int i = 0; i < nglyphs; i++)
+  {
+    int l = line_of_point(r->lines, r->nlines, (glyphs[i].x0 + glyphs[i].x1) / 2,
+                          glyphs[i].y, slack / 4);
+    if (l >= 0)
+      g[n++] = (struct sglyph){glyphs[i].x0, glyphs[i].x1, l, i};
+  }
+  for (int i = 0; i < n; i++) g[i].y = glyphs[g[i].index].y;
+  qsort(g, n, sizeof(g[0]), cmp_sglyph_box_y);
+  nsegs = 0;
+  for (int i = 0; i < n; i++)
+  {
+    if (i == 0 || g[i].line != g[i - 1].box_of_seg ||
+        g[i].y - segs[nsegs - 1].y0 > 6 * slack)
+    {
+      if (nsegs == MAXS) { n = i; break; }
+      const struct line_box *b = &r->lines[g[i].line];
+      int tall = b->h + b->d > 30 * slack;
+      segs[nsegs] = (struct seg){g[i].line, g[i].y, g[i].y,
+                                 tall ? 8 * slack : b->h, tall ? 3 * slack : b->d, tall};
+      nsegs++;
+    }
+    struct seg *sg = &segs[nsegs - 1];
+    if (g[i].y < sg->y0) sg->y0 = g[i].y;
+    g[i].box_of_seg = g[i].line;
+    g[i].line = nsegs - 1;
+  }
+  /* the baseline of a line: the most common one (not a superscript) */
+  for (int k = 0; k < nsegs; k++)
+    if (!segs[k].tall) segs[k].y = r->lines[segs[k].box].y;
+  qsort(g, n, sizeof(g[0]), cmp_sglyph);
+  r->n = n;
+  if (r->dbg)
+    fprintf(stderr, "[caret] page %d: %d glyphs, %d in lines, %d line boxes, %d records\n",
+            page, nglyphs, n, r->nlines, r->nglues);
+  return n > 0;
+}
+
+/* the source line (index in the window) of character c */
+static int rc_line_of(const struct rc *r, int c)
+{
+  int li = 0;
+  while (li + 1 < r->source->nlines && r->source->offsets[li + 1] <= c) li++;
+  return li;
+}
+
+struct span { int s0, s1, q0, q1, aL, pL, aR, pR, ox, oy; };
+
+/* Anchors and the part to align for character c (ox, oy: the point that
+   SyncTeX found), and the alignment in match[]. */
+static int rc_align(struct rc *r, int c, int ox, int oy, struct span *sp)
+{
+  const int *src = r->src;
+  const unsigned char *kind = r->kind;
+  struct sglyph *g = r->g;
+  int n = r->n, srclen = r->srclen, slack = r->slack;
+  int aL = -1, pL = -1, aR = -1, pR = -1;
+  for (int k = 0; k < r->nglues; k++)
+  {
+    int a = r->glues[k].a;
+    /* a word starts there: after a space, a visible character or a
+       command name (not &, {, $, \( ...) */
+    if (a <= 0 || a >= srclen || kind[a - 1] != CH_SPACE || kind[a] == CH_SPACE ||
+        kind[a] == CH_COMMENT)
+      continue;
+    if (kind[a] == CH_OTHER &&
+        !(src[a] == '\\' && a + 1 < srclen && is_letter_cp(src[a + 1])))
+      continue;
+    int l = seg_of_point(r->lines, r->nlines, r->glues[k].x, r->glues[k].y, slack);
+    if (l < 0) continue;
+    int p = 0;
+    while (p < n && (g[p].line < l || (g[p].line == l && (g[p].x0 + g[p].x1) / 2 < r->glues[k].x)))
+      p++;
+    /* several records with the same character: the last one in reading
+       order is at the word */
+    if (a <= c && (a > aL || (a == aL && p > pL))) { aL = a; pL = p; }
+    if (a > c && (aR < 0 || a < aR || (a == aR && p > pR))) { aR = a; pR = p; }
+  }
+  /* anchors must agree with each other and be near the line that SyncTeX
+     found */
+  int l0 = seg_of_point(r->lines, r->nlines, ox, oy, slack);
+  #define GLINE(p) ((p) < n ? g[p].line : (n > 0 ? g[n - 1].line : -1))
+  if (aL >= 0 && aR >= 0 && pR < pL) { aL = aR = -1; }
+  if (l0 >= 0 && aL >= 0 && abs(GLINE(pL) - l0) > 2) aL = -1;
+  if (l0 >= 0 && aR >= 0 && abs(GLINE(pR > 0 ? pR - 1 : 0) - l0) > 2) aR = -1;
+  /* the part of the source and of the stream to align: with one anchor,
+     the stream from (or up to) the line next to it */
+  int s0 = aL >= 0 ? aL : 0, s1 = aR >= 0 ? aR : srclen;
+  int q0, q1;
+  if (aL >= 0) q0 = pL;
+  else if (aR >= 0)
+  {
+    int lr = GLINE(pR > 0 ? pR - 1 : 0) - 1;
+    q0 = pR;
+    while (q0 > 0 && g[q0 - 1].line >= lr) q0--;
+  }
+  else q0 = -1;
+  if (aR >= 0) q1 = pR;
+  else if (aL >= 0)
+  {
+    int ll = GLINE(pL) + 1;
+    q1 = pL;
+    while (q1 < n && g[q1].line <= ll) q1++;
+  }
+  else q1 = -1;
+  #undef GLINE
+  if (q0 < 0) q0 = 0;
+  if (q1 > n) q1 = n;
+  if (aL < 0 && aR < 0)
+  {
+    /* no interword records (e.g. a listing, a picture): the line of the
+       point, and the lines before and after it, against the source line */
+    if (l0 < 0) return 0;
+    int li = rc_line_of(r, c);
+    s0 = r->source->offsets[li];
+    s1 = (li + 1 < r->source->nlines) ? r->source->offsets[li + 1] - 1 : srclen;
+    q0 = 0;
+    while (q0 < n && g[q0].line < l0 - 1) q0++;
+    q1 = q0;
+    while (q1 < n && g[q1].line <= l0 + 1) q1++;
+  }
+  *sp = (struct span){s0, s1, q0, q1, aL, pL, aR, pR, ox, oy};
+  if (r->dbg)
+    fprintf(stderr, "[caret] c %d: anchors %d@%d %d@%d, source %d..%d, stream %d..%d\n",
+            c, aL, pL, aR, pR, s0, s1, q0, q1);
+  int span = s1 - s0;
+  if (q1 <= q0 || span <= 0 || span > 2000 || q1 - q0 > 4000)
+    return 0;
+  if (s0 == r->ks0 && s1 == r->ks1 && q0 == r->kq0 && q1 == r->kq1)
+    return 1;    /* the same alignment as before */
+
+  /* longest common subsequence of the characters and the glyphs: text
+     with weight 2, markup (command names, braces, comments) with weight 1,
+     so that it matches only where it is printed (a listing, \verb) */
+  int *order = r->order;
+  int ns = 0;
+  for (int i = s0; i < s1; i++) if (kind[i] != CH_SPACE) order[ns++] = i;
+  int ng = q1 - q0;
+  /* best[i][j]: best score of the first i characters and j glyphs;
+     run[i][j]: the same with character i-1 on glyph j-1. A match scores
+     its weight, and 1 more when it continues a match of the character
+     before it in the source on the glyph before it (text is contiguous). */
+  long cells = (long)(ns + 1) * (ng + 1);
+  if (cells * 2 > r->dpcap)
+  {
+    free(r->dp);
+    r->dp = malloc(sizeof(int) * cells * 2);
+    r->dpcap = r->dp ? cells * 2 : 0;
+    if (!r->dp) return 0;
+  }
+  int *dp = r->dp, *run = dp + cells;
+  #define BEST(i, j) dp[(long)(i) * (ng + 1) + (j)]
+  #define RUN(i, j) run[(long)(i) * (ng + 1) + (j)]
+  enum { NONE = -1000000 };
+  for (int i = 0; i <= ns; i++)
+    for (int j = 0; j <= ng; j++)
+    {
+      if (i == 0 || j == 0) { BEST(i, j) = 0; RUN(i, j) = NONE; continue; }
+      int w = kind[order[i - 1]] == CH_CAND ? 2 : 1;
+      int rr = NONE;
+      if (match_ok(r->ctx, &r->glyphs[g[q0 + j - 1].index], src[order[i - 1]], w))
+      {
+        rr = BEST(i - 1, j - 1) + w;
+        if (i > 1 && order[i - 2] == order[i - 1] - 1 && RUN(i - 1, j - 1) > NONE &&
+            RUN(i - 1, j - 1) + w + 1 > rr)
+          rr = RUN(i - 1, j - 1) + w + 1;
+      }
+      RUN(i, j) = rr;
+      int b = BEST(i - 1, j) > BEST(i, j - 1) ? BEST(i - 1, j) : BEST(i, j - 1);
+      BEST(i, j) = rr > b ? rr : b;
+    }
+  int *match = r->match;
+  for (int i = 0; i < srclen; i++) match[i] = -1;
+  {
+    int i = ns, j = ng, in_run = 0;
+    while (i > 0 && j > 0)
+    {
+      if (!in_run)
+      {
+        if (BEST(i, j) == BEST(i - 1, j)) { i--; continue; }
+        if (BEST(i, j) == BEST(i, j - 1)) { j--; continue; }
+        in_run = 1;    /* BEST(i, j) == RUN(i, j) */
+      }
+      /* character i-1 on glyph j-1 */
+      match[order[i - 1]] = q0 + j - 1;
+      int w = kind[order[i - 1]] == CH_CAND ? 2 : 1;
+      in_run = (i > 1 && order[i - 2] == order[i - 1] - 1 && RUN(i - 1, j - 1) > NONE &&
+                RUN(i, j) == RUN(i - 1, j - 1) + w + 1);
+      i--; j--;
+    }
+  }
+  #undef BEST
+  #undef RUN
+  /* the anchors themselves: the word start is at the anchor's glyph */
+  if (aR >= 0 && pR < n && match[aR] < 0 && kind[aR] == CH_CAND) match[aR] = pR;
+  r->ks0 = s0; r->ks1 = s1; r->kq0 = q0; r->kq1 = q1;
+  if (r->dbg)
+    for (int i = s0; i < s1; i++)
+      if (match[i] >= 0)
+        fprintf(stderr, "   src %d '%c' -> glyph %d line %d x %d\n", i,
+                src[i] < 128 ? src[i] : '?', match[i], g[match[i]].line, g[match[i]].x0);
+  return 1;
+}
+
+static int is_struct_char(int ch)
+{
+  return ch == '$' || ch == '{' || ch == '}' || ch == '^' || ch == '_' || ch == '&';
+}
+
+struct tok { int s, e; };
+
+/* commands that print nothing of their own */
+static int is_silent_cmd(const int *s, int len)
+{
+  static const char *names[] = {
+    "begin", "end", "label", "usepackage", "RequirePackage", "documentclass",
+    "newcommand", "renewcommand", "providecommand", "newenvironment",
+    "renewenvironment", "setlength", "addtolength", "color", "pagestyle",
+    "thispagestyle", "bibliographystyle", "addbibresource", "vspace", "hspace",
+    "setcounter", "addtocounter", "centering", "raggedright", "raggedleft",
+    "noindent", "indent", "par", "newline", "linebreak", "pagebreak", "newpage",
+    "clearpage", "smallskip", "medskip", "bigskip", "quad", "qquad", "displaystyle",
+    "textstyle", "scriptstyle", "limits", "nolimits", "nonumber", "notag",
+    "small", "large", "Large", "LARGE", "huge", "Huge", "footnotesize", "tiny",
+    "scriptsize", "normalsize", "bfseries", "itshape", "ttfamily", "rmfamily",
+    "sffamily", "mdseries", "upshape", "slshape", "scshape", "em", "protect",
+    "relax", "ignorespaces", "unskip", "allowbreak", "nobreak", "hfill", "vfill",
+    "hfil", "vfil", "strut", "phantom", "hphantom", "vphantom", "textbf",
+    "textit", "texttt", "textrm", "textsf", "textsc", "emph", "underline",
+    "mathrm", "mathbf", "mathit", "mathsf", "mathtt", "mathcal", "mathbb",
+    "text", "mbox", "makebox", "fbox", "left", "right", "big", "Big", "bigg", "Bigg",
+    "caption", "section", "subsection", "subsubsection", "paragraph", NULL };
+  for (int k = 0; names[k]; k++)
+  {
+    int l = (int)strlen(names[k]);
+    if (l != len) continue;
+    int i = 0;
+    while (i < l && s[i] == (unsigned char)names[k][i]) i++;
+    if (i == l) return 1;
+  }
+  return 0;
+}
+
+/* the length of the command name of the token src[i..j) */
+static int k_end_name(const int *s, int i, int j)
+{
+  int k = i + 1;
+  while (k < j && is_letter_cp(s[k])) k++;
+  return k - i - 1;
+}
+
+/* The parts of src[a..b) that may print something of their own: command
+   names (with the name argument of \ref, \includegraphics ...) and other
+   characters; not spaces, comments, braces, $, ^, _ */
+static int rc_tokens(const struct rc *r, int a, int b, struct tok *t, int max)
+{
+  const int *s = r->src;
+  int n = 0, i = a;
+  while (i < b && n < max)
+  {
+    int k = r->kind[i], ch = s[i];
+    if (k == CH_SPACE || k == CH_COMMENT || ch == '\n' || is_struct_char(ch)) { i++; continue; }
+    if (ch == '\\' && i + 1 < b)
+    {
+      int d = s[i + 1];
+      if (is_letter_cp(d))
+      {
+        int j = i + 1;
+        while (j < b && is_letter_cp(s[j])) j++;
+        if (is_markup_arg_cmd(s + i + 1, j - i - 1))
+        {
+          int m = j;
+          while (m < b && (s[m] == ' ' || s[m] == '*')) m++;
+          if (m < b && s[m] == '[')
+          {
+            while (m < b && s[m] != ']' && s[m] != '\n') m++;
+            if (m < b && s[m] == ']') m++;
+          }
+          if (m < b && s[m] == '{')
+          {
+            int depth = 0;
+            while (m < b)
+            {
+              if (s[m] == '{') depth++;
+              else if (s[m] == '}' && --depth == 0) { m++; break; }
+              else if (s[m] == '\n') break;
+              m++;
+            }
+            j = m;
+          }
+        }
+        if (!is_silent_cmd(s + i + 1, k_end_name(s, i, j)))
+          t[n++] = (struct tok){i, j};
+        i = j;
+        continue;
+      }
+      /* \( \) \[ \] \, \; \! \\ \  and the like print nothing */
+      if (d < 128 && strchr("()[],;:!> \\/", d)) { i += 2; continue; }
+      t[n++] = (struct tok){i, i + 2};
+      i += 2;
+      continue;
+    }
+    t[n++] = (struct tok){i, i + 1};
+    i++;
+  }
+  return n;
+}
+
+/* the box of glyphs h0..h1 (stream indices) that are on the line of h0
+   (or of h1 with from_end); *line: that line */
+static void rc_glyph_box(const struct rc *r, int h0, int h1, int from_end,
+                         synctex_box *b, int *line)
+{
+  int l = r->g[from_end ? h1 : h0].line, first = 1;
+  for (int j = h0; j <= h1; j++)
+  {
+    if (r->g[j].line != l) continue;
+    const synctex_glyph *q = &r->glyphs[r->g[j].index];
+    int y0 = q->y0, y1 = q->y1;
+    if (q->font || y1 <= y0) { y0 = segs[l].y - segs[l].h; y1 = segs[l].y + segs[l].d; }
+    if (first) { *b = (synctex_box){q->x0, y0, q->x1, y1}; first = 0; continue; }
+    if (q->x0 < b->x0) b->x0 = q->x0;
+    if (q->x1 > b->x1) b->x1 = q->x1;
+    if (y0 < b->y0) b->y0 = y0;
+    if (y1 > b->y1) b->y1 = y1;
+  }
+  *line = l;
+}
+
+/* a group: source src[s..e) on glyphs h0..h1 (stream indices) */
+struct grp { int s, e, h0, h1; };
+
+/* c in (or at the end of) a group: the caret at its start (or end), and
+   its box */
+static int rc_group_caret(struct rc *r, int c, const struct grp *G, int ngr,
+                          int *gx, int *gl, synctex_box *box, int *has_box)
+{
+  for (int pass = 0; pass < 2; pass++)
+    for (int k = 0; k < ngr; k++)
+      if (pass == 0 ? (c >= G[k].s && c < G[k].e) : c == G[k].e)
+      {
+        rc_glyph_box(r, G[k].h0, G[k].h1, pass, box, gl);
+        *gx = pass == 0 ? box->x0 : box->x1;
+        *has_box = 1;
+        return 1;
+      }
+  return 0;
+}
+
+/* the caret of character c with the alignment of sp */
+static int rc_place(struct rc *r, int c, const struct span *sp,
+                    int *x, int *y, int *h, int *d, synctex_box *box, int *has_box)
+{
+  const unsigned char *kind = r->kind;
+  const struct sglyph *g = r->g;
+  const int *match = r->match;
+  int s0 = sp->s0, s1 = sp->s1, n = r->n, srclen = r->srclen;
+  int gx, gl;
+  *has_box = 0;
+  if (c < s0 || c > s1) return 0;
+  if (c < srclen && match[c] >= 0)
+  { gx = g[match[c]].x0; gl = g[match[c]].line; goto done; }
+  /* between the nearest characters with a glyph */
+  int b = c - 1, f = c + 1;
+  while (b >= s0 && match[b] < 0) b--;
+  while (f < s1 && match[f] < 0) f++;
+  if (f >= s1 && sp->aR >= 0 && sp->pR < n) f = -2;      /* the right anchor */
+  int gb = (b >= s0) ? match[b] : (sp->aL >= 0 ? sp->pL - 1 : -1);
+  int gf = (f >= 0 && f < s1) ? match[f] : (f == -2 ? sp->pR : -1);
+  if (gb < 0 && gf < 0)
+  {
+    /* nothing of the source near c has a glyph (e.g. \includegraphics alone
+       on its line): the parts of the source line take the glyphs at the
+       point of SyncTeX, one each */
+    int li = rc_line_of(r, c);
+    int a = r->source->offsets[li];
+    int z = (li + 1 < r->source->nlines) ? r->source->offsets[li + 1] - 1 : srclen;
+    struct tok t[64];
+    struct grp G[64];
+    int nt = rc_tokens(r, a, z, t, 64);
+    int l0 = seg_of_point(r->lines, r->nlines, sp->ox, sp->oy, r->slack);
+    if (r->dbg)
+      fprintf(stderr, "   no glyphs near: %d parts, point %d %d, line %d\n", nt, sp->ox, sp->oy, l0);
+    if (nt <= 0 || l0 < 0) return 0;
+    int h = sp->q0;
+    while (h < sp->q1 && (g[h].line != l0 || g[h].x1 <= sp->ox + r->slack / 2)) h++;
+    int m = 0;
+    while (m < nt && h + m < sp->q1 && g[h + m].line == l0) m++;
+    if (m == 0) return 0;
+    for (int k = 0; k < m; k++) G[k] = (struct grp){t[k].s, t[k].e, h + k, h + k};
+    if (rc_group_caret(r, c, G, m, &gx, &gl, box, has_box))
+      goto done;
+    if (c < G[0].s) { gx = g[h].x0; gl = g[h].line; goto done; }
+    if (c >= G[m - 1].e) { gx = g[h + m - 1].x1; gl = g[h + m - 1].line; goto done; }
+    for (int k = 0; k + 1 < m; k++)
+      if (c >= G[k].e && c < G[k + 1].s)
+      { gx = g[G[k + 1].h0].x0; gl = g[G[k + 1].h0].line; goto done; }
+    return 0;
+  }
+  int lo = b >= s0 ? b + 1 : s0, hi = (f >= 0 && f < s1) ? f : s1;
+  int space_before = 0;
+  for (int i = lo; i < c; i++) if (kind[i] == CH_SPACE) space_before = 1;
+  if (gb >= 0 && gf >= 0 && gf - gb - 1 > 0)
+  {
+    /* glyphs between them that no source character took: the groups */
+    struct tok t[64];
+    struct grp G[64];
+    int nt = rc_tokens(r, lo, hi, t, 64), nf = gf - gb - 1;
+    if (r->dbg)
+      fprintf(stderr, "   gap %d..%d glyphs %d..%d: %d parts, %d glyphs\n", lo, hi, gb, gf, nt, nf);
+    if (nt > 0)
+    {
+      /* one glyph for each part (\alpha\beta): a group each; else one group */
+      int split = nt == nf, ngr = split ? nt : 1;
+      for (int k = 0; k < ngr; k++)
+        G[k] = split ? (struct grp){t[k].s, t[k].e, gb + 1 + k, gb + 1 + k}
+                         : (struct grp){t[0].s, t[nt - 1].e, gb + 1, gf - 1};
+      if (rc_group_caret(r, c, G, ngr, &gx, &gl, box, has_box))
+        goto done;
+      if (c < G[0].s)
+      {
+        if (!space_before) { gx = g[gb].x1; gl = g[gb].line; }
+        else { gx = g[G[0].h0].x0; gl = g[G[0].h0].line; }
+        goto done;
+      }
+      if (c > G[ngr - 1].e)
+      {
+        int sp_after = 0;
+        for (int i = G[ngr - 1].e; i < c; i++) if (kind[i] == CH_SPACE) sp_after = 1;
+        if (sp_after) { gx = g[gf].x0; gl = g[gf].line; }
+        else { gx = g[G[ngr - 1].h1].x1; gl = g[G[ngr - 1].h1].line; }
+        goto done;
+      }
+      /* between two parts: at the start of the next one */
+      for (int k = 0; k + 1 < ngr; k++)
+        if (c > G[k].e && c < G[k + 1].s)
+        { gx = g[G[k + 1].h0].x0; gl = g[G[k + 1].h0].line; goto done; }
+    }
+  }
+  if (gb >= 0 && (!space_before || gf < 0 || (c < srclen && kind[c] == CH_SPACE)))
+  { gx = g[gb].x1; gl = g[gb].line; }
+  else
+  { gx = g[gf].x0; gl = g[gf].line; }
+done:
+  *x = gx;
+  *y = segs[gl].y;
+  *h = segs[gl].h;
+  *d = segs[gl].d;
+  if (*has_box && box->y1 - box->y0 > *h + *d)
+  {
+    /* a picture: the caret as high as it */
+    *y = box->y1;
+    *h = box->y1 - box->y0;
+    *d = 0;
+    *has_box = 2;
+  }
+  return 1;
+}
+
+/* the caret of line, col (from first_line of the source window); x, y: in
+   the point that SyncTeX found, out the caret */
+static int rc_locate(struct rc *r, int line, int col, int *x, int *y, int *h, int *d,
+                     synctex_box *box, int *has_box)
+{
+  *has_box = 0;
+  int li = line - r->source->first_line;
+  if (li < 0 || li >= r->source->nlines || col < 0)
+    return 0;
+  int line_end = (li + 1 < r->source->nlines) ? r->source->offsets[li + 1] - 1 : r->srclen;
+  int c = r->source->offsets[li] + col;
+  if (c > line_end) c = line_end;
+  struct span sp;
+  if (!rc_align(r, c, *x, *y, &sp))
+    return 0;
+  return rc_place(r, c, &sp, x, y, h, d, box, has_box);
+}
+
+/* The point of SyncTeX for line, col: interpolated between the records of
+   the line. *in_text = 0: nothing of the line is in a line of text (e.g.
+   \begin{env}), the point is where the next text starts. */
+static int fwd_point(const struct fwd_env *pe, int *x, int *y, int *h, int *d, int *in_text);
+
+static int fwd_interp(fz_context *ctx, synctex_t *stx, fz_buffer *buf, int page,
+                      int tag, int line, int col, int *x, int *y, int *h, int *d,
+                      int *in_text)
+{
+  struct fwd_env e = {.tag = tag, .line = line, .c = col};
+  walk_page(ctx, stx, buf, page, fwd_fn, &e);
+  return fwd_point(&e, x, y, h, d, in_text);
+}
+
+/* The records of one line of a page, walked once: then the point of any
+   column (fwd_from), as fwd_interp, without walking the page again. */
+struct fwd_line {
+  struct fwd_env base;      /* walked with no column: f, rprev, next, nprev */
+  struct walk_item *recs;   /* the records of the line with a column, in order */
+  int n, cap;
+};
+
+static void fwd_line_fn(void *penv, const struct walk_item *it)
+{
+  struct fwd_line *fl = penv;
+  fwd_fn(&fl->base, it);
+  if (it->r.kind == STEX_ENTER_H || it->r.kind == STEX_ENTER_V)
+    return;
+  if (it->r.link.tag != fl->base.tag || it->r.link.line != fl->base.line ||
+      it->r.link.column < 0)
+    return;
+  if (fl->n == fl->cap)
+  {
+    int cap = fl->cap ? fl->cap * 2 : 64;
+    struct walk_item *r = realloc(fl->recs, sizeof(*r) * cap);
+    if (!r) return;
+    fl->recs = r;
+    fl->cap = cap;
+  }
+  fl->recs[fl->n++] = *it;
+}
+
+static void fwd_line_walk(fz_context *ctx, synctex_t *stx, fz_buffer *buf, int page,
+                          int tag, int line, struct fwd_line *fl)
+{
+  memset(fl, 0, sizeof(*fl));
+  fl->base.tag = tag;
+  fl->base.line = line;
+  fl->base.c = -1;
+  walk_page(ctx, stx, buf, page, fwd_line_fn, fl);
+}
+
+static int fwd_from(const struct fwd_line *fl, int col, int *x, int *y, int *h, int *d,
+                    int *in_text)
+{
+  struct fwd_env e = fl->base;
+  e.c = col;
+  for (int i = 0; i < fl->n; i++)
+  {
+    const struct walk_item *it = &fl->recs[i];
+    int a = it->r.link.column - 1;
+    if (a <= col)
+    {
+      if (!e.has_l || a >= e.l.r.link.column) { e.l = *it; e.has_l = 1; }
+    }
+    else if (!e.has_r || a < e.r.r.link.column) { e.r = *it; e.has_r = 1; }
+  }
+  return fwd_point(&e, x, y, h, d, in_text);
+}
+
+static int fwd_point(const struct fwd_env *pe, int *x, int *y, int *h, int *d, int *in_text)
+{
+  const struct fwd_env *ep = pe;
+  #define e (*ep)
+  *in_text = 1;
+  if ((!e.has_f || !e.f.box) && !e.has_l && !e.has_r)
+  {
+    if (!e.has_next)
+      return 0;
+    *in_text = 0;
+    *x = e.has_nprev ? e.nprev.r.point.x : e.next.bx0;
+    *y = e.next.r.point.y;
+    *h = e.next.bh;
+    *d = e.next.bd;
+    return 1;
+  }
+
+  const struct walk_item *base = e.has_l ? &e.l : (e.has_r ? &e.r : &e.f);
+  int px = base->r.point.x;
+  int cw = estimate_char_width(base->bh);
+
+  if (e.has_l && e.has_r && e.l.box == e.r.box &&
+      e.l.r.point.y == e.r.r.point.y && e.r.r.point.x > e.l.r.point.x)
+  {
+    int aL = e.l.r.link.column, aR = e.r.r.link.column;
+    int sw = space_width(&e.l);
+    int x0 = e.l.r.point.x + sw, a0 = aL + (sw > 0 ? 1 : 0);
+    if (x0 >= e.r.r.point.x || a0 >= aR) { x0 = e.l.r.point.x; a0 = aL; }
+    if (e.c < a0)
+      px = e.l.r.point.x;
+    else
+    {
+      double t = (double)(e.c - a0) / (double)(aR - a0);
+      px = x0 + (int)(t * (e.r.r.point.x - x0));
+    }
+  }
+  else if (e.has_l)
+  {
+    int aL = e.l.r.link.column;
+    px = e.l.r.point.x + (e.c - aL) * cw;
+    if (e.l.box && px > e.l.bx1) px = e.l.bx1;
+  }
+  else if (e.has_r && e.has_rprev && e.rprev.r.point.y == e.r.r.point.y &&
+           e.rprev.r.point.x + space_width(&e.rprev) < e.r.r.point.x)
+  {
+    /* first word of the source line: index 0 starts after the record before */
+    int aR = e.r.r.link.column;
+    int x0 = e.rprev.r.point.x + space_width(&e.rprev);
+    double t = aR > 0 ? (double)e.c / (double)aR : 0;
+    px = x0 + (int)(t * (e.r.r.point.x - x0));
+  }
+  else if (e.has_r)
+  {
+    int aR = e.r.r.link.column;
+    px = e.r.r.point.x - (aR - e.c) * cw;
+    if (e.r.box && px < e.r.bx0) px = e.r.bx0;
+  }
+
+  *x = px;
+  *y = base->r.point.y;
+  *h = base->bh;
+  *d = base->bd;
+  return 1;
+  #undef e
+}
+
+/* rc_locate; for a line with no text of its own (in_text 0, e.g.
+   \begin{figure} or a picture), only a group (the picture) is taken */
+static void rc_refine_point(struct rc *r, int in_text, int line, int col,
+                            int *x, int *y, int *h, int *d, synctex_box *b, int *hb)
+{
+  int tx = *x, ty = *y, th = *h, td = *d;
+  *hb = 0;
+  if (!rc_locate(r, line, col, &tx, &ty, &th, &td, b, hb))
+    return;
+  if (!in_text && !*hb)
+    return;
+  *x = tx; *y = ty; *h = th; *d = td;
+}
+
+/* the source window of line: lines line-2 .. line+2 of the file */
+static int window_of(const synctex_file *f, int line, synctex_source *w)
+{
+  memset(w, 0, sizeof(*w));
+  if (!f || !f->text || line < 1 || line > f->nlines)
+    return 0;
+  int first = line > 2 ? line - 2 : 1, last = line + 2;
+  if (last > f->nlines) last = f->nlines;
+  int start = f->line_off[first - 1];
+  int end = last < f->nlines ? f->line_off[last] - 1 : f->len;
+  w->text = f->text + start;
+  w->len = end - start;
+  w->first_line = first;
+  w->nlines = last - first + 1;
+  for (int k = 0; k < w->nlines; k++)
+    w->offsets[k] = f->line_off[first - 1 + k] - start;
+  return 1;
+}
+
+static void info_add(synctex_caret_info *info, int line, int col, int x, int y, int h, int d,
+                     int hb, const synctex_box *b)
+{
+  if (info->npts >= info->cappts)
+    return;
+  int bi = -1;
+  if (hb)
+  {
+    if (info->nboxes > 0 && !memcmp(&info->boxes[info->nboxes - 1], b, sizeof(*b)))
+      bi = info->nboxes - 1;
+    else if (info->nboxes < info->capboxes)
+    {
+      info->boxes[info->nboxes] = *b;
+      bi = info->nboxes++;
+    }
+  }
+  info->pts[info->npts++] = (synctex_debug_point){line, col, x, y, h, d, bi};
+}
+
+void synctex_caret_map(fz_context *ctx, synctex_t *stx, fz_buffer *buf, int page,
+                       const synctex_glyph *glyphs, int nglyphs, int tag,
+                       const synctex_file *file, const int *lines, int nlines,
+                       synctex_caret_info *info)
+{
+  for (int k = 0; k < nlines && info->npts < info->cappts; k++)
+  {
+    int l = lines[k];
+    synctex_source w;
+    if (!window_of(file, l, &w))
+      continue;
+    struct rc r;
+    int ok = rc_prepare(&r, ctx, stx, buf, page, tag, glyphs, nglyphs, &w);
+    struct fwd_line fl;
+    fwd_line_walk(ctx, stx, buf, page, tag, l, &fl);
+    int len = (l < file->nlines ? file->line_off[l] - 1 : file->len) - file->line_off[l - 1];
+    for (int cc = 0; cc <= len && info->npts < info->cappts; cc++)
+    {
+      int px, py, ph, pd, it;
+      if (!fwd_from(&fl, cc, &px, &py, &ph, &pd, &it))
+        continue;
+      synctex_box b;
+      int hb = 0;
+      if (ok)
+        rc_refine_point(&r, it, l, cc, &px, &py, &ph, &pd, &b, &hb);
+      if (!it && !hb)
+        continue;
+      info_add(info, l, cc, px, py, ph, pd, hb, &b);
+    }
+    free(fl.recs);
+    rc_free(&r);
+  }
+}
+
+int synctex_refine_target(fz_context *ctx, synctex_t *stx, fz_buffer *buf,
+                          int page, const synctex_glyph *glyphs, int nglyphs,
+                          const synctex_file *file,
+                          int *x, int *y, int *h, int *d, synctex_caret_info *info)
+{
+  if (info) { info->has_box = 0; info->element = 0; info->npts = 0; info->nboxes = 0; }
+  if (!stx || stx->last_tag <= 0)
+    return 0;
+  int tag = stx->last_tag, line = stx->last_line, col = stx->target_column;
+  int in_text;
+  if (!fwd_interp(ctx, stx, buf, page, tag, line, col, x, y, h, d, &in_text))
+    return 0;
+  synctex_source w;
+  struct rc r;
+  memset(&r, 0, sizeof(r));
+  int ok = window_of(file, line, &w) &&
+           rc_prepare(&r, ctx, stx, buf, page, tag, glyphs, nglyphs, &w);
+  if (ok && col >= 0)
+  {
+    synctex_box b;
+    int hb = 0;
+    rc_refine_point(&r, in_text, line, col, x, y, h, d, &b, &hb);
+    if (info && hb) { info->has_box = 1; info->box = b; info->element = hb == 2; }
+  }
+  rc_free(&r);
+  if (info && info->debug && info->pts && info->boxes && file)
+  {
+    /* the lines around it, each with its own window (as its own caret) */
+    int lines[5], n = 0;
+    for (int l = line - 2; l <= line + 2; l++)
+      if (l >= 1 && l <= file->nlines) lines[n++] = l;
+    synctex_caret_map(ctx, stx, buf, page, glyphs, nglyphs, tag, file, lines, n, info);
+  }
+  return 1;
+}
+
+static int cmp_int2(const void *a, const void *b)
+{
+  const int *x = a, *y = b;
+  if (x[0] != y[0]) return (x[0] > y[0]) - (x[0] < y[0]);
+  return (x[1] > y[1]) - (x[1] < y[1]);
+}
+
+struct lines_env { int *pairs; int n, max; };
+
+static void lines_fn(void *penv, const struct walk_item *it)
+{
+  struct lines_env *e = penv;
+  if (it->r.link.tag <= 0 || it->r.link.line <= 0 || e->n >= e->max)
+    return;
+  e->pairs[2 * e->n] = it->r.link.tag;
+  e->pairs[2 * e->n + 1] = it->r.link.line;
+  e->n++;
+}
+
+int synctex_page_lines(fz_context *ctx, synctex_t *stx, fz_buffer *buf, int page,
+                       int *pairs, int max)
+{
+  struct lines_env e = {pairs, 0, max};
+  walk_page(ctx, stx, buf, page, lines_fn, &e);
+  qsort(pairs, e.n, sizeof(int) * 2, cmp_int2);
+  int n = 0;
+  for (int i = 0; i < e.n; i++)
+    if (n == 0 || pairs[2 * i] != pairs[2 * (n - 1)] || pairs[2 * i + 1] != pairs[2 * (n - 1) + 1])
+    {
+      pairs[2 * n] = pairs[2 * i];
+      pairs[2 * n + 1] = pairs[2 * i + 1];
+      n++;
+    }
+  return n;
+}
+
+int synctex_input_name(synctex_t *stx, fz_buffer *buf, int tag, const char **name)
+{
+  if (!stx || tag < 1 || tag > (int)stx->input_off.len)
+    return 0;
+  return get_input(buf, stx, tag - 1, name);
+}
+
+/* ---------------- elements (TikZ) ---------------- */
+
+/* the start of line l (from 1) and its length, in characters */
+static int el_line(const synctex_file *f, int l, int *len)
+{
+  if (l < 1 || l > f->nlines) { *len = 0; return -1; }
+  int a = f->line_off[l - 1];
+  int b = l < f->nlines ? f->line_off[l] - 1 : f->len;
+  *len = b - a;
+  return a;
+}
+
+/* the end of the code on a line: before an unescaped % */
+static int el_code_len(const int *s, int len)
+{
+  for (int i = 0; i < len; i++)
+  {
+    if (s[i] == '\\') { i++; continue; }
+    if (s[i] == '%') return i;
+  }
+  return len;
+}
+
+static int el_is_letter(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
+
+/* s[i..] is the word w (a command "\name" or a keyword), not a part of a
+   longer one */
+static int el_word_at(const int *s, int len, int i, const char *w)
+{
+  int n = (int)strlen(w);
+  if (i + n > len) return 0;
+  for (int k = 0; k < n; k++) if (s[i + k] != (unsigned char)w[k]) return 0;
+  if (i + n < len && el_is_letter(s[i + n])) return 0;
+  if (w[0] != '\\' && i > 0 && (el_is_letter(s[i - 1]) || s[i - 1] == '\\')) return 0;
+  return 1;
+}
+
+/* the column of the k-th (from 1) of the words on line l, -1 if none */
+static int el_find(const synctex_file *f, int l, const char *const *words, int k)
+{
+  int len, a = el_line(f, l, &len);
+  if (a < 0) return -1;
+  const int *s = f->text + a;
+  len = el_code_len(s, len);
+  int seen = 0;
+  for (int i = 0; i < len; i++)
+    for (int w = 0; words[w]; w++)
+      if (el_word_at(s, len, i, words[w]))
+      {
+        if (++seen == k) return i;
+        i += (int)strlen(words[w]) - 1;
+        break;
+      }
+  return -1;
+}
+
+/* from offset p (at an opening bracket), the offset after its closing one */
+static int el_skip_group(const synctex_file *f, int p, int limit)
+{
+  int depth = 0;
+  for (; p < limit; p++)
+  {
+    int c = f->text[p];
+    if (c == '\\') { p++; continue; }
+    if (c == '%') { while (p < limit && f->text[p] != '\n') p++; continue; }
+    if (c == '{' || c == '[' || c == '(') depth++;
+    else if (c == '}' || c == ']' || c == ')')
+    {
+      if (--depth <= 0) return p + 1;
+    }
+  }
+  return limit;
+}
+
+/* offset -> line (from 1), column */
+static void el_pos(const synctex_file *f, int p, int *l, int *c)
+{
+  int lo = 0, hi = f->nlines - 1;
+  while (lo < hi)
+  {
+    int m = (lo + hi + 1) / 2;
+    if (f->line_off[m] <= p) lo = m; else hi = m - 1;
+  }
+  *l = lo + 1;
+  *c = p - f->line_off[lo];
+}
+
+static const char *const el_path_cmds[] = {
+  "\\draw", "\\path", "\\fill", "\\filldraw", "\\shade", "\\shadedraw", "\\clip",
+  "\\node", "\\coordinate", "\\pic", "\\matrix", "\\graph", "\\useasboundingbox",
+  "\\datavisualization", "\\tikz", NULL };
+static const char *const el_node_words[] = { "\\node", "node", NULL };
+static const char *const el_to_words[] = { "to", NULL };
+static const char *const el_pic_begin[] = {
+  "\\begin{tikzpicture}", "\\begin{circuitikz}", "\\tikz", NULL };
+static const char *const el_scope_begin[] = { "\\begin{scope}", "\\scope", NULL };
+
+/* An element drawn by a macro, not by TikZ code in the file: the code of the
+   line that calls it. If that line ends an environment that collects its
+   body (e.g. a circuit of the template, drawn at \end{circuit}), the whole
+   environment, from its \begin. r->whole = 1. */
+static int el_macro_range(const synctex_file *f, int line, synctex_range *r)
+{
+  int len, a = el_line(f, line, &len);
+  if (a < 0) return 0;
+  const int *s = f->text + a;
+  int code = el_code_len(s, len), col = 0;
+  while (col < code && (s[col] == ' ' || s[col] == '\t')) col++;
+  r->l0 = r->l1 = line;
+  r->c0 = col;
+  r->c1 = code;
+  r->whole = 1;
+  /* \end{name} on the line: back to \begin{name} */
+  static const char end_word[] = "\\end{";
+  for (int i = col; i + 5 < code; i++)
+  {
+    int k = 0;
+    while (end_word[k] && s[i + k] == (unsigned char)end_word[k]) k++;
+    if (end_word[k]) continue;
+    int n0 = i + 5, n1 = n0;
+    while (n1 < code && s[n1] != '}') n1++;
+    if (n1 >= code) break;
+    /* "\begin{name}" as characters */
+    int want[80], wn = 0;
+    const char *b = "\\begin{";
+    while (*b && wn < 70) want[wn++] = *b++;
+    for (int q = n0; q <= n1 && wn < 79; q++) want[wn++] = s[q];
+    int depth = 0;
+    for (int l = line; l >= 1 && l > line - 2000; l--)
+    {
+      int ll, la = el_line(f, l, &ll);
+      const int *t = f->text + la;
+      int lc = el_code_len(t, ll);
+      for (int c = (l == line ? i : lc) - wn; c >= 0; c--)
+      {
+        int m = 0;
+        while (m < wn && t[c + m] == want[m]) m++;
+        if (m < wn) continue;
+        if (depth-- > 0) continue;
+        r->l0 = l;
+        r->c0 = c;
+        r->c1 = n1 + 1;
+        return 1;
+      }
+    }
+    break;
+  }
+  return 1;
+}
+
+int synctex_element_range(const synctex_file *f, const synctex_element *e, synctex_range *r)
+{
+  memset(r, 0, sizeof(*r));
+  if (!f || !f->text || e->line < 1 || e->line > f->nlines)
+    return 0;
+  int col = -1, l = e->line, start, end;
+  switch (e->kind)
+  {
+    case 'p': case 'n': case 't':
+    {
+      const char *const *words = e->kind == 'p' ? el_path_cmds :
+                                 e->kind == 'n' ? el_node_words : el_to_words;
+      col = el_find(f, l, words, e->index > 0 ? e->index : 1);
+      if (col < 0 && e->kind == 'p' && l > 1)
+      {
+        /* TeX may read the line after the command first (options) */
+        col = el_find(f, l - 1, words, 1);
+        if (col >= 0) l--;
+      }
+      if (col < 0)
+        return el_macro_range(f, e->line, r);
+      int len, a = el_line(f, l, &len);
+      start = a + col;
+      int last = e->end_line > l ? e->end_line + 1 : l + 2;
+      int la, limit = el_line(f, last <= f->nlines ? last : f->nlines, &la);
+      limit = last <= f->nlines ? limit + la : f->len;
+      int p = start + 1;
+      while (p < limit && f->text[p] != '\\' && el_is_letter(f->text[p])) p++;
+      if (e->kind == 't')
+      {
+        /* to[...] */
+        while (p < limit && f->text[p] == ' ') p++;
+        end = (p < limit && f->text[p] == '[') ? el_skip_group(f, p, limit) : p;
+      }
+      else if (e->kind == 'n')
+      {
+        /* node [...] (name) at (...) {text} */
+        end = p;
+        for (;;)
+        {
+          while (p < limit && (f->text[p] == ' ' || f->text[p] == '\n' || f->text[p] == '\t')) p++;
+          if (p >= limit) break;
+          int c = f->text[p];
+          if (c == '[' || c == '(') { p = el_skip_group(f, p, limit); end = p; continue; }
+          if (c == 'a' && p + 1 < limit && f->text[p + 1] == 't') { p += 2; continue; }
+          if (c == '{') end = el_skip_group(f, p, limit);
+          break;
+        }
+      }
+      else
+      {
+        /* the path: up to ; */
+        end = limit;
+        int depth = 0;
+        for (; p < limit; p++)
+        {
+          int c = f->text[p];
+          if (c == '\\') { p++; continue; }
+          if (c == '%') { while (p < limit && f->text[p] != '\n') p++; continue; }
+          if (c == '{' || c == '[' || c == '(') depth++;
+          else if (c == '}' || c == ']' || c == ')') depth--;
+          else if (c == ';' && depth <= 0) { end = p + 1; break; }
+        }
+      }
+      break;
+    }
+    case 'P': case 's':
+    {
+      const char *const *words = e->kind == 'P' ? el_pic_begin : el_scope_begin;
+      for (int k = 0; k < 4 && col < 0 && l - k >= 1; k++)
+        if ((col = el_find(f, l - k, words, 1)) >= 0) l -= k;
+      if (col < 0) return 0;
+      int len, a = el_line(f, l, &len);
+      start = a + col;
+      int el = e->end_line >= l ? e->end_line : l;
+      a = el_line(f, el, &len);
+      end = a + el_code_len(f->text + a, len);
+      break;
+    }
+    default:
+      return 0;
+  }
+  el_pos(f, start, &r->l0, &r->c0);
+  el_pos(f, end, &r->l1, &r->c1);
+  return 1;
+}
+
+static int el_same_file(const char *a, const char *b)
+{
+  while (a[0] == '.' && a[1] == '/') a += 2;
+  while (b[0] == '.' && b[1] == '/') b += 2;
+  return strcmp(a, b) == 0;
+}
+
+static int el_before(int l0, int c0, int l1, int c1)
+{
+  return l0 < l1 || (l0 == l1 && c0 <= c1);
+}
+
+int synctex_element_caret(const synctex_file *f, const char *path, const char *main_file,
+                          int line, int col, const synctex_element *els, int nels,
+                          int *x, int *y, int *h, int *d, synctex_caret_info *info)
+{
+  int best = -1;
+  long best_size = 0;
+  for (int i = 0; i < nels; i++)
+  {
+    const synctex_element *e = &els[i];
+    if (!e->has_box || !el_same_file(e->file[0] ? e->file : main_file, path))
+      continue;
+    synctex_range r;
+    if (!synctex_element_range(f, e, &r))
+      continue;
+    if (!el_before(r.l0, r.c0, line, col) || !el_before(line, col, r.l1, r.c1))
+      continue;
+    long size = (long)(f->line_off[r.l1 - 1] + r.c1) - (f->line_off[r.l0 - 1] + r.c0);
+    if (best < 0 || size < best_size || (size == best_size && e->depth > els[best].depth))
+    {
+      best = i;
+      best_size = size;
+    }
+  }
+  if (best < 0)
+    return 0;
+  /* the parts of the same element (e.g. a circuitikz part and its label);
+     for an element drawn by a macro, all that the macro draws */
+  const synctex_element *b = &els[best];
+  synctex_box box = {b->x0, b->y0, b->x1, b->y1};
+  synctex_range rb;
+  synctex_element_range(f, b, &rb);
+  for (int i = 0; i < nels; i++)
+  {
+    const synctex_element *e = &els[i];
+    if (!e->has_box || strcmp(e->file, b->file) != 0)
+      continue;
+    if (rb.whole)
+    {
+      synctex_range re;
+      if (!synctex_element_range(f, e, &re) || !re.whole || re.l0 != rb.l0 || re.c0 != rb.c0 ||
+          re.l1 != rb.l1)
+        continue;
+    }
+    else if (e->kind != b->kind || e->line != b->line || e->index != b->index)
+      continue;
+    if (e->x0 < box.x0) box.x0 = e->x0;
+    if (e->y0 < box.y0) box.y0 = e->y0;
+    if (e->x1 > box.x1) box.x1 = e->x1;
+    if (e->y1 > box.y1) box.y1 = e->y1;
+  }
+  /* text in a node keeps its caret (and box) when it is in the node */
+  int slack = 2 * 65536;
+  if ((b->kind == 'n' || b->kind == 't') && !rb.whole &&
+      *x >= box.x0 - slack && *x <= box.x1 + slack &&
+      *y >= box.y0 - slack && *y <= box.y1 + slack + *d)
+    return 1;
+  *x = box.x0;
+  *y = box.y1;
+  *h = box.y1 - box.y0;
+  *d = 0;
+  if (info) { info->has_box = 1; info->box = box; info->element = 1; }
+  return 1;
+}
+
+int synctex_element_at(const synctex_element *els, int nels, int x, int y)
+{
+  int best = -1;
+  double best_area = 0;
+  for (int i = 0; i < nels; i++)
+  {
+    const synctex_element *e = &els[i];
+    if (!e->has_box || x < e->x0 || x > e->x1 || y < e->y0 || y > e->y1)
+      continue;
+    double area = (double)(e->x1 - e->x0) * (double)(e->y1 - e->y0);
+    if (best < 0 || area < best_area || (area == best_area && e->depth > els[best].depth))
+    {
+      best = i;
+      best_area = area;
+    }
+  }
+  return best;
+}
+
+/* ---------------- backward ---------------- */
+
+struct box_env {
+  int x, y;
+  int best, best_area_ok;
+  double best_area;
+};
+
+static void box_fn(void *penv, const struct walk_item *it)
+{
+  struct box_env *e = penv;
+  if (it->r.kind != STEX_ENTER_H)
+    return;
+  int y0 = it->r.point.y - it->bh, y1 = it->r.point.y + it->bd;
+  if (e->y < y0 || e->y > y1 || e->x < it->bx0 || e->x > it->bx1)
+    return;
+  double area = (double)(it->bx1 - it->bx0) * (double)(y1 - y0);
+  if (!e->best_area_ok || area <= e->best_area)
+  {
+    e->best = it->box;
+    e->best_area = area;
+    e->best_area_ok = 1;
+  }
+}
+
+struct back_env {
+  int box, x;
+  int has_l, has_r;
+  struct walk_item l, r;
+};
+
+static void back_fn(void *penv, const struct walk_item *it)
+{
+  struct back_env *e = penv;
+  if (it->r.kind == STEX_ENTER_H || it->r.kind == STEX_ENTER_V)
+    return;
+  if (it->box != e->box || it->r.link.tag <= 0 || it->r.link.line <= 0)
+    return;
+  int px = it->r.point.x;
+  if (px <= e->x)
+  {
+    if (!e->has_l || px >= e->l.r.point.x)
+    {
+      e->l = *it;
+      e->has_l = 1;
+    }
+  }
+  else
+  {
+    if (!e->has_r || px < e->r.r.point.x)
+    {
+      e->r = *it;
+      e->has_r = 1;
+    }
+  }
+}
+
+int synctex_scan_column(fz_context *ctx, synctex_t *stx, fz_buffer *buf,
+                        const char *doc_dir, unsigned page, int x, int y)
+{
+  if (!stx || synctex_page_count(stx) <= page)
+    return 0;
+
+  struct box_env be = {.x = x, .y = y};
+  walk_page(ctx, stx, buf, page, box_fn, &be);
+  if (!be.best_area_ok)
+    return 0;
+
+  struct back_env e = {.box = be.best, .x = x};
+  walk_page(ctx, stx, buf, page, back_fn, &e);
+  if (!e.has_l && !e.has_r)
+    return 0;
+
+  /* The record left of the click is the space before the clicked word. If
+     the record right of it has another source line, the space was the end
+     of a source line, and the clicked word starts the next one. */
+  int start_x = -1;
+  if (e.has_l && e.has_r &&
+      (e.l.r.link.tag != e.r.r.link.tag || e.l.r.link.line != e.r.r.link.line))
+  {
+    start_x = e.l.r.point.x + space_width(&e.l);
+    e.has_l = 0;
+  }
+
+  const struct walk_item *a = e.has_l ? &e.l : &e.r;
+  int tag = a->r.link.tag, line = a->r.link.line, col = -1;
+  int cw = estimate_char_width(a->bh);
+
+  if (e.has_l && e.l.r.link.column > 0)
+  {
+    int aL = e.l.r.link.column;
+    if (e.has_r && e.r.r.link.tag == tag && e.r.r.link.line == line &&
+        e.r.r.link.column > e.l.r.link.column &&
+        e.r.r.point.x > e.l.r.point.x)
+    {
+      int aR = e.r.r.link.column;
+      int sw = space_width(&e.l);
+      int x0 = e.l.r.point.x + sw, a0 = aL + (sw > 0 ? 1 : 0);
+      if (x0 >= e.r.r.point.x || a0 >= aR) { x0 = e.l.r.point.x; a0 = aL; }
+      if (x < x0)
+        col = aL;
+      else
+      {
+        double t = (double)(x - x0) / (double)(e.r.r.point.x - x0);
+        col = a0 + (int)(t * (aR - a0));
+      }
+    }
+    else
+      col = aL + (x - e.l.r.point.x + cw / 2) / cw;
+  }
+  else if (!e.has_l && e.r.r.link.column > 0 &&
+           start_x >= 0 && start_x < e.r.r.point.x)
+  {
+    int aR = e.r.r.link.column;
+    double t = (double)(x - start_x) / (double)(e.r.r.point.x - start_x);
+    col = t <= 0 ? 0 : (int)(t * aR);
+  }
+  else if (!e.has_l && e.r.r.link.column > 0)
+  {
+    int aR = e.r.r.link.column;
+    col = aR - (e.r.r.point.x - x + cw / 2) / cw;
+    if (col < 0) col = 0;
+  }
+
+  const char *fname;
+  int len = get_input(buf, stx, tag - 1, &fname);
+  fprintf(stderr, "[synctex scan] page %d (%d,%d) -> tag %d line %d column %d\n",
+          page, x, y, tag, line, col);
+  editor_synctex(doc_dir, fname, len, line, col);
+  return 1;
+}
