+/* Width of the space that a glue or kern record starts. The word after it
+   starts at x + width. Glue records do not give their width. */
+static int space_width(const struct walk_item *it)
+{
+  (void)it;
+  return 0; /* the record point is already after the space */
+}
+
+/* ---------------- forward ---------------- */
+
+struct fwd_env {
+  int tag, line, c;
+  int has_l, has_r, has_f, has_prev, has_rprev, has_next, has_nprev;
+  struct walk_item l, r, f, prev, rprev, next, nprev;
+};
+
+static void fwd_fn(void *penv, const struct walk_item *it)
+{
+  struct fwd_env *e = penv;
+  if (it->r.kind == STEX_ENTER_H || it->r.kind == STEX_ENTER_V)
+    return;
+  if (it->r.link.tag != e->tag || it->r.link.line != e->line)
+  {
+    /* the first text after the line, for a line that typesets nothing */
+    if (!e->has_next && it->box && it->r.link.tag == e->tag &&
+        it->r.link.line > e->line)
+    {
+      e->next = *it;
+      e->has_next = 1;
+      e->has_nprev = e->has_prev && e->prev.box == it->box &&
+                     e->prev.r.point.y == it->r.point.y;
+      if (e->has_nprev)
+        e->nprev = e->prev;
+    }
+    e->prev = *it;
+    e->has_prev = 1;
+    return;
+  }
+  struct walk_item before = e->prev;
+  int has_before = e->has_prev;
+  e->prev = *it;
+  e->has_prev = 1;
+  if (!e->has_f)
+  {
+    e->f = *it;
+    e->has_f = 1;
+    /* the record before the first record of this line ends the text before
+       the line: index 0 of the line starts there */
+    e->has_rprev = has_before && before.box == it->box &&
+                   before.r.point.y == it->r.point.y;
+    if (e->has_rprev)
+      e->rprev = before;
+  }
+  int col = it->r.link.column;
+  if (col < 0 || e->c < 0)
+    return;
+  int a = col - 1;
+  if (a <= e->c)
+  {
+    /* left anchor: largest index, last one in reading order on a tie */
+    if (!e->has_l || a >= e->l.r.link.column)
+    {
+      e->l = *it;
+      e->has_l = 1;
+    }
+  }
+  else
+  {
+    /* right anchor: smallest index, first one on a tie */
+    if (!e->has_r || a < e->r.r.link.column)
+    {
+      e->r = *it;
+      e->has_r = 1;
+    }
+  }
+}
+
+/* ---------------- forward, with glyphs ----------------
+
+   Between the left and the right SyncTeX record (anchors), the source text
+   is cut into units: a visible character (one glyph), a space, markup that
+   makes no glyph (\textbf{, }, ...), and "unknown" parts (math, \ref{...},
+   other commands) that make some glyphs. The glyphs between the anchors
+   (on one line, or to the end of a line and from the start of the next) are
+   given to the characters before the first unknown part from the left, and
+   to those after the last one from the right; the rest is shared in
+   proportion to the columns. */
+
+enum { U_CHAR, U_SPACE, U_ZERO, U_UNKNOWN };
+struct unit { int c0, c1, kind; };
+
+static int is_letter(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
+
+static int name_in(const char *name, int len, const char *const *list)
+{
+  for (int i = 0; list[i]; i++)
+    if ((int)strlen(list[i]) == len && memcmp(list[i], name, len) == 0)
+      return 1;
+  return 0;
+}
+
+/* markup: the command and its braces make no glyph, the text inside does */
+static const char *const markup_cmds[] = {
+  "textbf", "textit", "textsl", "textsf", "textrm", "texttt", "textup",
+  "textsc", "textmd", "textnormal", "emph", "underline", "mbox", "text",
+  "bfseries", "itshape", "slshape", "sffamily", "rmfamily", "ttfamily",
+  "scshape", "upshape", "mdseries", "normalfont", "em", "bf", "it", "tt",
+  "sf", "rm", "sc", "small", "footnotesize", "scriptsize", "tiny", "large",
+  "Large", "LARGE", "huge", "Huge", "normalsize", "noindent", "par",
+  "label", "index", "hspace", "vspace", "phantom", "relax", NULL
+};
+/* commands whose arguments are not printed as such (one unknown part) */
+static const char *const hidden_arg_cmds[] = {
+  "label", "index", "hspace", "vspace", "phantom", NULL
+};
+
+static int skip_group(const char *s, int n, int i, char open, char close)
+{
+  /* s[i] == open: index after the matching close */
+  int depth = 0;
+  for (; i < n; i++)
+  {
+    if (s[i] == '\\' && i + 1 < n) { i++; continue; }
+    if (s[i] == open) depth++;
+    else if (s[i] == close && --depth == 0) return i + 1;
+  }
+  return n;
+}
+
+static int cut_units(const char *s, int n, struct unit *u, int cap)
+{
+  int k = 0, i = 0;
+#define ADD(a, b, t) do { if (k < cap) { u[k].c0 = (a); u[k].c1 = (b); u[k].kind = (t); k++; } } while (0)
+  while (i < n)
+  {
+    char c = s[i];
+    if (c == '%')
+    {
+      /* a comment, and its line break: no space */
+      int j = i;
+      while (j < n && s[j] != '\n') j++;
+      if (j < n) j++;
+      ADD(i, j, U_ZERO); i = j; continue;
+    }
+    if (c == ' ' || c == '\t' || c == '~' || c == '\n' || c == '\r')
+    { ADD(i, i + 1, U_SPACE); i++; continue; }
+    if (c == '{' || c == '}')
+    { ADD(i, i + 1, U_ZERO); i++; continue; }
+    if (c == '$')
+    {
+      int dbl = (i + 1 < n && s[i + 1] == '$');
+      int j = i + (dbl ? 2 : 1);
+      while (j < n && !(s[j] == '$' && s[j - 1] != '\\')) j++;
+      j += dbl ? 2 : 1;
+      if (j > n) j = n;
+      ADD(i, j, U_UNKNOWN); i = j; continue;
+    }
+    if (c == '\\' && i + 1 < n)
+    {
+      char d = s[i + 1];
+      if (d == '(' || d == '[')
+      {
+        char e = (d == '(') ? ')' : ']';
+        int j = i + 2;
+        while (j + 1 < n && !(s[j] == '\\' && s[j + 1] == e)) j++;
+        j = (j + 1 < n) ? j + 2 : n;
+        ADD(i, j, U_UNKNOWN); i = j; continue;
+      }
+      if (!is_letter(d))
+      {
+        /* \%, \&, \_, \#, \$, \{, \}: one glyph; \\, \,, \ : no glyph */
+        int kind = strchr("%&_#${}", d) ? U_CHAR : (d == ' ' ? U_SPACE : U_ZERO);
+        ADD(i, i + 2, kind); i += 2; continue;
+      }
+      int j = i + 1;
+      while (j < n && is_letter(s[j])) j++;
+      const char *name = s + i + 1;
+      int len = j - (i + 1);
+      if (name_in(name, len, markup_cmds) && !name_in(name, len, hidden_arg_cmds))
+      {
+        while (j < n && s[j] == ' ') j++;   /* the space after a name is eaten */
+        ADD(i, j, U_ZERO); i = j; continue;
+      }
+      /* the command with its [..] and {..} arguments */
+      int hidden = name_in(name, len, hidden_arg_cmds);
+      for (;;)
+      {
+        if (j < n && s[j] == '*') { j++; continue; }
+        if (j < n && s[j] == '[') { j = skip_group(s, n, j, '[', ']'); continue; }
+        if (j < n && s[j] == '{') { j = skip_group(s, n, j, '{', '}'); continue; }
+        break;
+      }
+      ADD(i, j, hidden ? U_ZERO : U_UNKNOWN); i = j; continue;
+    }
+    /* a visible character; -- and --- are one glyph, a UTF-8 sequence too */
+    int j = i + 1;
+    if (c == '-' && j < n && s[j] == '-') { j++; if (j < n && s[j] == '-') j++; }
+    else if ((c == '`' || c == '\'') && j < n && s[j] == c) j++;
+    else if ((unsigned char)c >= 0xC0) while (j < n && ((unsigned char)s[j] & 0xC0) == 0x80) j++;
+    ADD(i, j, U_CHAR); i = j;
+  }
+#undef ADD
+  return k;
+}
+
+/* the lines of the page (hboxes in a vbox) and the interword glue records
+   of the target source line */
+struct line_box { int y, h, d, x0, x1; };
+struct glue_rec { int a, x, y; };
+struct glyph_env {
+  int tag, first_line, nwin;
+  const int *offsets;      /* offset of each source line of the window */
+  struct line_box *lines; int nlines, caplines;
+  struct glue_rec *glues; int nglues, capglues;
+};
+
+static void glyph_walk_fn(void *penv, const struct walk_item *it)
+{
+  struct glyph_env *e = penv;
+  if (it->r.kind == STEX_ENTER_H && it->parent_v && it->r.size.width > 0)
+  {
+    if (e->nlines < e->caplines)
+      e->lines[e->nlines++] = (struct line_box){it->r.point.y, it->r.size.height,
+                                                it->r.size.depth, it->r.point.x,
+                                                it->r.point.x + it->r.size.width};
+  }
+  else if ((it->r.kind == STEX_GLUE || it->r.kind == STEX_KERN) &&
+           it->r.link.tag == e->tag && it->r.link.line >= e->first_line &&
+           it->r.link.line < e->first_line + e->nwin && it->r.link.column >= 0)
+  {
+    /* an interword space: the column is the start of the next word, and so
+       is the point. a: offset in the text of the window. */
+    if (e->nglues < e->capglues)
+      e->glues[e->nglues++] = (struct glue_rec){
+        e->offsets[it->r.link.line - e->first_line] + it->r.link.column,
+        it->r.point.x, it->r.point.y};
+  }
+}
+
+struct sglyph { int x0, x1, line; };
+
+static int cmp_sglyph(const void *a, const void *b)
+{
+  const struct sglyph *ga = a, *gb = b;
+  if (ga->line != gb->line) return (ga->line > gb->line) - (ga->line < gb->line);
+  return (ga->x0 > gb->x0) - (ga->x0 < gb->x0);
+}
+
+static int line_contains(const struct line_box *l, int x, int y, int slack)
+{
+  return x >= l->x0 - slack && x <= l->x1 + slack &&
+         y >= l->y - l->h - slack && y <= l->y + l->d + slack;
+}
+
+static int line_of_point(const struct line_box *lines, int nlines, int x, int y, int slack)
+{
+  int best = -1;
+  double best_area = 0;
+  for (int i = 0; i < nlines; i++)
+    if (line_contains(&lines[i], x, y, slack))
+    {
+      double area = (double)(lines[i].x1 - lines[i].x0) * (double)(lines[i].h + lines[i].d + 1);
+      if (best < 0 || area < best_area) { best = i; best_area = area; }
+    }
+  return best;
+}
+
+/* The caret with glyphs: the glyphs of the page in reading order (line by
+   line), anchored at interword spaces of the source line (glue records whose
+   source character before is a space). Characters after the left anchor
+   take the next glyphs, characters before the right anchor the glyphs before
+   it, across line breaks. Returns 0 if it can't (then the caller keeps the
+   interpolated point). */
+static int refine_with_glyphs(fz_context *ctx, synctex_t *stx, fz_buffer *buf,
+                              int page, int tag, int line, int col,
+                              const synctex_glyph *glyphs, int nglyphs,
+                              const synctex_source *source,
+                              int *x, int *y, int *h, int *d)
+{
+  if (!source || !source->text || !glyphs || nglyphs <= 0 || col < 0)
+    return 0;
+  int li = line - source->first_line;
+  if (li < 0 || li >= source->nlines)
+    return 0;
+  const char *src = source->text;
+  int srclen = source->len;
+  int line_end = (li + 1 < source->nlines) ? source->offsets[li + 1] - 1 : srclen;
+  int c = source->offsets[li] + col;
+  if (c > line_end) c = line_end;
+  enum { MAXL = 1024, MAXR = 1024, MAXU = 1024 };
+  static struct line_box lines[MAXL];
+  static struct glue_rec glues[MAXR];
+  struct glyph_env e = {tag, source->first_line, source->nlines, source->offsets,
+                        lines, 0, MAXL, glues, 0, MAXR};
+  walk_page(ctx, stx, buf, page, glyph_walk_fn, &e);
+  int dbg = getenv("TXP_CARET_DEBUG") != NULL;
+  if (dbg) fprintf(stderr, "[caret] tag %d line %d col %d: %d lines, %d glues, %d glyphs\n",
+                   tag, line, c, e.nlines, e.nglues, nglyphs);
+  if (e.nlines == 0)
+    return 0;
+  int slack = 65536;   /* 1pt in SyncTeX units (sp) */
+
+  /* the glyph stream */
+  struct sglyph *g = malloc(sizeof(*g) * nglyphs);
+  if (!g) return 0;
+  int n = 0;
+  for (int i = 0; i < nglyphs; i++)
+  {
+    int l = line_of_point(lines, e.nlines, (glyphs[i].x0 + glyphs[i].x1) / 2, glyphs[i].y, slack / 4);
+    if (l >= 0)
+      g[n++] = (struct sglyph){glyphs[i].x0, glyphs[i].x1, l};
+  }
+  qsort(g, n, sizeof(g[0]), cmp_sglyph);
+
+  /* anchors: (column of a word start, index of its first glyph) */
+  int aL = -1, pL = -1, aR = -1, pR = -1;
+  for (int k = 0; k < e.nglues; k++)
+  {
+    int a = glues[k].a;
+    if (a <= 0 || a > srclen ||
+        !(src[a - 1] == ' ' || src[a - 1] == '~' || src[a - 1] == '\n'))
+      continue;
+    if (a < srclen && (src[a] == ' ' || src[a] == '~' || src[a] == '\n'))
+      continue;
+    int l = line_of_point(lines, e.nlines, glues[k].x, glues[k].y, slack);
+    if (l < 0) continue;
+    int p = 0;
+    while (p < n && (g[p].line < l || (g[p].line == l && (g[p].x0 + g[p].x1) / 2 < glues[k].x)))
+      p++;
+    /* several records with the same column (e.g. after a group): the last
+       one in reading order is at the word */
+    if (a <= c && (a > aL || (a == aL && p > pL))) { aL = a; pL = p; }
+    if (a > c && (aR < 0 || a < aR || (a == aR && p > pR))) { aR = a; pR = p; }
+  }
+  if (dbg)
+  {
+    fprintf(stderr, "[caret] stream %d glyphs; anchors aL %d pL %d aR %d pR %d\n", n, aL, pL, aR, pR);
+    for (int k = 0; k < e.nglues; k++) fprintf(stderr, "   glue a=%d x=%d y=%d\n", glues[k].a, glues[k].x, glues[k].y);
+  }
+  if (aL >= 0 && aR >= 0 && pR < pL) { free(g); return 0; }
+
+  /* the units of the source between the anchors */
+  static struct unit all[MAXU];
+  int nu_all = cut_units(src, srclen, all, MAXU);
+  int from = aL >= 0 ? aL : 0, to = aR >= 0 ? aR : srclen;
+  int k0 = 0;
+  while (k0 < nu_all && all[k0].c1 <= from) k0++;
+  int k1 = k0;
+  while (k1 < nu_all && all[k1].c0 < to) k1++;
+  struct unit *u = all + k0;
+  int nu = k1 - k0;
+  if (nu <= 0 || (aL < 0 && aR < 0)) { free(g); return 0; }
+
+  int first_unknown = -1, last_unknown = -1, nchars = 0;
+  for (int i = 0; i < nu; i++)
+  {
+    if (u[i].kind == U_UNKNOWN) { if (first_unknown < 0) first_unknown = i; last_unknown = i; }
+    if (u[i].kind == U_CHAR) nchars++;
+  }
+  static int gi[MAXU];
+  for (int i = 0; i < nu; i++) gi[i] = -1;
+  int left = 0, right = 0;
+  /* from the left anchor forward, up to the first unknown part */
+  if (aL >= 0)
+  {
+    int lend = first_unknown < 0 ? nu : first_unknown;
+    for (int i = 0; i < lend; i++) if (u[i].kind == U_CHAR) gi[i] = pL + left++;
+  }
+  /* from the right anchor backward, down to the last unknown part */
+  if (aR >= 0)
+  {
+    int rstart = last_unknown < 0 ? (aL >= 0 ? nu : -1) : last_unknown;
+    for (int i = nu - 1; i > rstart; i--) if (u[i].kind == U_CHAR) gi[i] = pR - 1 - right++;
+    if (aL < 0 && last_unknown < 0)
+      for (int i = nu - 1; i >= 0; i--) if (u[i].kind == U_CHAR && gi[i] < 0) gi[i] = pR - 1 - right++;
+  }
+  int span0 = aL >= 0 ? pL : -1, span1 = aR >= 0 ? pR : -1;
+  int bad = 0;
+  if (span0 >= 0 && span1 >= 0)
+  {
+    /* both sides: the glyphs must be enough, and exactly enough without
+       unknown parts (else a ligature or a hyphen: share in proportion) */
+    if (left + right > span1 - span0) bad = 1;
+    if (first_unknown < 0 && nchars != span1 - span0) bad = 1;
+  }
+  for (int i = 0; i < nu; i++) if (gi[i] >= n || (gi[i] < 0 && gi[i] != -1)) bad = 1;
+  if (bad && (span0 < 0 || span1 < 0)) { free(g); return 0; }
+
+  /* the point of glyph index p (fractional) */
+  #define AT(f) do { double f_ = (f); if (f_ < 0) f_ = 0; \
+      if (n == 0) goto fail; \
+      if (f_ >= n) { gx = g[n - 1].x1; gl = g[n - 1].line; } \
+      else { int i_ = (int)f_; double t_ = f_ - i_; \
+             gx = g[i_].x0 + (int)(t_ * (g[i_].x1 - g[i_].x0)); gl = g[i_].line; } } while (0)
+  int gx = 0, gl = 0;
+  if (bad)
+  {
+    double f = span0 + (double)(c - aL) / (double)(aR - aL) * (span1 - span0);
+    AT(f);
+  }
+  else
+  {
+    int k = 0;
+    while (k < nu && !(c >= u[k].c0 && c < u[k].c1)) k++;
+    if (k == nu)
+    {
+      /* at the right anchor (start of the next word) or the end */
+      if (aR >= 0 && c >= aR) AT(pR);
+      else
+      {
+        int last = -1;
+        for (int i = nu - 1; i >= 0 && last < 0; i--) if (gi[i] >= 0) last = gi[i];
+        if (last < 0) goto fail;
+        gx = g[last].x1; gl = g[last].line;
+      }
+    }
+    else if (u[k].kind == U_CHAR && gi[k] >= 0)
+      AT(gi[k]);
+    else if (u[k].kind == U_SPACE || u[k].kind == U_ZERO)
+    {
+      int before = -1, after = -1;
+      for (int i = k - 1; i >= 0 && before < 0; i--) if (gi[i] >= 0) before = gi[i];
+      for (int i = k + 1; i < nu && after < 0; i++) if (gi[i] >= 0) after = gi[i];
+      if (u[k].kind == U_ZERO && after >= 0 && (k == 0 || u[k - 1].kind != U_CHAR || before < 0))
+        AT(after);
+      else if (before >= 0)
+      { gx = g[before].x1; gl = g[before].line; }
+      else if (after >= 0)
+        AT(after);
+      else if (aR >= 0 && first_unknown < 0)
+        AT(pR);
+      else
+        goto shared;
+    }
+    else
+    {
+    shared:;
+      /* the part with unknown glyphs: the glyphs between what the two sides
+         took, in proportion to the columns */
+      if (first_unknown < 0) goto fail;
+      int g0 = aL >= 0 ? pL + left : -1;
+      int g1 = aR >= 0 ? pR - right : -1;
+      if (g0 < 0 || g1 < 0 || g1 < g0) goto fail;
+      int c0 = u[first_unknown].c0, c1 = u[last_unknown].c1;
+      if (c1 <= c0) c1 = c0 + 1;
+      AT(g0 + (double)(c - c0) / (double)(c1 - c0) * (g1 - g0));
+    }
+  }
+  #undef AT
+  *x = gx;
+  *y = lines[gl].y;
+  *h = lines[gl].h;
+  *d = lines[gl].d;
+  free(g);
+  return 1;
+fail:
+  free(g);
+  return 0;
+}
+
+int synctex_refine_target(fz_context *ctx, synctex_t *stx, fz_buffer *buf,
+                          int page, const synctex_glyph *glyphs, int nglyphs,
+                          const synctex_source *source,
+                          int *x, int *y, int *h, int *d)
+{
+  if (!stx || stx->last_tag <= 0)
+    return 0;
+  struct fwd_env e = {.tag = stx->last_tag, .line = stx->last_line,
+                      .c = stx->target_column};
+  walk_page(ctx, stx, buf, page, fwd_fn, &e);
+  if ((!e.has_f || !e.f.box) && !e.has_l && !e.has_r)
+  {
+    /* nothing of this line is in a line of text (e.g. \begin{env}): show
+       the caret where the next text starts */
+    if (!e.has_next)
+      return 0;
+    *x = e.has_nprev ? e.nprev.r.point.x : e.next.bx0;
+    *y = e.next.r.point.y;
+    *h = e.next.bh;
+    *d = e.next.bd;
+    return 1;
+  }
+
+  const struct walk_item *base = e.has_l ? &e.l : (e.has_r ? &e.r : &e.f);
+  int px = base->r.point.x;
+  int cw = estimate_char_width(base->bh);
+
+  if (e.has_l && e.has_r && e.l.box == e.r.box &&
+      e.l.r.point.y == e.r.r.point.y && e.r.r.point.x > e.l.r.point.x)
+  {
+    int aL = e.l.r.link.column, aR = e.r.r.link.column;
+    int sw = space_width(&e.l);
+    int x0 = e.l.r.point.x + sw, a0 = aL + (sw > 0 ? 1 : 0);
+    if (x0 >= e.r.r.point.x || a0 >= aR) { x0 = e.l.r.point.x; a0 = aL; }
+    if (e.c < a0)
+      px = e.l.r.point.x;
+    else
+    {
+      double t = (double)(e.c - a0) / (double)(aR - a0);
+      px = x0 + (int)(t * (e.r.r.point.x - x0));
+    }
+  }
+  else if (e.has_l)
+  {
+    int aL = e.l.r.link.column;
+    px = e.l.r.point.x + (e.c - aL) * cw;
+    if (e.l.box && px > e.l.bx1) px = e.l.bx1;
+  }
+  else if (e.has_r && e.has_rprev && e.rprev.r.point.y == e.r.r.point.y &&
+           e.rprev.r.point.x + space_width(&e.rprev) < e.r.r.point.x)
+  {
+    /* first word of the source line: index 0 starts after the record before */
+    int aR = e.r.r.link.column;
+    int x0 = e.rprev.r.point.x + space_width(&e.rprev);
+    double t = aR > 0 ? (double)e.c / (double)aR : 0;
+    px = x0 + (int)(t * (e.r.r.point.x - x0));
+  }
+  else if (e.has_r)
+  {
+    int aR = e.r.r.link.column;
+    px = e.r.r.point.x - (aR - e.c) * cw;
+    if (e.r.box && px < e.r.bx0) px = e.r.bx0;
+  }
+
+  *x = px;
+  *y = base->r.point.y;
+  *h = base->bh;
+  *d = base->bd;
+  refine_with_glyphs(ctx, stx, buf, page, e.tag, e.line, e.c, glyphs, nglyphs,
+                     source, x, y, h, d);
+  return 1;
+}
+
+/* ---------------- backward ---------------- */
+
+struct box_env {
+  int x, y;
+  int best, best_area_ok;
+  double best_area;
+};
+
+static void box_fn(void *penv, const struct walk_item *it)
+{
+  struct box_env *e = penv;
+  if (it->r.kind != STEX_ENTER_H)
+    return;
+  int y0 = it->r.point.y - it->bh, y1 = it->r.point.y + it->bd;
+  if (e->y < y0 || e->y > y1 || e->x < it->bx0 || e->x > it->bx1)
+    return;
+  double area = (double)(it->bx1 - it->bx0) * (double)(y1 - y0);
+  if (!e->best_area_ok || area <= e->best_area)
+  {
+    e->best = it->box;
+    e->best_area = area;
+    e->best_area_ok = 1;
+  }
+}
+
+struct back_env {
+  int box, x;
+  int has_l, has_r;
+  struct walk_item l, r;
+};
+
+static void back_fn(void *penv, const struct walk_item *it)
+{
+  struct back_env *e = penv;
+  if (it->r.kind == STEX_ENTER_H || it->r.kind == STEX_ENTER_V)
+    return;
+  if (it->box != e->box || it->r.link.tag <= 0 || it->r.link.line <= 0)
+    return;
+  int px = it->r.point.x;
+  if (px <= e->x)
+  {
+    if (!e->has_l || px >= e->l.r.point.x)
+    {
+      e->l = *it;
+      e->has_l = 1;
+    }
+  }
+  else
+  {
+    if (!e->has_r || px < e->r.r.point.x)
+    {
+      e->r = *it;
+      e->has_r = 1;
+    }
+  }
+}
+
+int synctex_scan_column(fz_context *ctx, synctex_t *stx, fz_buffer *buf,
+                        const char *doc_dir, unsigned page, int x, int y)
+{
+  if (!stx || synctex_page_count(stx) <= page)
+    return 0;
+
+  struct box_env be = {.x = x, .y = y};
+  walk_page(ctx, stx, buf, page, box_fn, &be);
+  if (!be.best_area_ok)
+    return 0;
+
+  struct back_env e = {.box = be.best, .x = x};
+  walk_page(ctx, stx, buf, page, back_fn, &e);
+  if (!e.has_l && !e.has_r)
+    return 0;
+
+  /* The record left of the click is the space before the clicked word. If
+     the record right of it has another source line, the space was the end
+     of a source line, and the clicked word starts the next one. */
+  int start_x = -1;
+  if (e.has_l && e.has_r &&
+      (e.l.r.link.tag != e.r.r.link.tag || e.l.r.link.line != e.r.r.link.line))
+  {
+    start_x = e.l.r.point.x + space_width(&e.l);
+    e.has_l = 0;
+  }
+
+  const struct walk_item *a = e.has_l ? &e.l : &e.r;
+  int tag = a->r.link.tag, line = a->r.link.line, col = -1;
+  int cw = estimate_char_width(a->bh);
+
+  if (e.has_l && e.l.r.link.column > 0)
+  {
+    int aL = e.l.r.link.column;
+    if (e.has_r && e.r.r.link.tag == tag && e.r.r.link.line == line &&
+        e.r.r.link.column > e.l.r.link.column &&
+        e.r.r.point.x > e.l.r.point.x)
+    {
+      int aR = e.r.r.link.column;
+      int sw = space_width(&e.l);
+      int x0 = e.l.r.point.x + sw, a0 = aL + (sw > 0 ? 1 : 0);
+      if (x0 >= e.r.r.point.x || a0 >= aR) { x0 = e.l.r.point.x; a0 = aL; }
+      if (x < x0)
+        col = aL;
+      else
+      {
+        double t = (double)(x - x0) / (double)(e.r.r.point.x - x0);
+        col = a0 + (int)(t * (aR - a0));
+      }
+    }
+    else
+      col = aL + (x - e.l.r.point.x + cw / 2) / cw;
+  }
+  else if (!e.has_l && e.r.r.link.column > 0 &&
+           start_x >= 0 && start_x < e.r.r.point.x)
+  {
+    int aR = e.r.r.link.column;
+    double t = (double)(x - start_x) / (double)(e.r.r.point.x - start_x);
+    col = t <= 0 ? 0 : (int)(t * aR);
+  }
+  else if (!e.has_l && e.r.r.link.column > 0)
+  {
+    int aR = e.r.r.link.column;
+    col = aR - (e.r.r.point.x - x + cw / 2) / cw;
+    if (col < 0) col = 0;
+  }
+
+  const char *fname;
+  int len = get_input(buf, stx, tag - 1, &fname);
+  fprintf(stderr, "[synctex scan] page %d (%d,%d) -> tag %d line %d column %d\n",
+          page, x, y, tag, line, col);
+  editor_synctex(doc_dir, fname, len, line, col);
+  return 1;
+}
diff --git a/src/frontend/synctex.h b/src/frontend/synctex.h
index cfff199..df5423d 100644
--- a/src/frontend/synctex.h
+++ b/src/frontend/synctex.h
@@ -42,6 +42,28 @@ void synctex_scan(fz_context *ctx, synctex_t *stx, fz_buffer *buf, const char *d
 
 int synctex_has_target(synctex_t *stx);
 void synctex_set_target(synctex_t *stx, int current_page, const char *path, int line);
+void synctex_set_target_column(synctex_t *stx, int column);
+/* Refine the last forward match with the column: point of the caret (x, y on
+   the baseline) and height/depth of its line, in SyncTeX units. */
+/* The glyphs of the page (from its display list), in SyncTeX units: left and
+   right edge and baseline. With them and the text of the source line, the
+   caret goes to the glyph of each visible character; without them (NULL),
+   it is interpolated between the SyncTeX records. */
+typedef struct { int x0, x1, y; } synctex_glyph;
+/* Some lines of the source around the target line, joined with '\n':
+   line first_line starts at offsets[0], ... */
+typedef struct {
+  const char *text;
+  int len, first_line, nlines;
