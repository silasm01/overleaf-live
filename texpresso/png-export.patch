+/* ---- Overleaf Live: the caret with glyphs ------------------------------
+   The glyphs of a page (from its display list) and the text of the source
+   line of the last forward search, for synctex_refine_target. */
+
+static char caret_path[1024];
+static int caret_line;
+
+typedef struct {
+  fz_device super;
+  synctex_glyph *g;
+  int n, cap;
+  float inv;   /* 1 / scale factor: points -> SyncTeX units */
+} glyph_device;
+
+static void glyph_fill_text(fz_context *ctx, fz_device *dev_, const fz_text *text,
+                            fz_matrix ctm, fz_colorspace *cs, const float *color,
+                            float alpha, fz_color_params cp)
+{
+  glyph_device *dev = (glyph_device *)dev_;
+  (void)cs; (void)color; (void)alpha; (void)cp;
+  for (fz_text_span *span = text->head; span; span = span->next)
+  {
+    fz_matrix trm = span->trm;
+    trm.e = 0;
+    trm.f = 0;
+    for (int i = 0; i < span->len; i++)
+    {
+      const fz_text_item *it = &span->items[i];
+      if (it->gid < 0)
+        continue;
+      fz_point p = fz_transform_point(fz_make_point(it->x, it->y), ctm);
+      float adv = fz_advance_glyph(ctx, span->font, it->gid, span->wmode);
+      fz_point w = fz_transform_vector(fz_transform_vector(fz_make_point(adv, 0), trm), ctm);
+      if (dev->n == dev->cap)
+      {
+        int cap = dev->cap ? dev->cap * 2 : 1024;
+        dev->g = fz_realloc_array(ctx, dev->g, cap, synctex_glyph);
+        dev->cap = cap;
+      }
+      float x0 = p.x, x1 = p.x + w.x;
+      if (x1 < x0) { float t = x0; x0 = x1; x1 = t; }
+      dev->g[dev->n++] = (synctex_glyph){
+        (int)(x0 * dev->inv), (int)(x1 * dev->inv), (int)(p.y * dev->inv)};
+    }
+  }
+}
+
+/* glyphs of a page in SyncTeX units; *n = their count; free with fz_free */
+static synctex_glyph *page_glyphs(fz_context *ctx, txp_engine *eng, int page, int *n)
+{
+  *n = 0;
+  float fs = send(scale_factor, eng);
+  if (fs <= 0)
+    return NULL;
+  glyph_device *dev = NULL;
+  fz_display_list *dl = NULL;
+  synctex_glyph *result = NULL;
+  fz_var(dev);
+  fz_var(dl);
+  fz_try(ctx)
+  {
+    dl = send(render_page, eng, ctx, page);
+    dev = fz_new_derived_device(ctx, glyph_device);
+    dev->super.fill_text = glyph_fill_text;
+    dev->inv = 1.0f / fs;
+    fz_run_display_list(ctx, dl, &dev->super, fz_identity, fz_infinite_rect, NULL);
+    fz_close_device(ctx, &dev->super);
+    result = dev->g;
+    *n = dev->n;
+    dev->g = NULL;
+  }
+  fz_always(ctx)
+  {
+    if (dev) { fz_free(ctx, dev->g); fz_drop_device(ctx, &dev->super); }
+    fz_drop_display_list(ctx, dl);
+  }
+  fz_catch(ctx)
+  {
+    *n = 0;
+    return NULL;
+  }
+  return result;
+}
+
+/* lines caret_line-2 .. caret_line+2 of the file of the last forward
+   search (the window for synctex_refine_target); text NULL if not found.
+   Free src->text with fz_free. */
+static void caret_source(fz_context *ctx, const char *doc_path, synctex_source *src)
+{
+  memset(src, 0, sizeof(*src));
+  if (!caret_path[0] || caret_line <= 0)
+    return;
+  char full[2048];
+  if (caret_path[0] == '/' || !doc_path)
+    snprintf(full, sizeof full, "%s", caret_path);
+  else
+    snprintf(full, sizeof full, "%s/%s", doc_path, caret_path);
+  FILE *f = fopen(full, "rb");
+  if (!f)
+    return;
+  fseek(f, 0, SEEK_END);
+  long size = ftell(f);
+  fseek(f, 0, SEEK_SET);
+  if (size < 0) { fclose(f); return; }
+  char *in = fz_malloc(ctx, size + 1);
+  size = (long)fread(in, 1, size, f);
+  fclose(f);
+  char *out = fz_malloc(ctx, size + 1);
+  int first = caret_line > 2 ? caret_line - 2 : 1, last = caret_line + 2;
+  long i = 0, n = 0;
+  int line = 1, nl = 0;
+  while (line < first && i < size)
+    if (in[i++] == '\n') line++;
+  for (; line <= last && nl < 8; line++)
+  {
+    src->offsets[nl++] = (int)n;
+    while (i < size && in[i] != '\n')
+    {
+      if (in[i] != '\r') out[n++] = in[i];
+      i++;
+    }
+    if (i >= size || line == last) break;
+    i++;             /* the line break */
+    out[n++] = '\n';
+  }
+  fz_free(ctx, in);
+  out[n] = 0;
+  if (line < caret_line || nl <= caret_line - first)
+  { fz_free(ctx, out); memset(src, 0, sizeof(*src)); return; }
+  src->text = out;
+  src->len = (int)n;
+  src->first_line = first;
+  src->nlines = nl;
+}
+
+static void caret_refine(struct persistent_state *ps, ui_state *ui, synctex_t *stx,
+                         fz_buffer *buf, int page, int *rx, int *ry, int *rh, int *rd)
+{
+  int ng = 0;
+  synctex_glyph *glyphs = page_glyphs(ps->ctx, ui->eng, page, &ng);
+  synctex_source src;
+  caret_source(ps->ctx, ps->doc_path, &src);
+  synctex_refine_target(ps->ctx, stx, buf, page, glyphs, ng, &src, rx, ry, rh, rd);
+  fz_free(ps->ctx, glyphs);
+  fz_free(ps->ctx, (char *)src.text);
+}
