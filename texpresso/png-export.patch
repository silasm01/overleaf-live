 src/frontend/editor.h     | 11 +++++
 src/frontend/engine_tex.c | 71 ++++++++++++++++++++++++++++++
 src/frontend/main.c       | 90 +++++++++++++++++++++++++++++++++++++++
 4 files changed, 201 insertions(+)

diff --git a/src/frontend/editor.c b/src/frontend/editor.c
index 6face98..4d556e1 100644
--- a/src/frontend/editor.c
+++ b/src/frontend/editor.c
@@ -219,6 +219,35 @@ bool editor_parse(fz_context *ctx,
             .h = val_number(ctx, val_array_get(ctx, stack, command, 4)),
         }};
   }
+  else if (strcmp(verb, "export-png") == 0)
+  {
+    // (export-png "dir" width): render each displayed page to a PNG in dir
+    // and report it with (page-image ...); an empty dir turns it off
+    if (len != 3)
+      goto arity;
+    val dir = val_array_get(ctx, stack, command, 1);
+    val width = val_array_get(ctx, stack, command, 2);
