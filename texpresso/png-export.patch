+/* ---- Overleaf Live: the caret with glyphs ------------------------------
+   The glyphs of a page (from its display list) and the text of the source
+   line of the last forward search, for synctex_refine_target. */
+
+static char caret_path[1024];
+static int caret_line;
+static int caret_debug;   /* (caret-debug t): report every character too */
+
+typedef struct {
+  fz_device super;
+  synctex_glyph *g;
+  int n, cap;
+  float inv;   /* 1 / scale factor: points -> SyncTeX units */
+  int picture;      /* in a picture (layer "olive-picture"): its depth */
+  fz_rect pbox;     /* the box of what the picture draws */
+} glyph_device;
+
+static void glyph_push(fz_context *ctx, glyph_device *dev, synctex_glyph g)
+{
+  if (dev->n == dev->cap)
+  {
+    int cap = dev->cap ? dev->cap * 2 : 1024;
+    dev->g = fz_realloc_array(ctx, dev->g, cap, synctex_glyph);
+    dev->cap = cap;
+  }
+  dev->g[dev->n++] = g;
+}
+
+/* a picture is one "glyph" without a font: its box */
+static void glyph_picture(fz_context *ctx, glyph_device *dev, fz_rect r)
+{
+  if (fz_is_empty_rect(r) || fz_is_infinite_rect(r))
+    return;
+  if (dev->picture > 0)
+  {
+    dev->pbox = fz_is_empty_rect(dev->pbox) ? r : fz_union_rect(dev->pbox, r);
+    return;
+  }
+  float s = dev->inv;
+  glyph_push(ctx, dev, (synctex_glyph){(int)(r.x0 * s), (int)(r.x1 * s), (int)(r.y1 * s),
+                                       -1, NULL, (int)(r.y0 * s), (int)(r.y1 * s)});
+}
+
+static void glyph_begin_layer(fz_context *ctx, fz_device *dev_, const char *name)
+{
+  glyph_device *dev = (glyph_device *)dev_;
+  (void)ctx;
+  if (dev->picture > 0)
+    dev->picture++;
+  else if (name && strcmp(name, "olive-picture") == 0)
+  {
+    dev->picture = 1;
+    dev->pbox = fz_empty_rect;
+  }
+}
+
+static void glyph_end_layer(fz_context *ctx, fz_device *dev_)
+{
+  glyph_device *dev = (glyph_device *)dev_;
+  if (dev->picture > 0 && --dev->picture == 0)
+    glyph_picture(ctx, dev, dev->pbox);
+}
+
+static void glyph_fill_image(fz_context *ctx, fz_device *dev_, fz_image *img,
+                             fz_matrix ctm, float alpha, fz_color_params cp)
+{
+  (void)img; (void)alpha; (void)cp;
+  glyph_picture(ctx, (glyph_device *)dev_, fz_transform_rect(fz_unit_rect, ctm));
+}
+
+static void glyph_fill_path(fz_context *ctx, fz_device *dev_, const fz_path *path,
