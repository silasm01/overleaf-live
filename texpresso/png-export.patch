+    png = fz_new_buffer_from_pixmap_as_png(ctx, pix, fz_default_color_params);
+    unsigned char *d;
+    size_t n = fz_buffer_storage(ctx, png, &d);
+    char path[1200];
+    snprintf(path, sizeof(path), "%s/page-%d-%d.png", export_dir, page, export_seq++);
+    FILE *f = fopen(path, "wb");
+    if (!f)
+      fz_throw(ctx, FZ_ERROR_GENERIC, "cannot write %s", path);
+    fwrite(d, 1, n, f);
+    fclose(f);
+    export_hash[page] = h;
+    // the page size in points (the front-end needs it for zoom levels)
+    printf("(page-image %d %d %d \"%s\" %.2f %.2f)\n", page, count, done, path,
+           bounds.x1 - bounds.x0, bounds.y1 - bounds.y0);
+  }
+  fz_always(ctx)
+  {
+    fz_drop_device(ctx, dev);
+    fz_drop_pixmap(ctx, pix);
+    fz_drop_buffer(ctx, png);
+    fz_drop_display_list(ctx, dl);
+  }
+  fz_catch(ctx)
+  {
+    fprintf(stderr, "[export-png] page %d: %s\n", page, fz_caught_message(ctx));
+  }
+}
