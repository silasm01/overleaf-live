+  int off = 0, n = 0;
+  while (p < end && *p >= '0' && *p <= '9') off = off * 10 + (*p++ - '0');
+  if (p >= end || *p++ != ':') return 0;
+  while (p < end && *p >= '0' && *p <= '9') n = n * 10 + (*p++ - '0');
+  if (p >= end || *p++ != ':') return 0;
+  while (p < end && *p != ':') p++;     /* the name TeX asked for */
+  if (p >= end) return 0;
+  p++;
+  *base = p;
+  *base_len = (int)(end - p);
