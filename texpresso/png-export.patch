 static void answer_query(fz_context *ctx, struct tex_engine *self, query_t *q);
 
+/* Overleaf Live: a file that this run wrote and now reads (e.g. a block
+   that \VerbatimOut copied from a source file, as the usage environment of
+   latex-templates does): if its lines are a block of lines of a project
+   .tex file, TeX gets the name "olive-alias:OFFSET:N:NAME:SOURCE" for it.
+   SyncTeX keeps that name, so the caret and clicks can go to SOURCE, line
+   OFFSET + its line (see synctex_input_alias). */
+static int olive_line_eq(const unsigned char *a, int la, const unsigned char *b, int lb)
+{
+  while (la > 0 && (a[la - 1] == '\r' || a[la - 1] == ' ')) la--;
+  while (lb > 0 && (b[lb - 1] == '\r' || b[lb - 1] == ' ')) lb--;
+  return la == lb && memcmp(a, b, la) == 0;
+}
+
+static int olive_alias(struct tex_engine *self, fileentry_t *w, const char *name,
+                       char *out, int out_size)
+{
+  fz_buffer *d = w->saved.data;
+  if (!d || d->len == 0 || d->len > 65536)
+    return 0;
+  /* the lines of the written file */
+  enum { MAXL = 2048 };
+  static int ls[MAXL], ll[MAXL];
+  int n = 0;
+  for (size_t i = 0; i < d->len && n < MAXL;)
+  {
+    size_t j = i;
+    while (j < d->len && d->data[j] != '\n') j++;
+    ls[n] = (int)i;
+    ll[n] = (int)(j - i);
+    n++;
+    i = j + 1;
+  }
+  while (n > 0 && ll[n - 1] == 0) n--;
+  if (n == 0 || n == MAXL)
+    return 0;
+  fileentry_t *e;
+  for (int index = 0; (e = filesystem_scan(self->fs, &index));)
+  {
+    if (e == w || e->saved.data)
+      continue;
+    size_t plen = strlen(e->path);
+    if (plen < 5 || strcmp(e->path + plen - 4, ".tex") != 0)
+      continue;
+    fz_buffer *s = e->edit_data ? e->edit_data : e->fs_data;
+    if (!s || s->len == 0)
+      continue;
+    /* find the block: line by line */
+    int line = 0;
+    for (size_t i = 0; i < s->len; line++)
+    {
+      size_t j = i;
+      while (j < s->len && s->data[j] != '\n') j++;
+      if (olive_line_eq(s->data + i, (int)(j - i), d->data + ls[0], ll[0]))
+      {
+        int k = 1;
+        size_t p = j + 1;
+        while (k < n && p <= s->len)
+        {
+          size_t q = p;
+          while (q < s->len && s->data[q] != '\n') q++;
+          if (!olive_line_eq(s->data + p, (int)(q - p), d->data + ls[k], ll[k]))
+            break;
+          k++;
+          p = q + 1;
+        }
+        if (k == n)
+        {
+          snprintf(out, out_size, "olive-alias:%d:%d:%s:%s", line, n, name, e->path);
+          fprintf(stderr, "[info] %s is lines %d-%d of %s\n", name, line + 1, line + n, e->path);
+          return 1;
+        }
+      }
+      i = j + 1;
+    }
+  }
+  return 0;
+}
