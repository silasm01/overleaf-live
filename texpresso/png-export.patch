diff --git a/src/dvi/dvi_resmanager.c b/src/dvi/dvi_resmanager.c
index f702dfa..df97614 100644
--- a/src/dvi/dvi_resmanager.c
+++ b/src/dvi/dvi_resmanager.c
@@ -101,6 +101,39 @@ static const char* kind_to_string(dvi_reskind kind)
   }
 }
 
+
+// A picture that isn't in the document's folder may come with TeX Live
+// (e.g. example-image-a.pdf from mwe): ask kpsewhich. Results are
+// remembered, also when nothing was found. Returns NULL or a path that
+// stays valid.
+static const char *kpse_find_picture(const char *name)
+{
+  enum { N = 64 };
+  static char names[N][256], found[N][1024];
+  static int count = 0;
+  if (strlen(name) >= 256 || strchr(name, '\'') || strchr(name, '"'))
+    return NULL;
+  for (int i = 0; i < count; i++)
+    if (strcmp(names[i], name) == 0)
+      return found[i][0] ? found[i] : NULL;
+  char cmd[512], result[1024] = "";
+  snprintf(cmd, sizeof(cmd), "kpsewhich '%s' 2>/dev/null", name);
+  FILE *f = popen(cmd, "r");
+  if (f)
+  {
+    if (!fgets(result, sizeof(result), f))
+      result[0] = '\0';
+    pclose(f);
+  }
+  result[strcspn(result, "\r\n")] = '\0';
+  if (count >= N)
+    return NULL;
+  snprintf(names[count], 256, "%s", name);
+  snprintf(found[count], 1024, "%s", result);
+  count++;
+  return found[count - 1][0] ? found[count - 1] : NULL;
+}
+
 static fz_stream *
 tectonic_hooks_open_file(fz_context *ctx, void *env, dvi_reskind kind, const char *name)
 {
@@ -136,6 +169,16 @@ tectonic_hooks_open_file(fz_context *ctx, void *env, dvi_reskind kind, const cha
         else
           memcpy(path + root_len, name, name_len);
         path[len] = 0;
+        if (access(path, R_OK) != 0)
+        {
+          const char *kp = kpse_find_picture(name);
+          if (kp)
+          {
+            free(path);
+            path = (char *)kp;
+            free_path = 0;
+          }
+        }
       }
       break;
 
@@ -278,6 +321,16 @@ texlive_hooks_open_file(fz_context *ctx, void *env, dvi_reskind kind, const char
         else
           memcpy(path + root_len, name, name_len);
         path[len] = 0;
+        if (access(path, R_OK) != 0)
+        {
+          const char *kp = kpse_find_picture(name);
+          if (kp)
+          {
+            free(path);
+            path = (char *)kp;
+            free_path = 0;
+          }
+        }
       }
       break;
 
