+/* the main file, as an element names it (TeX gives no name for it) */
+static const char *main_file_name(struct persistent_state *ps)
+{
+  const char *base = strrchr(ps->doc_name, '/');
+  return base ? base + 1 : ps->doc_name;
+}
+
+/* a click on an element without glyphs under it (a line, a shape of a
+   TikZ picture): the editor goes to the start of its source */
+static int element_click(struct persistent_state *ps, ui_state *ui, int page, int x, int y)
+{
+  int ng = 0, ne = 0, done = 0;
+  synctex_element *els = NULL;
+  synctex_glyph *glyphs = page_scan(ps->ctx, ui->eng, page, &ng, &els, &ne);
+  int on_glyph = 0, slack = 65536 / 2;
+  for (int i = 0; i < ng && !on_glyph; i++)
+    if (glyphs[i].font && x >= glyphs[i].x0 - slack && x <= glyphs[i].x1 + slack &&
+        y >= glyphs[i].y0 - slack && y <= glyphs[i].y1 + slack)
+      on_glyph = 1;
+  /* text: SyncTeX knows its line, except in TikZ (all its text is on the
+     line where the picture ends): there the element */
+  int k = synctex_element_at(els, ne, x, y);
+  if (on_glyph && k >= 0 && !strchr("ntp", els[k].kind))
+    k = -1;
+  if (k >= 0)
+  {
+    const synctex_element *e = &els[k];
+    const char *name = e->file[0] ? e->file : main_file_name(ps);
+    synctex_file file;
+    synctex_range r;
+    if (caret_file(ps->ctx, ps->doc_path, name, (int)strlen(name), &file))
+    {
+      if (synctex_element_range(&file, e, &r))
+      {
+        fprintf(stderr, "[synctex scan] element %c line %d -> %s:%d:%d\n", e->kind, e->line,
+                name, r.l0, r.c0);
+        editor_synctex(ps->doc_path, name, (int)strlen(name), r.l0, r.c0);
+        done = 1;
+      }
+      caret_file_free(ps->ctx, &file);
+    }
+  }
+  fz_free(ps->ctx, els);
+  drop_glyphs(ps->ctx, glyphs, ng);
+  return done;
+}
+
+/* the caret of the last forward search (x, y: the point of SyncTeX), on
+   stdout, in points:
+     (synctex-target page x y height depth [box-x0 box-y0 box-x1 box-y1 [element]])
+   element: the box is a picture or a TikZ element (the viewer shows no caret)
+   and with caret-debug, the caret map of the lines around it */
+static void caret_report(struct persistent_state *ps, ui_state *ui, synctex_t *stx,
+                         fz_buffer *buf, int page, int x, int y)
+{
+  int ng = 0, ne = 0;
+  synctex_element *els = NULL;
+  synctex_glyph *glyphs = page_scan(ps->ctx, ui->eng, page, &ng, &els, &ne);
+  synctex_file file;
+  int has_file = caret_path[0] &&
+                 caret_file(ps->ctx, ps->doc_path, caret_path, (int)strlen(caret_path), &file);
+  synctex_caret_info info = {0};
+  info.debug = caret_debug;
+  info.pts = caret_pts;
+  info.cappts = 2048;
+  info.boxes = caret_boxes;
+  info.capboxes = 512;
+  int rx = x, ry = y, rh = 0, rd = 0;
+  synctex_refine_target(ps->ctx, stx, buf, page, glyphs, ng, has_file ? &file : NULL,
+                        &rx, &ry, &rh, &rd, &info);
+  /* in a TikZ element without text of its own: the box of the element */
+  if (has_file && ne > 0)
+    synctex_element_caret(&file, caret_path, main_file_name(ps), caret_line, caret_col,
+                          els, ne, &rx, &ry, &rh, &rd, &info);
+  fz_free(ps->ctx, els);
+  drop_glyphs(ps->ctx, glyphs, ng);
+  if (has_file)
+    caret_file_free(ps->ctx, &file);
+  float fs = send(scale_factor, ui->eng);
+  if (info.has_box)
+    printf("(synctex-target %d %.2f %.2f %.2f %.2f %.2f %.2f %.2f %.2f%s)\n",
+           page, fs * rx, fs * ry, fs * rh, fs * rd,
+           fs * info.box.x0 - caret_pad, fs * info.box.y0 - caret_pad,
+           fs * info.box.x1 + caret_pad, fs * info.box.y1 + caret_pad,
+           info.element ? " element" : "");
+  else
+    printf("(synctex-target %d %.2f %.2f %.2f %.2f)\n",
+           page, fs * rx, fs * ry, fs * rh, fs * rd);
+  if (caret_debug)
+    print_caret_map(page, fs, &info);
+  fflush(stdout);
+}
+
+/* (caret-elements page): the elements that TikZ marked on the page, answer
+   (synctex-elements page n kind line end-line index depth x0 y0 x1 y1 "file"
+    l0 c0 l1 c1 ...), l0 ... c1: its source (0 if not found),
+   in points; x0 = -1 for an element that draws nothing */
+static void caret_page_elements(struct persistent_state *ps, ui_state *ui, int page)
+{
+  int ng = 0, ne = 0;
+  synctex_element *els = NULL;
+  synctex_glyph *glyphs = page_scan(ps->ctx, ui->eng, page, &ng, &els, &ne);
+  drop_glyphs(ps->ctx, glyphs, ng);
+  float fs = send(scale_factor, ui->eng);
+  printf("(synctex-elements %d %d", page, ne);
+  for (int i = 0; i < ne; i++)
+  {
+    const synctex_element *e = &els[i];
+    printf(" %c %d %d %d %d", e->kind ? e->kind : '?', e->line, e->end_line, e->index, e->depth);
+    if (e->has_box)
+      printf(" %.2f %.2f %.2f %.2f", fs * e->x0, fs * e->y0, fs * e->x1, fs * e->y1);
+    else
+      printf(" -1 -1 -1 -1");
+    printf(" \"");
+    for (const char *c = e->file; *c; c++)
+      if (*c == '"' || *c == '\\') printf("\\%c", *c); else putchar(*c);
+    printf("\"");
+    /* its source: l0 c0 l1 c1 (0 if not found) */
+    synctex_range r = {0, 0, 0, 0};
+    const char *name = e->file[0] ? e->file : main_file_name(ps);
+    synctex_file file;
+    if (caret_file(ps->ctx, ps->doc_path, name, (int)strlen(name), &file))
+    {
+      synctex_element_range(&file, e, &r);
+      caret_file_free(ps->ctx, &file);
+    }
+    printf(" %d %d %d %d", r.l0, r.c0, r.l1, r.c1);
+  }
+  printf(")\n");
+  fflush(stdout);
+  fz_free(ps->ctx, els);
+}
+
+/* (caret-map page): the caret map of every source line on the page, from
+   all its files; answer (synctex-debug ...) */
+static void caret_page_map(struct persistent_state *ps, ui_state *ui, int page)
+{
+  fz_buffer *buf;
+  synctex_t *stx = send(synctex, ui->eng, &buf);
+  synctex_caret_info info = {0};
+  info.pts = caret_pts;
+  info.cappts = CAP_PTS;
+  info.boxes = caret_boxes;
+  info.capboxes = CAP_BOXES;
+  if (stx && page >= 0 && page < synctex_page_count(stx))
+  {
+    enum { MAXLINES = 4096 };
+    static int pairs[2 * MAXLINES];
+    static int lines[MAXLINES];
+    int n = synctex_page_lines(ps->ctx, stx, buf, page, pairs, MAXLINES);
+    int ng = 0;
+    synctex_glyph *glyphs = page_glyphs(ps->ctx, ui->eng, page, &ng);
+    for (int i = 0; i < n;)
+    {
+      int tag = pairs[2 * i], k = 0;
+      while (i < n && pairs[2 * i] == tag)
+        lines[k++] = pairs[2 * i++ + 1];
+      const char *name;
+      int len = synctex_input_name(stx, buf, tag, &name);
+      synctex_file file;
+      if (len <= 0 || !caret_file(ps->ctx, ps->doc_path, name, len, &file))
+        continue;
+      synctex_caret_map(ps->ctx, stx, buf, page, glyphs, ng, tag, &file, lines, k, &info);
+      caret_file_free(ps->ctx, &file);
+    }
+    drop_glyphs(ps->ctx, glyphs, ng);
+  }
+  print_caret_map(page, send(scale_factor, ui->eng), &info);
+  fflush(stdout);
+}
