+/* lines caret_line-2 .. caret_line+2 of the file of the last forward
+   search (the window for synctex_refine_target); text NULL if not found.
+   Free src->text with fz_free. */
+static void caret_source(fz_context *ctx, const char *doc_path, synctex_source *src)
+{
+  memset(src, 0, sizeof(*src));
+  if (!caret_path[0] || caret_line <= 0)
+    return;
+  char full[2048];
+  if (caret_path[0] == '/' || !doc_path)
+    snprintf(full, sizeof full, "%s", caret_path);
+  else
+    snprintf(full, sizeof full, "%s/%s", doc_path, caret_path);
+  FILE *f = fopen(full, "rb");
+  if (!f)
+    return;
+  fseek(f, 0, SEEK_END);
+  long size = ftell(f);
+  fseek(f, 0, SEEK_SET);
+  if (size < 0) { fclose(f); return; }
+  char *in = fz_malloc(ctx, size + 1);
+  size = (long)fread(in, 1, size, f);
+  fclose(f);
+  int *out = fz_malloc(ctx, sizeof(int) * (size + 1));
+  int first = caret_line > 2 ? caret_line - 2 : 1, last = caret_line + 2;
+  long i = 0, n = 0;
+  int line = 1, nl = 0;
+  while (line < first && i < size)
+    if (in[i++] == '\n') line++;
+  for (; line <= last && nl < 8; line++)
+  {
+    src->offsets[nl++] = (int)n;
+    while (i < size && in[i] != '\n')
+    {
+      /* one entry per character (UTF-8 decoded), as SyncTeX counts */
+      unsigned char b = (unsigned char)in[i];
+      int cp = b, more = 0;
+      if (b >= 0xF0) { cp = b & 0x07; more = 3; }
+      else if (b >= 0xE0) { cp = b & 0x0F; more = 2; }
+      else if (b >= 0xC0) { cp = b & 0x1F; more = 1; }
+      i++;
+      while (more-- > 0 && i < size && ((unsigned char)in[i] & 0xC0) == 0x80)
+        cp = (cp << 6) | (in[i++] & 0x3F);
+      if (cp != '\r') out[n++] = cp;
+    }
+    if (i >= size || line == last) break;
+    i++;             /* the line break */
+    out[n++] = '\n';
+  }
+  fz_free(ctx, in);
+  out[n] = 0;
+  if (line < caret_line || nl <= caret_line - first)
+  { fz_free(ctx, out); memset(src, 0, sizeof(*src)); return; }
+  src->text = out;
+  src->len = (int)n;
+  src->first_line = first;
+  src->nlines = nl;
+}
+
+/* the caret of the last forward search (x, y: the point of SyncTeX), on
+   stdout, in points:
+     (synctex-target page x y height depth [box-x0 box-y0 box-x1 box-y1])
+   and with caret-debug, the caret of every character of the window:
+     (synctex-debug page n line col x y height depth box ... m x0 y0 x1 y1 ...) */
+static void caret_report(struct persistent_state *ps, ui_state *ui, synctex_t *stx,
+                         fz_buffer *buf, int page, int x, int y)
+{
+  int ng = 0;
+  synctex_glyph *glyphs = page_glyphs(ps->ctx, ui->eng, page, &ng);
+  synctex_source src;
+  caret_source(ps->ctx, ps->doc_path, &src);
+  enum { CAP_PTS = 1024, CAP_BOXES = 256 };
+  static synctex_debug_point pts[CAP_PTS];
+  static synctex_box boxes[CAP_BOXES];
+  synctex_caret_info info = {0};
+  info.debug = caret_debug;
+  info.pts = pts;
+  info.cappts = CAP_PTS;
+  info.boxes = boxes;
+  info.capboxes = CAP_BOXES;
+  int rx = x, ry = y, rh = 0, rd = 0;
+  synctex_refine_target(ps->ctx, stx, buf, page, glyphs, ng, &src, &rx, &ry, &rh, &rd, &info);
+  for (int i = 0; i < ng; i++)
+    if (glyphs[i].font)
+      fz_drop_font(ps->ctx, glyphs[i].font);
+  fz_free(ps->ctx, glyphs);
+  fz_free(ps->ctx, (int *)src.text);
+  float fs = send(scale_factor, ui->eng);
+  const float pad = 1.0f;   /* points around the box */
+  if (info.has_box)
+    printf("(synctex-target %d %.2f %.2f %.2f %.2f %.2f %.2f %.2f %.2f)\n",
+           page, fs * rx, fs * ry, fs * rh, fs * rd,
+           fs * info.box.x0 - pad, fs * info.box.y0 - pad,
+           fs * info.box.x1 + pad, fs * info.box.y1 + pad);
+  else
+    printf("(synctex-target %d %.2f %.2f %.2f %.2f)\n",
+           page, fs * rx, fs * ry, fs * rh, fs * rd);
+  if (caret_debug)
+  {
+    printf("(synctex-debug %d %d", page, info.npts);
+    for (int i = 0; i < info.npts; i++)
+      printf(" %d %d %.2f %.2f %.2f %.2f %d", pts[i].line, pts[i].col, fs * pts[i].x,
+             fs * pts[i].y, fs * pts[i].h, fs * pts[i].d, pts[i].box);
+    printf(" %d", info.nboxes);
+    for (int i = 0; i < info.nboxes; i++)
+      printf(" %.2f %.2f %.2f %.2f", fs * boxes[i].x0 - pad, fs * boxes[i].y0 - pad,
+             fs * boxes[i].x1 + pad, fs * boxes[i].y1 + pad);
+    printf(")\n");
+  }
+  fflush(stdout);
+}
