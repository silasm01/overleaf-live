+    printf(" ");
+    print_sexp_string(f.options);
+  }
+  if (f.nalso)
+  {
+    char also[32 * 24];
+    int al = 0;
+    for (int i = 0; i < f.nalso; i++)
+      al += snprintf(also + al, sizeof also - al, i ? ";%d:%d" : "%d:%d", f.also[i][0], f.also[i][1]);
