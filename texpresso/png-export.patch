+// Pictures that come with TeX Live (e.g. example-image-a.pdf from mwe):
+// the engine doesn't search the TeX tree for them, so ask kpsewhich.
+// Results are remembered, also when nothing was found.
+static const char *kpse_picture(const char *path, char buf[1024], struct stat *st)
+{
+  static const char *exts[] = {".pdf", ".png", ".jpg", ".jpeg", ".eps", NULL};
+  const char *dot = strrchr(path, '.');
+  if (!dot || strchr(path, '/') || strchr(path, '\'') || strchr(path, '"'))
+    return NULL;
+  int is_picture = 0;
+  for (int i = 0; exts[i]; i++)
+    if (strcasecmp(dot, exts[i]) == 0)
+      is_picture = 1;
+  if (!is_picture)
+    return NULL;
+
+  enum { N = 64 };
+  static char names[N][256], found[N][1024];
+  static int count = 0;
+  for (int i = 0; i < count; i++)
+    if (strcmp(names[i], path) == 0)
+    {
+      if (!found[i][0] || stat(found[i], st) == -1)
+        return NULL;
+      snprintf(buf, 1024, "%s", found[i]);
+      return buf;
+    }
+
+  char cmd[512], result[1024] = "";
+  snprintf(cmd, sizeof(cmd), "kpsewhich '%s' 2>/dev/null", path);
+  FILE *f = popen(cmd, "r");
+  if (f)
+  {
+    if (!fgets(result, sizeof(result), f))
+      result[0] = '\0';
+    pclose(f);
+  }
+  result[strcspn(result, "\r\n")] = '\0';
+  if (count < N && strlen(path) < 256)
+  {
+    snprintf(names[count], 256, "%s", path);
+    snprintf(found[count], 1024, "%s", result);
+    count++;
+  }
+  if (!result[0] || stat(result, st) == -1)
+    return NULL;
+  snprintf(buf, 1024, "%s", result);
+  return buf;
+}
+
