+{
+  glyph_device *dev = (glyph_device *)dev_;
+  (void)even_odd; (void)cs; (void)color; (void)alpha; (void)cp;
+  if (dev->picture > 0)   /* only in a picture: TikZ and rules are not glyphs */
+    glyph_picture(ctx, dev, fz_bound_path(ctx, path, NULL, ctm));
