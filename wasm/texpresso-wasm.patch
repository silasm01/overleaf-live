+#ifndef TXP_LUA_H
+#define TXP_LUA_H
+
+#include <stddef.h>
+
+// Piped input ("\input|cmd") for the WASM build of TeXpresso: the driver
+// runs the command here, in a Lua 5.4 sandbox, as TeX Live would with a
+// restricted shell escape. Supported commands:
+//   kpsewhich [-format=x] [-var-value=name] name...
+//   texlua script args...
+// All file access goes through `io`, so TeXpresso's file table (with its
+// rollback log) stays the only file system that the engine and Lua see.
+
+typedef struct {
+  void *env;
+  // The data of a file, or NULL if it does not exist. Valid until the next
+  // call.
+  const char *(*read)(void *env, const char *path, size_t *len);
+  // Writes (replaces) a file.
+  void (*write)(void *env, const char *path, const char *data, size_t len);
+} txp_lua_io;
+
+// Runs `cmd`. The output (what the command prints) goes to *out (malloc'd,
+// *outlen bytes). Returns 0, or -1 if the command is not supported.
+int txp_pipe_run(const char *cmd, txp_lua_io *io, char **out, size_t *outlen);
+
+#endif
