+#include <stdio.h>
+#include <stdlib.h>
+
+static void read4(char answer[4])
+{
+  int got = 0;
+  while (got < 4)
+  {
+    int n = host_chan_read(answer + got, 4 - got);
+    if (n < 0) { fprintf(stderr, "texpresso_fork_with_channel: channel closed\n"); abort(); }
+    if (n == 0) { host_chan_wait(); continue; }
+    got += n;
+  }
+}
+
+pid_t texpresso_fork_with_channel(int fd, uint32_t time)
+{
+  (void)fd;
+  int child = host_fork(time);
+  if (child == 0)
+    return 0;
+  char answer[4];
+  do read4(answer);
+  while (answer[0] == 'F' && answer[1] == 'L' && answer[2] == 'S' && answer[3] == 'H');
+  if (!(answer[0] == 'D' && answer[1] == 'O' && answer[2] == 'N' && answer[3] == 'E'))
+  {
+    fprintf(stderr, "texpresso_fork_with_channel: unexpected answer %.4s\n", answer);
+    abort();
+  }
+  return child;
+}
+#else
 #include <errno.h>
 #include <sys/wait.h>
 #include <unistd.h>
@@ -112,3 +156,4 @@ pid_t texpresso_fork_with_channel(int fd, uint32_t time)
 
   return child;
 }
+#endif
