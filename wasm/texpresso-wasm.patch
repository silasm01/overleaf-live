+
+// One step of work (approx. 5 ms of engine time). Returns 1 when more work
+// is waiting (call again soon), 0 when the engine is idle.
+EMSCRIPTEN_KEEPALIVE
+int txp_wasm_tick(void)
+{
+  struct persistent_state *ps = &wasm_ps;
+  ui_state *ui = &wasm_ui;
+  int before = send(page_count, ui->eng);
+  bool advance = advance_engine(ps->ctx, ui);
+  send(finish_convergence, ui->eng, ps->ctx);
+  int after = send(page_count, ui->eng);
+  if (ui->page >= before && ui->page < after)
+    wasm_schedule_event(RELOAD_EVENT);
+  else if (export_dir[0] && after > before && export_last >= before && export_first < after)
+    wasm_schedule_event(RELOAD_EVENT);
+  else if (export_dir[0] && export_reported_done != 1 &&
+           send(get_status, ui->eng) == DOC_TERMINATED)
+    wasm_schedule_event(RELOAD_EVENT);
+
+  fz_buffer *buf;
+  synctex_t *stx = send(synctex, ui->eng, &buf);
+  int page = -1, x = -1, y = -1;
+  if (synctex_find_target(ps->ctx, stx, buf, &page, &x, &y))
+  {
+    int rx = x, ry = y, rh = 0, rd = 0;
+    synctex_refine_target(ps->ctx, stx, buf, page, &rx, &ry, &rh, &rd);
+    float fs = send(scale_factor, ui->eng);
+    printf("(synctex-target %d %.2f %.2f %.2f %.2f)\n",
+           page, fs * rx, fs * ry, fs * rh, fs * rd);
+    fflush(stdout);
+  }
+  wasm_events_run();
+  fflush(stdout);
+  return advance || wasm_events != 0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void txp_wasm_debug(void)
+{
+  ui_state *ui = &wasm_ui;
+  fprintf(stderr, "[debug] status %d, pages %d, ui page %d, finishing %d, aux dirty %d, need %d\n",
+          (int)send(get_status, ui->eng), send(page_count, ui->eng), ui->page,
+          (int)send(is_finishing, ui->eng), (int)send(aux_dirty, ui->eng),
+          (int)need_advance(wasm_ps.ctx, ui));
+}
+
+// The host calls this after approx. 500 ms without edits: rerun for .aux
+// changes (as the SDL loop does after T_IDLE_MS). Returns 1 if it started a
+// pass.
+EMSCRIPTEN_KEEPALIVE
+int txp_wasm_idle(void)
+{
+  ui_state *ui = &wasm_ui;
+  bool aux_ready = !send(is_finishing, ui->eng) && send(aux_dirty, ui->eng);
+  if (wasm_ps.rerun_enabled && wasm_rerun_count < MAX_RERUNS && aux_ready)
+  {
+    wasm_rerun_count++;
+    fprintf(stderr, "[rerun] idle: finishing pass %d/%d\n", wasm_rerun_count, MAX_RERUNS);
+    send(start_finishing, ui->eng);
+    wasm_schedule_event(RELOAD_EVENT);
+    return 1;
+  }
+  return 0;
+}
+#endif
